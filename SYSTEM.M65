M5000    = $5000
;
; SIOV AND CIOV
;
CNGDSK   = $01
SKPERR   = $02
SIOERR   = $80
DDEVIC   = $0300
DUNIT    = DDEVIC+1
DCOMND   = DUNIT+1
DSTATS   = DCOMND+1
DBUFLO   = DSTATS+1
DBUFHI   = DBUFLO+1
DTIMLO   = DBUFHI+1
DUNUSE   = DTIMLO+1
DBYTLO   = DUNUSE+1
DBYTHI   = DBYTLO+1
DAUX1    = DBYTHI+1
DAUX2    = DAUX1+1
