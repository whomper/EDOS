DSKNUM   = $B8              ;DRIVE
BYTRD    = $B9              ;BYTES READ
DENSITY  = $BA              ;DSK DNSTY
SCTR     = $BB              ;SCTR DSP (5B)
NUMBKS   = $C0              ;NUM OF BANKS
FILEND   = $C1              ;FILE END (2B)
RETADR   = $C3              ;(2B)
MOD10    = $C5              ;(2B)
CPYSRC   = MOD10            ;COPY: SOURCE (2B)
CIOPTR   = $C7              ;DOCIO PTR (2B)
CPYDST   = CIOPTR           ;COPY: DESTINATION (2B), AFTER CPYSRC
