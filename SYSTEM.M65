SIOV     = $E459
;
ICHID    = $0340
ICDNO    = ICHID+1
ICCOM    = ICDNO+1
ICSTA    = ICCOM+1
ICBAL    = ICSTA+1
ICBAH    = ICBAL+1
ICPTL    = ICBAH+1
ICPTH    = ICPTL+1
ICBLL    = ICPTH+1
ICBLH    = ICBLL+1
