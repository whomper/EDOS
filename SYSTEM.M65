; SD TIME VECTORS
VGETTD   = $FFC0            ; GET TD
VSETTD   = $FFC3            ; SET TD
VTDON    = $FFC6            ; TD ON/OFF
VFMTTD   = $FFC9            ; GET TD FMT
;
; SIOV COMMANDS
;
SIO.FT   = $21              ;FORMAT
