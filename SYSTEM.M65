INDPTR   = $CE              ;INDIRECT PNT
;
; ZERO PAGE - HOT SCRATCH VARS (RELOCATED FROM PROGRAM SPACE)
;
D0       = $B0              ;TEMPORARY
D1       = $B1              ;TEMPORARY
FILPOS   = $B2              ;POS POINTER (2B)
