;
; SYSTEM.M65 - EDOS 3.7
; EDOS's constants and zero page
; Copyright (C) 2026 AERA | Erez Yaary
;
; EDOS's constants
;
SCRID    = $00              ; IOCB 0, the screen
KBDID    = $10              ; IOCB 1, the keyboard
DSKID1   = $20              ; IOCB 2, the disk
LDRID    = $10              ; IOCB 1 loads, as in DOS 2
DSKID2   = $30              ; IOCB 3, a 2nd disk file
CUP      = $1C              ; cursor up
CLS      = $7D              ; clear the screen
DLN      = $9C              ; delete the line
DEL      = $FF              ; ends a text, not printed
CHL      = $12              ; the line character
INDPTR   = $CE              ; a pointer
;
; Zero page: EDOS's busiest variables
; (moved there from the program)
;
D0       = $B0              ; scratch
D1       = $B1              ; scratch
FILPOS   = $B2              ; a position or address (2)
TMP      = $B4
VALUE    = $B5              ; a number (2)
RUNADR   = VALUE            ; SAVE's run address (2)
D2       = $B7              ; scratch
DSKNUM   = $B8              ; the drive, 1-8
BYTRD    = $B9              ; bytes read
DENSITY  = $BA              ; 1 single, 2 enhanced, 3 double
SCTR     = $BB              ; sector count, as text (5)
NUMBKS   = $C0              ; extended RAM banks
FILEND   = $C1              ; end address (2)
RETADR   = $C3              ; INLINE's pointer (2)
MOD10    = $C5              ; GETCHR's echo (2)
CPYSRC   = MOD10            ; COPY: from (2)
CIOPTR   = $C7              ; DOCIO's pointer (2)
CPYDST   = CIOPTR           ; COPY: to (2), after CPYSRC
DOCFLG   = $C9              ; DOCIO's flags
ACVMEM   = $CA              ; the bank in use
TXTLEN   = $CB              ; GETTEXT's most bytes
COUNT    = $CC              ; files or banks counted
TMPDSK   = $CD              ; a drive kept for later
;
MAXBUF   = $80              ; longest text input (INP1)
BREAK    = $80              ; CIO's status: BREAK key
;
; The OS's addresses AXEQU.M65 has
; not: the floating point package
;
TRAMSZ   = $06
SOUNDR   = $41              ; 0: quiet SIO
FR0      = $D4
FR1      = $D5              ; FR0+1; the OS's FR1 is $E0
CIX      = $F2
INBUFF   = $F3
LBUFF    = $0580
AFP      = $D800
FASC     = $D8E6
IFP      = $D9AA
FPI      = $D9D2
M4000    = $4000            ; the bank window
M5000    = $5000
;
; DOSIO's flags in DUNUSE
;
CNGDSK   = $01              ; keep DUNIT, not DSKNUM
SKPERR   = $02              ; on error: SIOERR, no DISKERR
SIOERR   = $80              ; DUNUSE: an error skipped
;
; SIO commands
;
SIO.FT   = $21              ; format
SIO.FH   = $22              ; format enhanced
SIO.HS   = $3F              ; get the high speed index
SIO.WP   = $4F              ; write PERCOM
SIO.RD   = $52              ; read
SIO.ST   = $53              ; status
SIO.WT   = $57              ; write, verified
SIO.SL   = $68              ; drive's SIO code: length
;
; DSTATS: the data's direction
;
SIOST.RD = $40              ; from the drive
SIOST.WT = $80              ; to the drive
