10 ;EDOSMAIN.M65, V. 3.0 | E-DOS START, MENU AND COMMANDS
20 ;INCLUDED BY EDOS.M65 AFTER UTILS.M65
0200 ;START
0210 PRE_START
0220 ; HAVE WE SET DOSINI?
0230     LDA DOSINI+1
0240     CMP # >START
0250     BEQ STARTING
0260 ; CACHE DOSINI ONLY ON 1ST RUN
0270     LDA DOSINI
0280     STA DOSIN
0290     LDA DOSINI+1
0300     STA DOSIN+1
0310 STARTING
0320     LDA DOSIN
0330     STA START+1
0340     LDA DOSIN+1
0350     STA START+2
0360     LDA # <START
0370     STA DOSINI
0380     LDA # >START
0390     STA DOSINI+1
0400 ;
0410 START
0420     JSR START   ;TROJAN
0422     TSX         ;CACHE SP FOR GETCOM
0424     STX STKPTR
0430     LDA #$40    ;UPRCS ONLY
0440     STA SHFLOK
0470     LDA #$02    ;SET SCR MARGINS
0480     STA LMARGN
0490     LDA #$27
0500     STA RMARGN
0510     LDA PORTB
0520     STA BANKS   ;CACHE 1ST PLC
0530     LDA #1
0540     STA DSKNUM  ;INIT DEFAULT DRIVE
0541 ; CUSTOM FONT: LOAD ONCE, SELECT ON EVERY START/RESET
0542     LDA FONTPG
0543     BNE START_1
0544     JSR LDFONT
0545 START_1
0546     LDA FONTPG
0547     BEQ START_2
0548     STA CHBAS
0549 START_2
0550      @HIDCHR
0570 ;
0580 GOMENU
0590      @HIDCHR
0600      @PRNTLN  TTL1,DEL
0610      @DRAW  CHL,$00,$24
0620      @PRNTLN  TTL2
0630      @DRAW  CHL,$00,$24
0640 ;
0650     LDA REFDRV
0670     BEQ GOMENU_1
0680     JSR CHKANDUPDSTATBAR
0690 GOMENU_1
0700     LDA #$00
0710     STA REFDRV
0720      @PRNTLN  STAT
0730     LDA #$03
0740     STA LMARGN
0750      @DRAW  CHL,$00,$24
0760      @PRNTLN  MNU1,DEL
0770      @PRNTLN  MNU2,DEL
0780     LDA #$02
0790     STA LMARGN
0795 ;NLMENU: NEW LINE, BACK TO THE MENU
0796 NLMENU
0800     JSR PRNTNL
0810 GETCOM
0812     LDX STKPTR  ;DROP STACK LEFT BY
0814     TXS         ;ABORTS/ERRORS
0816     LDA BANKS   ;MAIN BANK FIRST
0818     STA PORTB
0820      @COLDEF
0830     JSR RESETFIO
0840     JSR CLOSEIO
0850      @DOCIO  KBDID,ICM.OP,KYBD,ICAX.RD
0880      @SHWCUR
0890      @SIOSNDON
0900      @PRNTLN  ANYK,DEL
0910     JSR GETCHR
0920 ;DIGITS?
0930     CMP #'1
0940     BCC FINDCM
0950     CMP #'9
0960     BCS FINDCM
0970     JMP COMDIG
0980 FINDCM
0990     LDX #$00
1000 FINDCM_1
1010     CMP CMDKEY,X
1020     BEQ FOUND
1030     INX
1040     CPX #NUMCMD
1050     BNE FINDCM_1
1060     BEQ GETCOM  ;NOT FOUND
1070 FOUND
1080     CPX #NTITLE
1090     BCS FOUND_1
1100     JSR TITLE   ;KEEPS X
1110 FOUND_1
1120     LDA CMDLO,X
1130     STA INDPTR
1140     LDA CMDHI,X
1150     STA INDPTR+1
1160     JMP (INDPTR)
1170 ;
1171 ;GET A KEY: Y RETURNS (Z=1), ANYTHING ELSE GOES
1172 ;BACK TO THE MENU (ESC TOO, IN GETCHR)
1173 YESORMENU
1174     JSR GETCHR
1175     CMP #'Y
1176     BNE GETCOM
1177     RTS
1200 ;
1210 COMLOA
1215     LDA #$00
1220     STA COUNT   ;RESET COUNTER
1225     STA RUNAD   ;NO RUN ADDR YET
1230     STA RUNAD+1
1240     JSR GETFILESPEC
1245      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.RD
1250 ; READ FILE HEADER
1255     LDA #$02
1260     STA D0
1265      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
1270 ; BINARY?
1275     LDA BUF
1280     AND BUF+1
1285     CMP #$FF
1290     BEQ COMLOA_1
1295     JMP COMLOA_3
1300 ;READ SECTION
1305 COMLOA_1
1310     LDA #$00    ;NO INIT ADDR YET
1315     STA INITAD
1320     STA INITAD+1
1325     LDA #$04
1330     STA D0
1335      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
1340     CPY #ICSTAT.EOF
1345     BEQ COMLOA_1_5
1350 ; GET START & END
1355     LDA BUF
1360     STA FILPOS
1365     LDA BUF+1
1370     STA FILPOS+1
1375     LDA BUF+2
1380     STA FILEND
1385     LDA BUF+3
1390     STA FILEND+1
1395 ; EXTRA $FFFF BEFORE SEGMENT?
1400     LDA FILPOS
1405     AND FILPOS+1
1410     CMP #$FF
1415     BNE COMLOA_2
1420     LDA FILEND  ;REAL START
1425     STA FILPOS
1430     LDA FILEND+1
1435     STA FILPOS+1
1440     LDA #$02
1445     STA D0
1450      @DOCIO  DSKID1,ICM.GB,FILEND,ICAX.RD,D0
1455     CPY #ICSTAT.EOF
1460     BEQ COMLOA_1_5
1465 COMLOA_2
1470     JSR CALCLEN
1475      @DOCIO  DSKID1,ICM.GB,FILPOS,ICAX.RD,FILLEN,FILLEN+1,1
1480 ; CALL INITAD IF SEGMENT SET IT
1485     TYA
1490     PHA         ;CACHE STATUS
1495     JSR RUNINIT
1500     PLA
1505     CMP #ICSTAT.EOF
1512     BNE COMLOA_1
1520 COMLOA_1_5
1525     LDA RUNAD   ;HAVE RUN ADDR?
1530     ORA RUNAD+1
1535     BEQ COMLOA_4
1540      @PRNTLN  RUNP,DEL
1545     JSR GETCHR
1550     CMP #'Y
1555     BNE COMLOA_4
1560     JSR CLOSEIO
1561     LDA #$E0    ;ROM FONT FOR THE PROGRAM
1562     STA CHBAS
1565     JMP (RUNAD) ;RUN PROGRAM
1570 COMLOA_3
1575      @PRNTLN  NOTB
1580 COMLOA_4
1585     JMP NLMENU
1595 ;
1600 ;JMP (INITAD) IF SET, ITS RTS RETURNS TO CALLER
1605 RUNINIT
1610     LDA INITAD
1615     ORA INITAD+1
1620     BEQ RUNINIT_1
1625     JMP (INITAD)
1630 RUNINIT_1
1635     RTS
1640 ;
1645 ;FILLEN=FILEND-FILPOS+1 (16 BIT)
1650 CALCLEN
1655     SEC
1660     LDA FILEND
1665     SBC FILPOS
1670     STA FILLEN
1675     LDA FILEND+1
1680     SBC FILPOS+1
1685     STA FILLEN+1
1690     INC FILLEN
1695     BNE CALCLEN_1
1700     INC FILLEN+1
1705 CALCLEN_1
1710     RTS
1760 ;
1770 GETFILESPEC
1780      @PRNTLN  FSPC,DEL
1790 GETSPEC     ;READ INP1, MAKE FILE SPEC
1800     JSR GETINP1
1810 ;FALL INTO PROCFILESPEC
1830 ;
1840 ;IN-INP1,OUT-FILE
1850 PROCFILESPEC
1860 ; EMPTY INP? USE DEF
1870     LDA INP1
1880     CMP #EOL    ;EMPTY?
1890     BEQ DEFDSKID ;USE DEF
1900 ; 3RD CHAR ':'? FND ARGS
1910     LDA INP1+2
1920     CMP #':
1930     BEQ CMPLTSTRCT ;YES
1940 ; 2ND CHR :?->NO D, INSRT
1950     LDA INP1+1
1960     CMP #':
1970     BEQ CMPLTSTRCT ;YES
1980 ;
1990 ; INP IS JST ARGS? D#+INP ARGS
2000      @CPYMEM  DISK,FILE ;DEF D#
2010      @CPYMEM  INP1,FILE+3 ;ADD
2020     RTS
2030 ;INP GOOD, USE IT
2040 CMPLTSTRCT
2050 ; 1ST CHR NO D? INSRT IT
2060     LDX #$00
2070     LDY #$00
2080     LDA INP1+1
2090     CMP #':
2100     BNE CONTPROC
2110     LDY #$01
2120     LDA #'D
2130     STA FILE
2140 CONTPROC
2150     LDA INP1,X
2160     STA FILE,Y
2170     INX
2180     INY
2190     CMP #EOL
2200     BNE CONTPROC
2210 ;
2220     LDA FILE+3
2230     CMP #EOL    ;HAVE ARGS?
2240     BNE PREPRTN ;YES, RETURN
2250      @CPYMEM  ARGS,FILE+3
2260     RTS
2270 DEFDSKID
2280      @CPYMEM  DISK,FILE
2290 PREPRTN
2300     RTS
2310 ;
2320 COMVIE
2330      @FILLMEM  BUF,$FF,$20
2350     JSR GETFILESPEC
2360 ; GET START
2370      @PRNTLN  FLST,DEL
2380     JSR GETADDR
2410      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.RD
2420 ; READ FILE TILL POS
2430     LDA FILPOS+1
2440     BEQ COMVIE_1 ;NO HI BYTE
2450     LDA #$00
2460     STA D0
2470     LDA #$01
2480     STA D1
2490     LDX FILPOS+1
2500 COMVIE_0
2510      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0,D1
2520     CPY #ICSTAT.EOF
2530     BEQ COMVIE_3
2540     DEX
2550     BNE COMVIE_0
2560 COMVIE_1
2570     LDA FILPOS
2580     STA D0
2590     BEQ COMVIE_2 ;NO LO BYTE
2600      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
2610     CPY #ICSTAT.EOF
2620     BEQ COMVIE_3
2630 ;READ AND DSP
2640 COMVIE_2
2650     JSR PRNTNL
2660     LDA #$80
2670     STA D0
2680      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
2690     LDA #$00
2700     STA ABORT   ;CLR FLG
2710     LDX #DSKID1
2720     LDA ICBLL,X ;BYTES READ?
2725     BEQ COMVIE_3 ;NONE LEFT
2730     STA BYTRD
2740     JSR DSPBIN
2750     JSR PRNTNL
2760     LDA ABORT
2770     BNE COMVIE_3
2780 ; VIEW MORE?
2790      @PRNTLN  VIMR,DEL
2800     JSR YESORMENU
2810     BEQ COMVIE_2 ;Y
2840 COMVIE_3
2850      @PRNTLN  REOF
2860     JMP GETCOM
2870 ;
2880 COMANA
2890     JSR DTCDNS
2900     STA DENSITY
2920      @PRNTLN  SCNM,DEL
2930      @INPRM  SCTR,5 ;4 DGT+EOL
2940     JSR GETTEXT
2950      @CPYMEM  SCTR,BUF+1
2960     DEY
2970     STY BUF
2980      @INPRM  BUF
2990     JSR DEC2HEX
3000     JSR PRNTNL
3010 ; NOT @SETSCT: VALUE IS ZP (<256)
3012     LDA VALUE
3014     STA DAUX1
3016     LDA VALUE+1
3018     STA DAUX2
3020      @FILLMEM  BUF,$FF,$00
3040 COMANA_0
3050      @DOSIO  SIO.RD,SIOST.RD,BUF,$07,$00,$00
3070 ;
3080     LDA DAUX1
3090     STA VALUE
3100     LDA DAUX2
3110     STA VALUE+1
3120     LDA # <SCTR
3130     LDY # >SCTR
3140     JSR BIN2DEC
3150     LDA #$00
3160     STA D0
3170      @FILLMEM  SECT+$08,$04,$20
3180      @CPYMEM  SCTR+1,SECT+$08,1,D0,SCTR
3190      @PRNTLN  SECT
3200     LDA #$00
3210     STA FILPOS
3220     STA FILPOS+1
3230     LDA #$80
3240     STA BYTRD
3250     JSR DSPBIN
3260     JSR PRNTNL
3270 ;SHOW MORE/LESS?
3280 COMANA_1
3290      @PRNTLN  VINP,DEL
3300     JSR GETCHR
3310     CMP #'+
3320     BEQ COMANA_2
3330     CMP #'-
3340     BEQ COMANA_3
3350     JMP GETCOM
3360 COMANA_2
3370     INC DAUX1
3380     BNE COMANA_5
3390     INC DAUX2
3400     JMP COMANA_5
3410 COMANA_3
3420     LDA DAUX1
3430     BNE COMANA_4
3440     LDA DAUX2
3450     BEQ COMANA_1
3460     DEC DAUX2
3470 COMANA_4
3480     DEC DAUX1
3490 COMANA_5
3500     JSR PRNTNL
3510     JSR PRNTNL
3520     JMP COMANA_0
3530 ;
3540 COMCMP
3550     LDA #$00
3560     STA ABORT
3570     LDA #$FF
3580     STA BYTRD
3600 ;GET 1ST
3610      @PRNTLN  BCMF,DEL
3620     JSR GETSPEC
3650      @CPYMEM  FILE,BUF
3660 ;GET 2ND
3670      @PRNTLN  BCMS,DEL
3680     JSR GETSPEC
3710 ;OPEN FILES
3720      @DOCIO  DSKID1,ICM.OP,BUF,ICAX.RD
3730      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.RD
3740 ;LOOP & CMPR BLOCKS OF $FF
3750 COMCMP_1
3760     LDA #$00
3770     STA D1
3780     LDA #$FF
3790     STA D0
3800      @DOCIO  DSKID1,ICM.GB,M4000,ICAX.RD,D0,D1
3810     LDX #DSKID1
3820     JSR CHKEOF
3830      @DOCIO  DSKID2,ICM.GB,M5000,ICAX.RD,D0,D1
3840     LDX #DSKID2
3850     JSR CHKEOF
3860 ;CMPR 2 BUFS
3870     LDX #$00
3880 COMCMP_2
3890     LDA M4000,X
3900     CMP M5000,X
3910     BNE COMCMP_3
3920     INX
3930     CPX BYTRD   ;ACTUAL READ
3940     BNE COMCMP_2
3950 ;ABORT?
3960     LDA ABORT
3970     BEQ COMCMP_1 ;READ NXT
3980 ;SAME
3990 COMCMP_4
4000      @PRNTLN  BSAM
4010     JMP GETCOM
4020 ;DIFFERENT
4030 COMCMP_3
4040      @PRNTLN  BDIF
4050     JMP GETCOM
4100 ;
4110 CHKEOF
4120     CPY #ICSTAT.EOF
4130     BNE CHKEOF_1
4140     LDA #$01
4150     STA ABORT
4160 CHKEOF_1
4170     LDA ICBLL,X
4180     CMP BYTRD   ;MIN BYTES 2 CPR
4190     BCS CHKEOF_2
4200     STA BYTRD
4210 CHKEOF_2
4220     RTS
4230 ;
4240 COMMEM
4260 ;"LOW: XXXX  HIGH: XXXX" IN FILE
4270      @CPYMEM  MEMS,FILE
4280     LDY #$04
4290     LDA MEMLO+1
4300     JSR HEXOUT
4310     LDA MEMLO
4320     JSR HEXOUT
4330     LDY #$0F
4340     LDA MEMTOP+1
4350     JSR HEXOUT
4360     LDA MEMTOP
4370     JSR HEXOUT
4380 ;GET ADDRESS
4390      @PRNTLN  GOTA,DEL
4400     JSR GETADDR
4430 ;
4440      @PRNTLN  FILE
4610     JSR PRNTNL
4620 ;COPY MEMORY
4630 COMMEM_1
4635     LDA #$80    ;FULL BLOCK: BYTE COMPARE LEAVES LESS IN BYTRD
4640     STA BYTRD
4645     LDY #$00
4650     LDA FILPOS
4660     STA INDPTR
4670     LDA FILPOS+1
4680     STA INDPTR+1
4690 COMMEM_2
4700     LDA (INDPTR),Y
4710     STA BUF,Y
4720     INY
4730     BPL COMMEM_2
4740 ;
4750     JSR DSPBIN
4760 ;SHW MORE/LESS?
4770      @PRNTLN  VINP,DEL
4780     JSR GETCHR
4790     CMP #'+
4800     BEQ COMMEM_6
4810     CMP #'-
4820     BEQ COMMEM_4
4830     JMP GETCOM
4840 COMMEM_4
4850     LDA FILPOS+1
4860     BNE COMMEM_5
4870     LDA #$00
4880     STA FILPOS
4890     BEQ COMMEM_6
4900 COMMEM_5
4910     DEC FILPOS+1
4920 COMMEM_6
4930     JSR PRNTNL
4940     JSR PRNTNL
4950     JMP COMMEM_1
4960 ;
4970 COMNEW
4990     JSR CHKANDUPDSTATBAR
5000      @PRNTLN  DRVN,DEL
5010     JSR GETCHR  ;GET DRV #
5020 ;DRV AVAIL?
5030     STA D0      ;CACHE
5040     SEC
5050     SBC #$30    ;CNVRT TO INDEX
5060     TAX
5070     LDA #$00
5080     SEC
5090 COMNEW_1
5100     ROL A
5110     DEX
5130     CLC
5140     BNE COMNEW_1
5150     AND DRIVES
5160     BEQ COMNEWERR
5170     LDA D0
5180     STA DISK+1  ;UPD CMD
5190      @RMASCII
5200     STA DSKNUM
5210     JSR UPDSTATBAR
5220     JMP GETCOM
5230 COMNEWERR
5240     JMP NLMENU
5260 ;
5270 PRPEXT
5273     LDA #$E0    ;ROM FONT FOR DOS/PROGRAM
5276     STA CHBAS
5280     LDA DOSIN
5290     STA DOSINI
5300     LDA DOSIN+1
5310     STA DOSINI+1
5320     JMP CLOSEIO
5340 ;
5350 COMQIT
5360     JSR PRNTNL
5370     JSR PRPEXT
5380     JMP (DOSVEC)
5390 COMDIG
5400     STA INP1
5410     LDA #':
5420     STA INP1+1
5430     LDA #EOL
5440     STA INP1+2
5450     JSR PROCFILESPEC
5460     JSR PRNTNL
5470     JMP COMDIR_1
5480 ;
5490 COMDIR
5510     JSR GETFILESPEC
5520 COMDIR_1
5530      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.DR
5540     JSR READIR
5550     JSR PRNTNL
5560 ; DSP TOT FIL CNT
5570     LDA COUNT
5580     STA VALUE
5590     LDA #$00
5600     STA VALUE+1
5610     LDA # <INP1
5620     LDY # >INP1
5630     JSR BIN2DEC
5640      @CPYMEM  INP1+1,NUMF+$11
5650 ;
5660      @PRNTLN  NUMF
5670     JMP NLMENU
5690 ;
5700 COMCAR
5720 ;
5730     LDA TRAMSZ  ;HAVE A?
5740     CMP #$01
5750     BEQ CAR.A
5760     JMP GETCOM  ;NO CARTRIDGE
5770 CAR.A
5780     JSR PRPEXT
5790     JMP ($BFFA)
5840 ;
5850 COMCPY
5860     LDA DSKNUM  ; DEF DSK
5870      @MKASCII
5880     STA TMPDSK
5890 ;
5910     JSR GETFILESPEC
5920     LDA FILE+1  ;CACHE SRC DRV
5930     STA NUM2CNV
5940      @PRNTLN  INST,DEL
5950     JSR GETCHR
5960     CMP #'Y
5969     BNE COMCPY_0
5978     LDA NUM2CNV ;Y=SAME AS SOURCE
5987     BNE COMCPY_1 ;ALWAYS
5996 COMCPY_0
6005     CMP #'1
6014     BCC COMCPY_4
6023     CMP #'9
6032     BCS COMCPY_4
6041 COMCPY_1
6050     STA TMPDSK
6060 COMCPY_2
6070     JSR PRNTNL
6080     JSR PRNTNL
6090      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.DR
6100 COMCPY_3
6110     LDA #$12
6120     STA D0
6130      @DOCIO  DSKID1,ICM.GB,FILE,ICAX.DR,D0
6140     CPY #$80
6150     BCS COMCPY_4
6160     LDA #$00
6170     STA D0
6180     LDA #$08
6190     STA D1
6200      @CPYMEM  FILE+$02,INP1,0,D0,D1
6210     LDA #'.
6220     STA INP1+$08
6230     LDA #$09
6240     STA D0
6250     LDA #$03
6260     STA D1
6270      @CPYMEM  FILE+$0A,INP1,0,D0,D1
6280     LDA #EOL
6290     STA INP1+$0C
6300     JSR PROCFILESPEC
6310     LDA NUM2CNV ;RESTORE DRV
6320     STA FILE+1
6330 ;
6340     JSR TRIMSP
6350     JSR FILCPY
6360     JMP COMCPY_3
6370 COMCPY_4
6380     JMP NLMENU
6400 ;
6410 ;A - READ/WRITE
6420 FILCPY
6422 ; NEED XTD MEM TO COPY
6424     LDA NUMBKS
6426     BNE FILCPY_0
6428     JMP FILCPY_NM
6430 FILCPY_0
6432      @COLGRN
6440     LDA #$01
6450     STA ACVMEM
6460     TAX
6470     LDA BANKS,X ; 1ST BANK
6480     STA PORTB
6490 ;
6500     LDA #'-
6510     STA BUF
6520      @CPYMEM  FILE,BUF+1
6530     LDA #DEL
6540     STA BUF,Y
6550      @PRNTLN  BUF,DEL
6560      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.RD
6570 FILCPY_1
6580 ; READ 16K BLCKS
6590 ; INTO XTD MEM
6600     LDA #$00
6610     STA D0
6620     LDA #$40
6630     STA D1
6640 ;
6650      @DOCIO  DSKID2,ICM.GB,M4000,ICAX.RD,D0,D1
6660 ; FULL BANK READ?
6670     LDX #DSKID2
6680     LDA ICBLL,X
6690     BNE FILCPY_4
6700     LDA ICBLH,X
6710     CMP #$40
6720     BNE FILCPY_4
6730 ;SWTCH BNK IF WE HAVE ONE
6735     INC ACVMEM
6740     LDX ACVMEM
6745     CPX #$11    ;BANKS TBL END
6748     BCS FILCPY_2
6751     CPX NUMBKS
6754     BEQ FILCPY_3
6757     BCC FILCPY_3
6760 FILCPY_2
6763     JMP FILCPY_NM ;TOO BIG
6766 FILCPY_3
6775     LDA BANKS,X
6780     STA PORTB
6785     BNE FILCPY_1 ;ALWAYS
6790 FILCPY_4
6800 ; CACHE # BYTES READ
6820     LDA ICBLL,X
6830     STA VALUE
6840     LDA ICBLH,X
6850     STA VALUE+1
6860 ;
6870      @CLOSEIO  DSKID2
6871     LDA BANKS
6872     STA PORTB   ;MAIN FOR PROMPTS
6873 ; SAME DRV? SWAP TO TARGET
6874     LDA TMPDSK
6875     CMP NUM2CNV
6876     BNE FILCPY_4_5
6877      @PRNTLN  WFTR,DEL
6878     JSR YESORMENU
6883     JSR PRNTNL
6884 FILCPY_4_5
6890 ; OPEN NEW FILE FOR SAVE
6900      @COLRED
6910     LDA ACVMEM
6920     STA COUNT   ; # TTL BNKS
6930     LDA TMPDSK
6940     STA FILE+1  ;UPD DRV NUM
6950 ;
6960      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.WT
6970     LDA #$01
6980     STA ACVMEM
6990 FILCPY_5
7000     LDX ACVMEM
7010     LDA BANKS,X
7020     STA PORTB
7030 ; FULL BNK, CACHED LEN FOR THE LAST
7040     LDA #$00
7050     STA D0
7060     LDA #$40
7070     STA D1
7080     CPX COUNT   ; LST BNK?
7090     BNE FILCPY_7
7100     LDA VALUE
7110     STA D0
7120     LDA VALUE+1
7130     STA D1
7140 FILCPY_7
7180      @DOCIO  DSKID2,ICM.PB,M4000,ICAX.WT,D0,D1
7190     LDA ACVMEM
7200     CMP COUNT
7210     BEQ FILCPY_8
7220     INC ACVMEM
7230     BNE FILCPY_5 ;ALWAYS
7240 FILCPY_8
7242      @CLOSEIO  DSKID2
7244     LDA BANKS
7246     STA PORTB   ; RESTORE
7248     JSR PRNTNL
7250 ; SAME DRV? SWAP BACK TO SOURCE
7252     LDA TMPDSK
7254     CMP NUM2CNV
7256     BNE FILCPY_9
7258      @PRNTLN  INSS,DEL
7260     JSR YESORMENU
7270     JSR PRNTNL
7272 FILCPY_9
7274     RTS
7276 ;FILE TOO BIG FOR XTD MEM
7278 FILCPY_NM
7280     LDA BANKS
7282     STA PORTB
7284      @PRNTLN  NOMM
7286     JMP GETCOM
7300 ;
7310 TRIMSP
7320     LDX #$00
7330     LDY #$00
7340 TRIMSP_1
7350     LDA FILE,X
7360     CMP #$20
7370     BEQ TRIMSP_2
7380     STA INP1,Y
7390     INY
7400 TRIMSP_2
7410     INX
7420     CMP #EOL
7430     BNE TRIMSP_1
7440      @CPYMEM  INP1,FILE
7450     RTS
7460 ;
7470 COMDUP
7490      @COLGRN
7500      @PRNTLN  INSS,DEL
7510     JSR YESORMENU
7560      @PRNTLN  DLLN,DEL
7570 ; DENSITY? ITS NAME INTO DUPS+$0B, # BANKS NEEDED IN A
7580     JSR DTCDNS
7590     STA DENSITY
7600     ASL A
7610     ASL A
7620     ASL A       ;NAMES ARE 8 APART
7630     TAY
7640     LDX #$00
7650 COMDUP_1
7660     LDA DSNG-8,Y
7670     STA DUPS+$0B,X
7680     INY
7690     INX
7700     CPX #$07
7710     BNE COMDUP_1
7720     LDX DENSITY
7730     LDA DUPBNK-1,X
7740 ;HAVE ENOUGH MEM?
7750 COMDUP_3
7816     CMP NUMBKS
7822     BEQ COMDUP_3_5 ;EXACT FIT OK
7828     BCC COMDUP_3_5
7831     JMP COMDUP_7 ;NOT ENOUGH MEMORY
7834 COMDUP_3_5
7840      @PRNTLN  DUPS,DEL
7850     JSR RSTSCTCNT
7860 ; READ
7870     LDA DSKNUM
7880     STA TMPDSK
7890     LDA #$04
7900     STA COLCRS
7910      @PRNTLN  MODR,DEL
7920     LDA #SIO.RD
7930     JSR DSKCPY
7940 ; ASK
7950      @COLRED
7960     JSR PRNTNL
7970     JSR PRNTNL
7980      @PRNTLN  INST,DEL
7990     JSR GETCHR
8000     CMP #'Y
8010     BEQ COMDUP_5
8020     CMP #'1
8030     BCC COMDUP_6
8040     CMP #'9
8050     BCS COMDUP_6
8060 ; UPD DSK #
8070     STA DISK+1
8080      @RMASCII
8090     STA DSKNUM
8100 ;SAME DNSTY?
8110 COMDUP_5
8120      @HIDCUR
8130      @PRNTLN  DELL,DEL
8140     JSR RESETFIO
8150     JSR DTCDNS
8170     CMP DENSITY
8180     BEQ COMDUP_4
8190 ; FORMAT IF NEEDED
8200     LDA #$04
8210     STA COLCRS
8220      @PRNTLN  MODF,DEL
8230     JSR CLRDUPDSP
8240     JSR DOINIT
8250 ;WRITE
8260 COMDUP_4
8270     JSR RSTSCTCNT
8280     LDA #$04
8290     STA COLCRS
8300      @PRNTLN  MODW,DEL
8310     LDA #SIO.WT
8320     JSR DSKCPY
8330 COMDUP_6
8340 ; RSTR DSK #
8350     LDA TMPDSK
8360     STA DSKNUM
8370      @MKASCII
8380     STA DISK+1
8390 ;
8400      @SHWCUR
8410      @COLDEF
8420     JMP NLMENU
8440 COMDUP_7
8450      @PRNTLN  NOMM
8460     JMP NLMENU
8480 ;
8490 ;A - READ/WRITE
8500 DSKCPY
8510     STA D2      ;CACHE: SIO.RD OR SIO.WT
8520 ;PREP XTD MEM
8590      @HIDCUR
8600     LDA #$01
8610     STA ACVMEM
8620     JSR BNK2DEC
8630     LDX #$01
8640     LDA BANKS,X ;1ST BANK
8650     STA PORTB
8660 ; PREP DRV
8670     JSR READFIO
8680     LDA #$31
8690     STA DDEVIC
8700     LDA D2
8710     STA DCOMND
8720     LDA DSKNUM
8730     STA DUNIT
8740     LDA # <M4000
8750     STA DBUFLO
8760     LDA # >M4000
8770     STA DBUFHI
8780     LDA #$07
8790     STA DTIMLO
8800      @SETSCT  $01,$00
8810 ;READ OR WRITE?
8820 DSKCPY_2
8830     LDA DCOMND
8840     CMP #SIO.RD
8850     BEQ DSKCPY_3
8860     LDA #SIOST.WT
8870     BNE DSKCPY_4 ;ALWAYS
8880 DSKCPY_3
8890     LDA #SIOST.RD
8900 ;OPERATION
8910 DSKCPY_4
8920     STA DSTATS
8930     JSR CALLSIO
8940     JSR UPDDUPDSP
8950     JSR INCSCTCNT
8960 ; ADVANCE
8961 ; DBL: 1 PAGE PER SCTR (INCL 1-3)
8962 ; SO NO SCTR CROSSES $8000
8963     LDA DENSITY
8964     CMP #$03
8965     BNE DSKCPY_SD
8966     INC DBUFHI
8967     LDA DBUFHI
8968     BNE DSKCPY_CHK ;ALWAYS
8969 DSKCPY_SD
8970     CLC
8980     LDA DBUFLO
8990     ADC DBYTLO
9000     STA DBUFLO
9010     LDA DBUFHI
9020     ADC DBYTHI
9030     STA DBUFHI
9035 DSKCPY_CHK
9040     CMP #$80
9050     BNE DSKCPY_5
9060 ; RST BUF AND INC BNK
9070     LDA # >M4000
9080     STA DBUFHI
9090     INC ACVMEM  ;NXT BNK
9100     LDA ACVMEM
9110     JSR BNK2DEC
9120     LDA ACVMEM
9130     TAX
9140     LDA BANKS,X
9150     STA PORTB
9160 ;NEXT SECTOR
9170 DSKCPY_5
9180     INC DAUX1
9190     BNE DSKCPY_6
9200     INC DAUX2
9210 DSKCPY_6
9220 ; DONE? STOP AT SECTOR 721 ($2D1), ENHANCED 1041 ($411)
9230     LDX #$02
9240     LDY #$D1
9250     LDA DENSITY
9260     CMP #$02
9270     BNE DSKCPY_7
9280     LDX #$04
9290     LDY #$11
9300 DSKCPY_7
9310     CPX DAUX2
9320     BNE DSKCPY_9
9330     CPY DAUX1
9340     BNE DSKCPY_9
9420 DSKCPY_8
9430      @SHWCUR
9440     LDA BANKS
9450     STA PORTB   ; RESTORE
9460     RTS
9470 DSKCPY_9
9480     JMP DSKCPY_2
9490 ;
9500 CLRDUPDSP
9510     LDA #$17
9520     STA COLCRS
9530      @PRNTLN  DUPE,DEL
9540     LDA #$1E
9550     STA COLCRS
9560      @PRNTLN  DUPE,DEL
9570     RTS
