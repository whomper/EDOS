;
; EDOSMAIN.M65 - EDOS 3.6
; Start-up, the menu and Load Binary
; Copyright (C) 2026 AERA | Erez Yaary
;
; Included by EDOS.M65 after UTILS.M65
; Also the file spec helpers.
;
; PRE_START - the run address: hook
; RESET (xl's AXSTART keeps DOS's
; DOSINI and points DOSINI at AXINIT,
; which runs DOS's init, then START)
; Exit: falls into START
;
PRE_START
         JSR AXSTART
;
; START - AXWARM: RESET comes here
; after DOS's init; PRE_START falls
; in. Keeps SP for GETCOM and the
; main bank's PORTB; sets the screen,
; drive 1 and the font
; Exit: falls into GOMENU; it never
; returns to the OS
;
START
         TSX                ; SP for GETCOM
         STX STKPTR
         LDA #$40           ; capitals
         STA SHFLOK
         LDA #$02           ; margins 2..39
         STA LMARGN
         LDA #$27
         STA RMARGN
         LDA PORTB
         STA BANKS          ; the main bank's PORTB
         LDA #1
         STA DSKNUM         ; drive 1 by default
; The font (xl's AXFONT): AERA.FNT
; read once, below the screen, and
; selected again on every start, as
; RESET puts the ROM's back
         LDX #DSKID1
         JSR AXFONT
         @HIDCHR
;
; GOMENU - clear the screen, draw the
; title, the status bar and the menu.
; The drives and memory are checked
; only the first time (REFDRV is 1 in
; the file). RETURN at the prompt
; comes here too (CMDKEY)
; Exit: falls into NLMENU
;
GOMENU
         @HIDCHR
         @PRNTLN TTL1,DEL
         @DRAW CHL,$00,$24
         @PRNTLN TTL2
         @DRAW CHL,$00,$24
;
         LDA REFDRV
         BEQ GOMENU_1
         JSR CHKANDUPDSTATBAR
GOMENU_1
         LDA #$00
         STA REFDRV
         @PRNTLN STAT
         LDA #$03           ; the menu: margin 3
         STA LMARGN
         @DRAW CHL,$00,$24
         @PRNTLN MNU1,DEL
         @PRNTLN MNU2,DEL
         LDA #$02
         STA LMARGN
;
; NLMENU - a new line, then GETCOM
; Exit: falls into GETCOM
;
NLMENU
         JSR PRNTNL
;
; GETCOM - the command prompt. Drops
; what an abort or error left on the
; stack, maps the main bank, black
; background, forgets the fast SIO
; code, closes the IOCBs, opens K:
; and reads a key. HELP or ?: the
; About lines (COMHLP). 1-8: COMDIG,
; that drive's directory. A key in
; CMDKEY: its title bar (the first
; NTITLE only), then its command,
; from the tables CMDLO and CMDHI
; Exit: to the command; ESC: NLMENU;
; any other key: GETCOM again
;
GETCOM
         LDX STKPTR         ; drop the stack left
         TXS                ; by aborts and errors
         LDA BANKS          ; the main bank first
         STA PORTB
         @COLDEF
         JSR RESETFIO
         JSR CLOSEIO
         @DOCIO KBDID,AXOPEN,KYBD,AXOPNIN
         @SHWCUR
         @SIOSNDON
         LDA #$00           ; forget a HELP pressed
         STA HELPFG         ; during a command
         @PRNTLN ANYK,DEL
; Wait: HELP (HELPFG; K: never
; returns it), a key (CH) or BREAK
; (BRKKEY 0: K: reports it)
GETCOM_W
         LDA HELPFG
         BNE GETCOM_H
         LDA BRKKEY
         BEQ GETCOM_K
         LDA CH
         CMP #$FF           ; $FF: no key yet
         BEQ GETCOM_W
GETCOM_K
         JSR GETCHR
; A digit 1-8?
         CMP #'1
         BCC FINDCM
         CMP #'9
         BCS FINDCM
         JMP COMDIG
FINDCM
         LDX #$00
FINDCM_1
         CMP CMDKEY,X
         BEQ FOUND
         INX
         CPX #NUMCMD
         BNE FINDCM_1
         BEQ GETCOM         ; not a command
GETCOM_H
         LDA #$00           ; HELP seen: as ?
         STA HELPFG
         JMP COMHLP
FOUND
         CPX #NTITLE
         BCS FOUND_1        ; no title bar
         JSR TITLE          ; keeps X
FOUND_1
         LDA CMDLO,X
         STA INDPTR
         LDA CMDHI,X
         STA INDPTR+1
         JMP (INDPTR)
;
; YESORMENU - read a key: Y returns,
; any other goes back to GETCOM (ESC
; to NLMENU, in GETCHR)
; Exit: A="Y", Z=1; X and Y changed
;
YESORMENU
         JSR GETCHR
         CMP #'Y
         BNE GETCOM
         RTS
;
; COMLOA - L, Load Binary: ask for
; the file, and whether to run it
; (first: EDOS may be gone after the
; load), open it, check its $FFFF,
; set the page-6 loader up and jump
; to it
; Exit: to LDR; not binary: NLMENU;
; a CIO error: DISKERR
;
COMLOA
         JSR GETFILESPEC
         @PRNTLN RUNP,DEL
         JSR GETCHR
         PHA                ; the answer
         JSR PRNTNL
; The file goes on IOCB #1, as in
; DOS 2; K: is on IOCB #1 too
         LDX #KBDID
         JSR CLOSECHANNEL
         @DOCIO LDRID,AXOPEN,FILE,AXOPNIN
         LDA #$02           ; its first 2 bytes
         STA D0
         @DOCIO LDRID,AXGETCHR,BUF,AXOPNIN,D0
         LDA BUF
         AND BUF+1
         CMP #$FF
         BEQ COMLOA_1       ; $FFFF: binary
         @PRNTLN NOTB
         JMP NLMENU
; The page-6 loader reads the rest
COMLOA_1
         LDY #$00
COMLOA_2
         LDA LDRSRC,Y       ; a page to LDR
         STA LDR,Y
         INY
         BNE COMLOA_2
         PLA
         CMP #'Y
         BNE COMLOA_3       ; Y=0: do not run
         LDY #$80
COMLOA_3
         STY LR.RUN         ; $80: run it
         LDA AXDOSI         ; DOS's DOSINI, for RESET
         STA LR.DOSI
         LDA AXDOSI+1
         STA LR.DOSI+1
         LDA MEMTOP+1       ; the pages from MEMTOP up
         STA LR.TAB+6
         LDA AXFPG          ; the font's 4 pages, if
         BEQ COMLOA_4       ; it is AERA.FNT: not 0
         CMP #$E0           ; (not tried) or $E0
         BEQ COMLOA_4       ; (the ROM's)
         STA LR.TAB+8
         CLC
         ADC #$03
         STA LR.TAB+9
COMLOA_4
         LDA #$00           ; no run address yet
         STA RUNAD
         STA RUNAD+1        ; (GETCOM closed IOCB 3)
         JMP LDR
;
; LDRBAK - back from the loader, with
; EDOS untouched. Y: 1 loaded, 0 it
; loads over page 6, else the CIO
; error. Runs it if asked and it has
; a run address
; Exit: NLMENU or DISKERR; a program
; that returns: PRE_START
;
LDRBAK
         DEY
         BEQ LDRBAK_3       ; loaded
         INY
         BEQ LDRBAK_1       ; over page 6
         JMP DISKERR
LDRBAK_1
         @PRNTLN LDOV
LDRBAK_2
         JMP NLMENU
LDRBAK_3
         BIT LR.RUN
         BPL LDRBAK_2       ; not asked to run
         LDA RUNAD
         ORA RUNAD+1
         BEQ LDRBAK_2       ; no run address
         JSR PRPEXT         ; ROM font, DOS's DOSINI
         JSR LDRBAK_4
         JMP PRE_START      ; it returned: EDOS again
LDRBAK_4
         JMP (RUNAD)
;
; LDRSRC - the page-6 loader. COMLOA
; copies it to LDR ($0600) and jumps
; there, IOCB #1 open past the first
; $FFFF. Run from there, it can load
; a program over EDOS; it reaches its
; own labels only through the LR.
; equates below. A segment: its start
; (after any $FFFF), its end, the
; LR.TAB check, the data, then INITAD
; if the segment set it
; Exit: LDRBAK while EDOS is still
; there; once it is gone, RUNAD (if
; asked) and then DOSVEC
;
LDRSRC
LD.SG
         LDA #$00           ; no INITAD yet
         STA INITAD
         STA INITAD+1
LD.SG1
         LDA # <LR.H        ; the start; again if $FFFF
         JSR LR.HDR
         BMI LD.EN1         ; EOF or an error
         LDA LR.H
         AND LR.H+1
         CMP #$FF
         BEQ LD.SG1
         LDA # <LR.E        ; the end
         JSR LR.HDR
LD.EN1
         BMI LD.END
; The pages it must not load over
; (LR.TAB pairs, X=8 to 0): page 6 is
; an error; the others end EDOS, so
; RESET and the font go back to DOS's
         LDX #$08
LD.CK1
         LDA LR.TAB+1,X     ; the pair's last page
         CMP LR.H+1
         BCC LD.CK2         ; below the start
         LDA LR.E+1
         CMP LR.TAB,X
         BCC LD.CK2         ; above the end
         LDY #$00
         TXA
         BEQ LD.ERR         ; page 6: Y=0
         LDA #$80
         STA LR.GONE
         LDA LR.DOSI
         STA DOSINI
         LDA LR.DOSI+1
         STA DOSINI+1
         LDA #$E0           ; the ROM font
         STA CHBAS
LD.CK2
         DEX
         DEX
         BPL LD.CK1
; Read END-START+1 bytes to START
         LDX #LDRID
         LDA LR.H
         STA ICBAL,X
         LDA LR.H+1
         STA ICBAH,X
         SEC
         LDA LR.E
         SBC LR.H
         STA ICBLL,X
         LDA LR.E+1
         SBC LR.H+1
         STA ICBLH,X
         INC ICBLL,X
         BNE LD.LD1
         INC ICBLH,X
LD.LD1
         JSR LR.GB
         STY LR.ST
         BPL LD.IN
         CPY #AXEOF
         BNE LD.ERR         ; EOF ends the file
LD.IN
         LDA INITAD
         ORA INITAD+1
         BEQ LD.IN1
         JSR LR.JINI        ; run its INITAD
LD.IN1
         LDY LR.ST
         BMI LD.END         ; it was EOF
         JMP LDR            ; the next segment: LD.SG
LD.END
         CPY #AXEOF
         BNE LD.ERR
         LDY #$01
; Y: 1 loaded, 0 over this page, else
; the CIO error
LD.ERR
         STY LR.ST
         LDA #AXCLOSE
         JSR LR.CIO
         LDY LR.ST
         BIT LR.GONE
         BMI LD.GN
         JMP LDRBAK         ; EDOS is still there
LD.GN
         DEY
         BNE LD.EXIT        ; not loaded
         BIT LR.RUN
         BPL LD.EXIT        ; not asked to run
         LDA RUNAD
         ORA RUNAD+1
         BEQ LD.EXIT
         JSR LR.JRUN
LD.EXIT
         JMP (DOSVEC)
;
; LD.HDR - read 2 bytes from the file
; to LDR+A, in this page. LD.GB: get
; bytes, the IOCB as it is set.
; LD.CIO: command A on IOCB #1
; Exit: Y = the status, N=1 on an
; error or EOF; A, X changed
;
LD.HDR
         LDX #LDRID
         STA ICBAL,X
         LDA # >LDR
         STA ICBAH,X
         LDA #$02
         STA ICBLL,X
         LDA #$00
         STA ICBLH,X
LD.GB
         LDA #AXGETCHR
LD.CIO
         LDX #LDRID
         STA ICCOM,X
         JMP CIOV
;
; For JSR: JMP (INITAD), JMP (RUNAD)
;
LD.JINI
         JMP (INITAD)
LD.JRUN
         JMP (RUNAD)
;
; The segment's start and end (LR.E)
LD.H     .BYTE 0,0,0,0
; Page pairs (first, last) it must not
; load over: this page, zero page,
; EDOS and its work area, MEMTOP up
; (COMLOA sets the first) and the
; font (COMLOA sets it; $FF,0 is none)
LD.TAB   .BYTE >LDR,>LDR,0,0,>START_PROG,$3F
         .BYTE 0,$FF,$FF,0
LD.ST    .BYTE 0            ; the last CIO status
LD.RUN   .BYTE 0            ; $80: run it
LD.GONE  .BYTE 0            ; $80: EDOS is gone
LD.DOSI  .BYTE 0,0          ; DOS's DOSINI
LDREND
;
; Where it runs, and its labels there
;
LDR      = $0600
LR.HDR   = LDR+LD.HDR-LDRSRC
LR.GB    = LDR+LD.GB-LDRSRC
LR.CIO   = LDR+LD.CIO-LDRSRC
LR.JINI  = LDR+LD.JINI-LDRSRC
LR.JRUN  = LDR+LD.JRUN-LDRSRC
LR.H     = LDR+LD.H-LDRSRC
LR.E     = LR.H+2
LR.TAB   = LDR+LD.TAB-LDRSRC
LR.ST    = LDR+LD.ST-LDRSRC
LR.RUN   = LDR+LD.RUN-LDRSRC
LR.GONE  = LDR+LD.GONE-LDRSRC
LR.DOSI  = LDR+LD.DOSI-LDRSRC
         .IF LDREND-LDRSRC>$100
         JMP LOADER_LONGER_THAN_A_PAGE ; undefined: stops assembly
         .ENDIF
;
; CALCLEN - set FILLEN to
; FILEND-FILPOS+1 (16 bits)
; Exit: FILLEN set; A changed
;
CALCLEN
         SEC
         LDA FILEND
         SBC FILPOS
         STA FILLEN
         LDA FILEND+1
         SBC FILPOS+1
         STA FILLEN+1
         INC FILLEN
         BNE CALCLEN_1
         INC FILLEN+1
CALCLEN_1
         RTS
;
; GETFILESPEC - ask "File Spec: ",
; then GETSPEC
; Exit: falls into GETSPEC
;
GETFILESPEC
         @PRNTLN FSPC,DEL
;
; GETSPEC - read a line into INP1,
; then PROCFILESPEC (falls in)
; Exit: as PROCFILESPEC; BREAK:
; GETCOM; an error: DISKERR
;
GETSPEC
         JSR GETINP1
;
; PROCFILESPEC - the file spec FILE
; from INP1 (ending in EOL). Empty:
; DISK, "Dn:*.*" for the drive in use.
; "Dn:..." as it is; "n:..." gets a D
; in front; a name alone, or "D:" and
; a name, gets DISK's "Dn:". A device
; with no name gets the name ARGS,
; "*.*"
; Exit: FILE set; A, X, Y changed
;
PROCFILESPEC
         LDA INP1
         CMP #EOL
         BEQ DEFDSKID       ; empty: DISK
         LDX #$00           ; from INP1's start
         LDA INP1+2
         CMP #':
         BEQ CMPLTSTRCT     ; "Dn:"
         LDA INP1+1
         CMP #':
         BNE PROCFS_1       ; a name alone
         LDA INP1
         CMP #'D
         BNE CMPLTSTRCT     ; "n:"
         LDX #$02           ; "D:": after it
PROCFS_1
         LDY #$02           ; DISK's "Dn:", then
PROCFS_2
         LDA DISK,Y         ; INP1 from X
         STA FILE,Y
         DEY
         BPL PROCFS_2
         LDY #$03
         BNE CONTPROC       ; always
CMPLTSTRCT
         LDY #$00
         LDA INP1+1
         CMP #':
         BNE CONTPROC
         LDY #$01           ; "n:": a D in front
         LDA #'D
         STA FILE
CONTPROC
         LDA INP1,X         ; copy it, with its EOL
         STA FILE,Y
         INX
         INY
         CMP #EOL
         BNE CONTPROC
;
         LDA FILE+3
         CMP #EOL
         BNE PREPRTN        ; it has a name
         @CPYMEM ARGS,FILE+3
         RTS
DEFDSKID
         @CPYMEM DISK,FILE
PREPRTN
         RTS
;
