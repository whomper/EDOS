013150    @CLOSEIO  DSKID2
013160   LDX #KBDID
013170   JMP CLOSECHANNEL
013180 ;
013190 DISPLAYCHECKING
013200    @HIDCUR
013210    @CHECURPOS
013220   LDA #$03
013230   STA ROWCRS
013240   LDA #$02
013250   STA COLCRS
013260    @PRNTLN  UPDT,DEL
013270    @RSTCURPOS
013280   JMP SHOWCURSOR
013300 ;
013310 ;DRVS WE HAVE? HS?
013320 CHKDRVS
013330 ; UPD MSG
013340    @SIOSNDOFF
013350   STA DRIVES  ;ZERO BITS
013360   STA DRVHS
013370   LDA #$01
013380   STA BITWISE ;1ST DRV
013400   STA DUNIT
013410 CHKDRV_0
013420    @DOSIO  SIO.ST,SIOST.RD,BUF,$07,$04,$00,CNGDSK
013460   CPY #$01
013470   BNE CHKDRV_3 ;EMPTY->NEXT
013480 ; SPEEDY DRV?
013490    @DOSIO  SIO.HS,SIOST.RD,BUF,$01,$01,$00,CNGDSK
013510   LDA BUF
013520   CMP #$09
013530   BEQ CHKDRV_1
013540   CMP #$0A
013550   BNE CHKDRV_2
013570 CHKDRV_1
013580   LDA DRVHS
013590   ORA BITWISE
013600   STA DRVHS
013610 ;1 BIT FOR CONN DRV
013620 CHKDRV_2
013630   LDA DRIVES
013640   ORA BITWISE
013650   STA DRIVES
013655 CHKDRV_3
013660   ASL BITWISE ;NXT DRV BIT
013670   INC DUNIT
013680   LDA DUNIT
013690   CMP #$09
013700   BNE CHKDRV_0
013710    @SIOSNDON
013720   RTS
013760 ;
013770 UPDDRVSPD
013779   LDY DSKNUM
013788   SEC
013797   LDA #$00
013806 UPDRVSPD_0
013815   ROL A
013824   DEY
013833   BNE UPDRVSPD_0
013842 ; IS IT HS? "HIGH" OR "NORM" INTO STAT+$0E
013851   LDX #DRGN-DRSP
013860   AND DRVHS
013869   BEQ UPDRVSPD_1
013878   LDX #$00
013887 UPDRVSPD_1
013896   LDY #$00
013905 UPDRVSPD_2
013914   LDA DRSP,X
013923   STA STAT+$0E,Y
013932   INX
013941   INY
013950   CPY #$04
013959   BNE UPDRVSPD_2
013968   RTS
013980 ;
013990 UPDDRVS
014000   LDX #$03    ;POS IN DRVS TXT
014010   LDA #$01
014020   STA D0      ;DRV INDX
014030   LDA DRIVES
014040   STA D1      ;TEMP
014050 UPTDRV_0
014060   LDA #$20    ;SPACE: NO DRV
014070   LSR D1
014080   BCC UPTDRV_5
014090   LDA D0
014100   CMP DSKNUM
014110   BNE UPTDRV_4
014120   ORA #$80    ;ACTV DRV: INVERSE
014130 UPTDRV_4
014140   ORA #'0     ;DRV DIGIT
014150 UPTDRV_5
014160   STA STAT,X
014170   INX
014180   INC D0
014190   CPX #$0B    ;8 DRVS DONE?
014200   BNE UPTDRV_0
014210   RTS
014360 ;
014370 UPDMEM
014380   JSR DTXMEM
014390   JSR BNK2DEC
014400   LDA #$19
014410   STA D0
014420   LDX MEMD
014430   INX
014440   STX D1
014450    @CPYMEM  MEMD+1,STAT,0,D0,D1
014460   RTS
014470 ;
014480 ;CHKANDUPDATESTATBAR
014490 CHKANDUPDSTATBAR
014500   JSR DISPLAYCHECKING
014510   JSR CHKDRVS
014520   JSR UPDMEM
014530 ;
014540 UPDSTATBAR
014550   JSR UPDDRVS
014560   JSR UPDDRVSPD
014570    @HIDCUR
014580    @CHECURPOS
014590   LDA #$03
014600   STA ROWCRS
014610   LDA #$02
014620   STA COLCRS
014630    @PRNTLN  STAT
014640    @SHWCUR
014650    @RSTCURPOS
014660   RTS
014670 ;
014671 ;PRINT THE TITLE BAR OF COMMAND X (X<NTITLE): ITS MENU LABEL IN
014672 ;INVERSE CAPITALS. LABEL X HAS THE (X+1)TH INVERSE HOTKEY AFTER
014673 ;MNUL (MENU ORDER: LEFT, THEN RIGHT COLUMN) | X KEPT
014674 TITLE
014675   STX D2
014676   LDA # <MNUL
014677   STA CIOPTR
014678   LDA # >MNUL
014679   STA CIOPTR+1
014680   LDY #$00
014681 TITLE_1
014682   LDA (CIOPTR),Y
014683   SEC
014684   SBC #$A0
014685   CMP #$40    ;INVERSE CHARACTER: A HOTKEY
014686   BCS TITLE_2
014687   DEX
014688   BMI TITLE_3 ;LABEL X FOUND
014689 TITLE_2
014690   INC CIOPTR
014691   BNE TITLE_1
014692   INC CIOPTR+1
014693   BNE TITLE_1 ;ALWAYS
014694 ;INP1: DLN, INVERSE SPACE, LABEL, INVERSE SPACE, EOL
014695 TITLE_3
014696   LDA #DLN
014697   STA INP1
014698   LDX #$01
014699   LDA #$A0    ;INVERSE SPACE
014700 TITLE_4
014701   STA INP1,X
014702   INX
014703   LDA (CIOPTR),Y
014704   CMP #EOL
014705   BEQ TITLE_6 ;END OF A RIGHT COLUMN LABEL
014706   INY
014707   CMP #$20
014708   BNE TITLE_5
014709   CMP (CIOPTR),Y
014710   BEQ TITLE_6 ;2 SPACES: END OF A LEFT COLUMN LABEL
014711 TITLE_5
014712   AND #$7F    ;HOTKEY: NOT INVERSE
014713   CMP #$61
014714   BCC TITLE_5_5
014715   AND #$DF    ;LOWER CASE -> UPPER
014716 TITLE_5_5
014717   ORA #$80    ;INVERSE
014718   BNE TITLE_4 ;ALWAYS
014719 TITLE_6
014720   LDA #$A0
014721   STA INP1,X
014722   LDA #EOL
014723   STA INP1+1,X
014724    @PRNTLN  INP1
014725   LDX D2
014726   RTS
014727 ;
014728 ;MENU COMMANDS IN MENU ORDER: THE FIRST NTITLE GET
014729 ;THEIR MENU LABEL AS TITLE BAR (SEE TITLE)
014730 NTITLE = 18
014731 NUMCMD = 20
014732 CMDKEY .BYTE "WFPTUCRDSELIGVNABMQ",EOL
014733 CMDLO .BYTE <COMWRT,<COMDIR,<COMPRC,<COMCAR,<COMUNP
014734   .BYTE <COMCPY,<COMREN,<COMDUP,<COMSAV,<COMERA
014735   .BYTE <COMLOA,<COMINI,<COMGOT,<COMVIE,<COMNEW
014736   .BYTE <COMANA,<COMCMP,<COMMEM,<COMQIT,<GOMENU
014737 CMDHI .BYTE >COMWRT,>COMDIR,>COMPRC,>COMCAR,>COMUNP
014738   .BYTE >COMCPY,>COMREN,>COMDUP,>COMSAV,>COMERA
014739   .BYTE >COMLOA,>COMINI,>COMGOT,>COMVIE,>COMNEW
014740   .BYTE >COMANA,>COMCMP,>COMMEM,>COMQIT,>GOMENU
014741   .IF CMDLO-CMDKEY-NUMCMD
014742   JMP CMDKEY_NEEDS_NUMCMD_KEYS ;UNDEFINED: STOPS ASSEMBLY
014743   .ENDIF
014744   .IF CMDHI-CMDLO-NUMCMD
014745   JMP CMDLO_NEEDS_NUMCMD_ADDRESSES
014746   .ENDIF
