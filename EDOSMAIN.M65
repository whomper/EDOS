011080 COMREN
011100 ; GET OLD FILE SPEC
011110    @PRNTLN  RENO,DEL
011120   JSR GETSPEC
011150    @CPYMEM  FILE,BUF
011160   DEY
011170   LDA #',
011180   STA BUF,Y
011190   INY
011200   STY D2
011210 ; GET NEW FILE SPEC
011220    @PRNTLN  RENN,DEL
011230   JSR GETINP1
011250    @CPYMEM  INP1,BUF,0,D2
011260   JSR AREYOUSURE ;RETURNS ON Y
011310   JSR PRNTNL
011320    @PRNTLN  BUF
011330 ; EXECUTE COMMAND
011340    @DOCIO  DSKID1,ICM.RN,BUF,0
011350   JMP GETCOM
011360 ;
011370 COMWRT
011390   JSR AREYOUSURE ;RETURNS ON Y
011440    @CPYMEM  EDOS,INP1
011450   JSR PROCFILESPEC
011460   LDA # <START_PROG
011470   STA FILPOS
011480   LDA # >START_PROG
011490   STA FILPOS+1
011500   LDA # <END_PROG
011510   STA FILEND
011520   LDA # >END_PROG
011530   STA FILEND+1
011540   DEC FILEND
011550   LDA # <PRE_START
011560   STA RUNADR
011570   LDA # >PRE_START
011580   STA RUNADR+1
011590   JMP DOSAVE
011700 ;
011710 COMSAV
011730   JSR GETFILESPEC
011740 ; GET START - BUF
011745    @PRNTLN  FLST,DEL
011750    @INPRM  BUF
011755   JSR GETTEXT
011760   STY SAVLEN  ;START LEN
011765 ; GET END - INP1
011769    @PRNTLN  FLED,DEL
011773   JSR GETINP1
011781   STY SAVLEN+1 ;END LEN
011785   JSR INP2ADDR
011789   LDA FILPOS
011793   STA FILEND
011797   LDA FILPOS+1
011801   STA FILEND+1
011805 ; GET RUN - INP1
011809    @PRNTLN  FLRN,DEL
011813    @INPRM  INP1,7
011817   JSR GETTEXT
011821   JSR INP2ADDR
011825   LDA FILPOS
011829   STA RUNADR
011833   LDA FILPOS+1
011837   STA RUNADR+1
011841 ; START/END NEED 2-4 HEX
011845   LDA SAVLEN
011849   CMP #$02
011853   BCC COMSAV_1
011857   LDA SAVLEN+1
011861   CMP #$02
011865   BCC COMSAV_1
011869 ; CNVRT STRT TO ADDR
011873    @CPYMEM  BUF,INP1
011877   LDY SAVLEN
011881   JSR INP2ADDR
011900 ; END >= START?
011905   LDA FILEND
011910   CMP FILPOS
011915   LDA FILEND+1
011920   SBC FILPOS+1
011925   BCS DOSAVE
011930 COMSAV_1
011935    @PRNTLN  BADR
011940   JMP GETCOM
011950 DOSAVE
011960 ; SAVE HEADER
011970   LDA #$FF
011980   STA BUF
011990   STA BUF+1
012000   LDA FILPOS
012010   STA BUF+2
012020   LDA FILPOS+1
012030   STA BUF+3
012040   LDA FILEND
012050   STA BUF+4
012060   LDA FILEND+1
012070   STA BUF+5
012080    @DOCIO  DSKID1,ICM.OP,FILE,ICAX.WT
012090   LDA #$06
012100   STA D0
012110    @DOCIO  DSKID1,ICM.PB,BUF,ICAX.WT,D0
012120 ;SAVE BIN DATA, CALC LEN
012130   JSR CALCLEN
012140 ; SAVE
012150    @DOCIO  DSKID1,ICM.PB,FILPOS,ICAX.WT,FILLEN,FILLEN+1,1
012160 ; WRITE RUNAD IF GIVEN
012170   LDA RUNADR
012180   ORA RUNADR+1
012190   BEQ DOSAVE_1 ;NO RUN ADDR
012200   LDA #$E0
012210   STA BUF
012220   LDA #$02
012230   STA BUF+1
012240   LDA #$E1
012250   STA BUF+2
012260   LDA #$02
012270   STA BUF+3
012280   LDA RUNADR
012290   STA BUF+4
012300   LDA RUNADR+1
012310   STA BUF+5
012370   LDA #$06
012380   STA D0
012390    @DOCIO  DSKID1,ICM.PB,BUF,ICAX.WT,D0
012400 DOSAVE_1
012410   JMP GETCOM
012430 ;
012440 COMGOT
012460    @PRNTLN  GOTA,DEL
012470   JSR GETADDR
012500   JSR PRPEXT
012510   JMP (FILPOS) ;GOTO ADDR
012520 ;
012530 AREYOUSURE
012540    @COLRED
012550    @PRNTLN  ARYS,DEL
012560   JMP YESORMENU
012580 ;
012590 READIR
012600   LDA #0
012610   STA COUNT   ;ZERO COUNTER
012620   STA FILPOS  ;1ST FILE
012630 ;READ LOOP
012640 READLOOP
012650   LDA #$12
012660   STA D0
012670    @DOCIO  DSKID1,ICM.GB,FILE,ICAX.DR,D0
012680   INC COUNT
012690   BMI FINALIZE ;HANDLE END DIR
012700 ; FREE SECTORS OR FILE?
012710   LDA FILE+1  ;FREE SECTORS?
012720   CMP #$20    ;SPACE MEANS NO
012730   BEQ NRMLFILE ;FILE ENTRY
012740 ;FREE SECTORS
012750 FREESEC
012760   DEC COUNT   ;REMOVE FREE SEC
012770 ; IF POS 0, BUF PRINTED, RD FILE
012780   LDA FILPOS
012800   BEQ PRNTFREESEC ;DONT PRINT
012810   LDA #EOL
012820   STA BUF+$12
012830    @PRNTLN  BUF
012840 ;DISPLAY FREE SECTORS
012850 PRNTFREESEC
012860    @PRNTLN  FILE
012870   RTS
012880 ;USE 2 COLUMNS
012890 NRMLFILE
012900    @CPYMEM  FILE,BUF,0,FILPOS
012910   LDA FILPOS  ;0 MEANS FILE 1
012920   BEQ ADD2ND
012930   LDA #0      ;RESET LINE
012940   STA FILPOS
012950    @PRNTLN  BUF
012960   JMP READLOOP ;NEXT FILE
012970 ADD2ND
012980   LDA #$20    ;ADD SPACE
012990   STA BUF+$11 ;BETWEEN CLMNS
013000   LDA #$12    ;2ND TXT POS
013010   STA FILPOS
013020   BNE READLOOP ;ADD 2ND FILE
013050 FINALIZE
013060   CPY #ICSTAT.EOF
013070   BEQ FREESEC
013080   JMP DISKERR
