9780     LDA SNGL,X  ;$12 BYTES FROM ITS BLOCK
9790     STA BUF,Y
9800     INX
9810     INY
9820     CPY #$12
9830     BNE SETDRVSTAT_1
9840      @DOSIO  SIO.WP,SIOST.WT,BUF,$07,$0B,$00
9850 SETDRVSTAT_2
9860     RTS
9940 ;
9950 ;A 2-ENH, BUF-RSLT
9960 FRMTDRV
9970     CMP #$02
9980     BNE FRMTDRV_1
9990      @DOSIO  SIO.FH,SIOST.RD,BUF,$E0,$80,$00
010000   RTS
