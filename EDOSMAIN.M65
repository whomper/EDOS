010610 ;
010620 WRTVTOC
010630 ; VTOC
010640    @CPYMEM  VTOC,BUF
010650    @FILLMEM  BUF+11,$58,$FF
010660   LDA #$00
010670   STA BUF+55
010680   LDA #$7F
010690   STA BUF+56
010700    @FILLMEM  BUF+$64,$1C,$00
010710   LDA #$68
010720   LDY #$01
010730   JSR WRTSCT
010740 ; VTOC II
010750    @FILLMEM  BUF,$80,$FF
010760   LDA #$00
010770   STA BUF+39
010780   LDA #$7F
010790   STA BUF+40
010800   STA BUF+84
010810   LDA #$2F
010820   STA BUF+122
010830   LDA #$01
010840   STA BUF+123
010850   LDA #$00
010860   STA BUF+124
010870   STA BUF+125
010880   STA BUF+126
010890   STA BUF+127
