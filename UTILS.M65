10 ;UTILS.M65, V. 2.9 | UTILITIES | DISPLAYS $80 BYTES OF A MEMORY
20 ;ADDRESS IN A FORMATTED VIEW | FILE-PRINTED LINE | BUF-BUFFER
30 DSPBIN
40        @SHWCHR
50       LDA BYTRD
60       CMP #$80
70       BEQ DSPBIN_0
80       LDA #$01    ;EOF REACHED
90       STA ABORT
0100 DSPBIN_0
0110     JSR DRWHDR
0120     LDX #$00
0130 ;CLEAR LINE
0140 DSPBIN_1
0150      @FILLMEM  FILE,$28,$20
0160     LDA #EOL
0170     STA FILE+$25
0180     LDY #$00
0190      @POINT2TXT  FILE
0200 ; LOCATION
0210     LDA FILPOS+1
0220     JSR BIN2HEX
0230     LDA D1
0240     STA (INDPTR),Y
0250     JSR INCPTR
0260     LDA D0
0270     STA (INDPTR),Y
0280     JSR INCPTR
0290     LDA FILPOS
0300     JSR BIN2HEX
0310     LDA D1
0320     STA (INDPTR),Y
0330     JSR INCPTR
0340     LDA D0
0350     STA (INDPTR),Y
0360     JSR INCPTR
0370     LDA #'-
0380     STA (INDPTR),Y
0390     JSR INCPTR
0400 DSPBIN_2
0410     LDA BUF,X
0420     JSR BIN2HEX
0430     CMP #EOL
0440     BNE DSPBIN_3
0450     LDA #$00    ;EOL->ZERO
0460 ;PRINT 8 BYTES
0470 DSPBIN_3
0480     STA FILE+$1D,Y ;CHAR
0490     LDA D1
0500     STA (INDPTR),Y
0510     JSR INCPTR
0520     LDA D0
0530     STA (INDPTR),Y
0540     JSR INCPTR
0550     LDA #$20
0560     STA (INDPTR),Y
0570     INX
0580     INC FILPOS  ;NEXT ADDRESS
0582     BNE DSPBIN_3_5
0584     INC FILPOS+1
0586 DSPBIN_3_5
0590     INY
0600     DEC BYTRD
0620     BEQ DSPBIN_4 ;MXD READ CHRS?
0630     CPY #$08    ;MAX CHR LINE
0640     BNE DSPBIN_2
0650 ;
0660      @PRNTLN  FILE
0670 ; NEW ROW?
0680     CPX #$80
0690     BEQ DSPBIN_5
0700     JMP DSPBIN_1
0710 DSPBIN_4
0720      @PRNTLN  FILE
0730 DSPBIN_5
0740      @HIDCHR
0750     RTS
0760 ;
0770 ;DRAW HEADER LINE USING FILPOS
0780 DRWHDR
0790      @FILLMEM  FILE,$28,$20
0800     LDX #$00
0810     LDY #$00
0830 DRWHDR_1
0840     TXA
0850     JSR BIN2HEX
0860     LDA D1
0870     STA FILE+5,Y
0880     INY
0890     LDA D0
0900     STA FILE+5,Y
0910     INX
0920     INY
0930     INY
0940     CPX #$08
0950     BNE DRWHDR_1
0960     LDA #EOL
0970     STA FILE+5,Y
0980      @PRNTLN  FILE
0990 ;
1000     LDA #CHL
1006     LDX #$05
1012     LDY #$17    ;FALL INTO DRAW
1020 ;
1030 ;DRAWS A LINE | A-CHAR, INP1-BUF | X-POS, Y-LEN | SPACES BEFORE X-POS
1035 DRAW
1040     PHA
1045     STX D0
1050     LDA #$20    ;BLANK 0..POS-1
1055     LDX #$00
1060 DRAW_0
1065     CPX D0
1070     BEQ DRAW_2
1075     STA INP1,X
1080     INX
1085     BNE DRAW_0
1090 DRAW_2
1095     TYA
1100     CLC
1105     ADC D0
1110     STA D0
1115     PLA
1120 DRAW_1
1130     STA INP1,X
1140     INX
1150     CPX D0
1160     BNE DRAW_1
1170     LDA #EOL
1180     STA INP1,X
1190      @PRNTLN  INP1
1200     RTS
1210 ;
1220 ;RESETS A 4 DIGITS | DECIMAL COUNTER
1230 RSTSCTCNT
1240     LDA #'1
1250     STA SCTR+3
1260     LDA #'0
1270     STA SCTR+2
1280     STA SCTR+1
1290     STA SCTR
1300     LDA #DEL
1310     STA SCTR+4
1320     RTS
1330 ;
1340 ;CONVERT # BANKS TO MEM IN K | A-# BANKS | MEMD-TEXT DECIMAL
1350 BNK2DEC
1360 ; # BANKS * 16 = K -> VALUE
1362     STA VALUE
1364     LDA #$00
1366     STA VALUE+1
1368     LDX #$04
1370 BNK2DEC_1
1372     ASL VALUE
1374     ROL VALUE+1
1376     DEX
1378     BNE BNK2DEC_1
1380 ; TO DECIMAL
1390      @PTR2STK  MEMD
1400      @WRD2STK  VALUE
1410     JSR BIN2DEC
1420     LDX MEMD
1430     LDA #'K
1440     STA MEMD+1,X
1450     LDA #$20
1460     STA MEMD+2,X
1470     LDA #DEL
1480     STA MEMD+3,X
1490     RTS
1500 ;
1510 ;INCREMENT SECTOR COUNTER BY 1
1520 INCSCTCNT
1530     LDX #$03    ;LAST DIGIT
1540 INCSCTCNT_1
1550     INC SCTR,X
1560     LDA SCTR,X
1570     CMP #$3A    ;PAST '9?
1580     BNE INCSCTCNT_2
1590     LDA #'0
1600     STA SCTR,X
1610     DEX         ;CARRY TO NEXT DIGIT
1620     BPL INCSCTCNT_1
1630 INCSCTCNT_2
1640     RTS
1740 ;
1750 ;DETECT INSERTED DISK DENSITY | A - 1-SNG,2-ENH,3-DBL
1760 DTCDNS
1770      @SIOSNDOFF
1780      @SETSCT  $10,$00
1790 ; READ SECTOR AND GET STAT
1800     LDA #SIO.RD
1810     STA DCOMND
1820     LDA DSKNUM
1830     STA DUNIT
1840     LDA #SIOST.RD
1850     STA DSTATS
1860     LDA # <BUF
1870     STA DBUFLO
1880     LDA # >BUF
1890     STA DBUFHI
1900     LDA #$07
1910     STA DTIMLO
1920     LDA #$80
1930     STA DBYTLO
1940     LDA #$00
1950     STA DBYTHI
1960     JSR SIOV
1970 ; @DOSIO SIO.RD,SIOST.RD,BUF,$07,$80,$00,SKPERR
1980 ; JSR DOSIO
1990 ; LDA DUNUSE
2000 ; CMP #SIOERR
2010 ; BEQ DTCDNS_3
2020 ;
2030     LDA #SIO.ST
2040     STA DCOMND
2050     JSR DSKINV
2060 ; X=3 DOUBLE, 2 ENHANCED, 1 SINGLE
2070     LDX #$03
2080     LDA DVSTAT
2090     AND #$20
2100     BNE DTCDNS_4
2110     DEX
2120     BIT DVSTAT  ;BIT 7: ENHANCED
2130     BMI DTCDNS_4
2140     DEX
2150 DTCDNS_4
2160      @SIOSNDON
2170     TXA
2180     RTS
2350 ;
2360 ;RESETS HS SIO MEM LOCATION
2370 RESETFIO
2380     LDA #$00
2390     STA FSIOV
2400     STA FSIOV+1
2410     RTS
2420 ;
2430 ;READ HS SIO CODE FROM DRIVE | AND PLACE IN FSIOV
2440 READFIO
2450     LDA FSIOV
2460     ORA FSIOV+1
2470     BNE READFIO_1
2480 ;
2490     LDA #$31
2500     STA DDEVIC
2510     LDA DSKNUM
2520     STA DUNIT
2530     LDA #SIO.SL
2540     STA DCOMND
2550     LDA #SIOST.RD
2560     STA DSTATS
2570     LDA #$08
2580     STA DBUFLO
2590     STA DTIMLO
2600     LDA #$03
2610     STA DBUFHI
2620     LDA #$02
2630     STA DBYTLO
2640     LDA #$00
2650     STA DBYTHI
2660     JSR SIOV
2670     BMI READFIO_1
2671 ; CODE MUST FIT ITS PAGE AT FSIOV
2672     LDA DBYTHI
2673     BEQ READFIO_0
2674     CMP #$01
2675     BNE READFIO_1
2676     LDA DBYTLO
2677     BNE READFIO_1
2678 READFIO_0
2680 ;
2690     INC DCOMND
2700     LDA # <FSIOV
2710     STA DBUFLO
2720     STA DAUX1
2730     LDA # >FSIOV
2740     STA DBUFHI
2750     STA DAUX2
2760     LDA #SIOST.RD
2770     STA DSTATS
2780     JSR SIOV
2790 READFIO_1
2800     RTS
2810 ;
2820 ;HIDECURSOR / SHOWCURSOR / SETCOLRED / CLOSECHANNEL
2830 ;SHARED SUBROUTINES FOR FORMERLY-INLINE MACROS
2840 HIDECURSOR
2850     LDA #$01
2860     STA CRSINH
2870     RTS
2880 ;
2890 SHOWCURSOR
2900     LDA #$00
2910     STA CRSINH
2920     RTS
2930 ;
2940 SETCOLRED
2950     LDA #$40
2960     STA COLOR4
2970     RTS
2980 ;
2990 ;CLOSECHANNEL - X = IOCB INDEX (SET BY CALLER)
3000 CLOSECHANNEL
3010     LDA #ICM.CL
3020     STA ICCOM,X
3030     JMP CIOV
3050 ;
3060 ;WRITE A SINGLE SECTOR | BUF - BUFFER | A - SCTR LO | Y - SCTR HI
3070 WRTSCT
3080     STA DAUX1
3090     STY DAUX2
3100      @DOSIO  SIO.WT,SIOST.WT,BUF,$07,$80,$00
3120     RTS
3130 ;
3220 ;INCREMENT 16BIT POINTER
3230 INCPTR
3240     INC INDPTR
3250     BNE INCPTR_1
3260     INC INDPTR+1
3270 INCPTR_1
3280     RTS
3290 ;
3300 ;EXECUTE AN SIO COMMAND | INLINE AFTER JSR (SEE @DOSIO): COMND,STAT,
3310 ;BUF,TIME,FLAG,SIZE - COPIED TO DCOMND-DBYTHI | DUNUSE - BITS 1,2
3320 DOSIO
3330      @GETRETADR
3340     LDA #$31
3350     STA DDEVIC
3360 ;INLINE PARAMS -> DCOMND..DBYTHI
3370     LDY #$08
3380 DOSIO_1
3390     LDA (RETADR),Y
3400     STA DCOMND-1,Y
3410     DEY
3420     BNE DOSIO_1
3430 ;RETURN PAST THEM
3440     CLC
3450     LDA RETADR
3460     ADC #$08
3470     STA RETADR
3480     BCC DOSIO_0
3490     INC RETADR+1
3500 DOSIO_0
3530 ;
3540     LDA DUNUSE
3550     AND #CNGDSK
3560     BNE DOSIO_2
3580     LDA DSKNUM
3590     STA DUNIT
3600 ;POINT TO VALID SECTOR?
3610 DOSIO_2
3620     LDA DAUX1   ;BOTH 0?
3630     ORA DAUX2
3640     BNE DOSIO_3
3650     INC DAUX1   ;DEF SCTR 1
3660 DOSIO_3
3670     JSR CALLSIO
3680 DOSIO_7
3690      @SETRETADR
3700     LDA DSTATS
3710 ;LDA #$00 | STA DUNUSE
3720     RTS
3730 ;
3740 ;THE ACTUAL SIO CALL ROUTINE
3750 CALLSIO
3760 ; FAST SIO ONLY ON READ/WRITE
3770     LDA DCOMND
3780     CMP #SIO.RD
3790     BEQ CALLSIO_1
3800     CMP #SIO.WT
3810     BNE CALLSIO_2
3820 ;READ/WRITE
3830 CALLSIO_1
3840 ; USE THE CORRECT SECTOR SIZE
3850     JSR FXSCSZ
3860 ; HAVE FAST SIO?
3870     LDA FSIOV
3880     ORA FSIOV+1
3890     BEQ CALLSIO_2 ;NOT FSIOV?
3900     JSR FSIOV
3910     JMP CALLSIO_6 ;N=ERROR
3920 ;OTHER
3930 CALLSIO_2
3940     JSR SIOV
3950 CALLSIO_6
3960     BPL CALLSIO_5
3990 ;ERROR FOR READ/WRITE ONLY
4000 CALLSIO_3
4010 ; $8B MAYBE OK (MyDos)
4020 ; CPY #$8B
4030 ; BEQ CALLSIO_5
4040     CPY #BREAK  ;BRK KEY
4050     BEQ CALLSIO_5
4060     LDA DCOMND
4070     CMP #SIO.HS
4080     BEQ CALLSIO_5
4090     CMP #SIO.ST
4100     BEQ CALLSIO_5
4110     CMP #SIO.WP
4120     BEQ CALLSIO_5
4130     LDA DUNUSE
4140     AND #SKPERR
4150     BNE CALLSIO_4
4170 ;
4180 ; PLP
4190     JMP DISKERR
4200 CALLSIO_4
4210     LDA #SIOERR
4220     STA DUNUSE
4230 CALLSIO_5
4240     RTS
4250 ;
4260 ;READ DAUX SECTOR NUMBER | FIX DBUFLO/HI FOR RIGHT SIZE
4270 ;USE SINGLE FOR SECTORS 1-3
4280 FXSCSZ
4290     LDA DAUX2
4300     BNE FXSCSZ_1
4310     LDA DAUX1
4320     CMP #$04
4330     BCC FXSCSZ_2
4340 FXSCSZ_1
4350     LDA DENSITY
4360     CMP #$03
4370     BEQ FXSCSZ_3
4380 ;SINGLE
4390 FXSCSZ_2
4400     LDA #$00
4410     STA DBYTHI
4420     LDA #$80
4430     BNE FXSCSZ_4 ;ALWAYS
4440 ;DOUBLE
4450 FXSCSZ_3
4460     LDA #$01
4470     STA DBYTHI
4480     LDA #$00
4490 FXSCSZ_4
4500     STA DBYTLO
4510     RTS
4520 ;
4530 ;CONVERT TEXT INPUT TO BINARY | Y-LEN, INP1-IN
4540 INP2ADDR
4550     LDA #$00
4560     STA FILPOS
4570     STA FILPOS+1
4580     CPY #$02    ;AT LEAST 2 CHRS
4590     BCC INP2ADDR_2
4600     CPY #$04    ;NOW 4 CHRS
4610     BCC INP2ADDR_1
4620     LDA INP1
4630     LDY INP1+1
4640     JSR HEX2BIN
4650     STA FILPOS+1
4660     LDA INP1+2
4670     LDY INP1+3
4680     JSR HEX2BIN
4690     STA FILPOS
4700     RTS
4710 INP2ADDR_1
4720     LDA INP1
4730     LDY INP1+1
4740     JSR HEX2BIN
4750     STA FILPOS
4760     RTS
4770 INP2ADDR_2
4780     RTS
4790 ;
4800 ;2 CHR ATASCII HEX TO HEX NUM | "A0"->A0 | A - STR LO BYTE
4810 ;Y - STR HI BYTE
4820 HEX2BIN
4830     PHA
4840     TYA
4850     JSR A2HEX
4860     STA TMP
4870     PLA
4880     JSR A2HEX
4890     ASL A
4900     ASL A
4910     ASL A
4920     ASL A
4930     ORA TMP
4940     RTS
4950 ;
4960 ;CONVERT ASCII TO HEX NIBBLE | HELPER TO HEX2BIN
4970 A2HEX
4980     SEC
4990     SBC #'0
5000     CMP #10
5010     BCC A2HEX1
5020     SBC #7
5030 A2HEX1
5040     RTS
5050 ;
5060 ;EXECUTE A CIO COMMAND | INLINE AFTER JSR (SEE @DOCIO):
5062 ;.BYTE IOCB+FLAGS,CMD | .WORD BUF | .BYTE ICAX1 | [.WORD LEN ADDR]
5064 ;FLAGS: 1-LEN AT LEN ADDR | 2-LEN IS A WORD | 4-BUF HOLDS A POINTER
5066 DOCIO
5068      @GETRETADR
5070     STX TMP     ;CACHE X
5072     LDY #$01
5074     LDA (RETADR),Y
5076     STA DOCFLG
5078     AND #$F0
5080     TAX
5082     INY
5084     LDA (RETADR),Y
5086     STA ICCOM,X
5088     INY
5090     LDA (RETADR),Y
5092     STA ICBAL,X
5094     STA CIOPTR
5096     INY
5098     LDA (RETADR),Y
5100     STA ICBAH,X
5102     STA CIOPTR+1
5104     INY
5106     LDA (RETADR),Y
5108     STA ICAX1,X
5110     LDA #$00
5112     STA ICAX2,X
5114     STA ICBLL,X
5116     STA ICBLH,X
5118 ;BUF HOLDS A POINTER?
5120     LDA DOCFLG
5122     AND #$04
5124     BEQ DOCIO_2
5126     LDY #$00
5128     LDA (CIOPTR),Y
5130     STA ICBAL,X
5132     INY
5134     LDA (CIOPTR),Y
5136     STA ICBAH,X
5138 DOCIO_2
5140 ;LENGTH GIVEN?
5142     LDA DOCFLG
5144     LSR A
5146     BCC DOCIO_4
5148     LDY #$06
5150     LDA (RETADR),Y
5152     STA CIOPTR
5154     INY
5156     LDA (RETADR),Y
5158     STA CIOPTR+1
5160     LDY #$00
5162     LDA (CIOPTR),Y
5164     STA ICBLL,X
5166     LDA DOCFLG
5168     AND #$02
5170     BEQ DOCIO_4
5172     INY
5174     LDA (CIOPTR),Y
5176     STA ICBLH,X
5178 ;RETURN PAST 5 OR 7 INLINE BYTES
5180 DOCIO_4
5182     LDA DOCFLG
5184     AND #$01
5186     ASL A
5188     ADC #$05
5190     ADC RETADR
5192     STA RETADR
5194     BCC DOCIO_5
5196     INC RETADR+1
5198 DOCIO_5
5260     JSR CIOV
5270     BPL DOCIO_1
5280     CPY #ICSTAT.EOF ;EOF IS NOT AN ERROR
5290     BNE DISKERR
5300 DOCIO_1
5310     LDX TMP
5320      @SETRETADR
5330     RTS
5370 ;GENERIC ERROR HANDLER
5380 DISKERR
5390     STY VALUE
5400     JSR GETERRTXT
5410     LDA #$00
5420     STA VALUE+1
5430      @PTR2STK  INP1
5440      @WRD2STK  VALUE
5450     JSR BIN2DEC
5460      @CPYMEM  EMSG,BUF
5470     LDA #$00
5480     STA D0
5490      @CPYMEM  INP1+1,BUF+8,0,D0,INP1
5500      @CPYMEM  FILE,BUF+12
5510     JSR PRNTNL
5520      @PRNTLN  BUF
5530     JSR PRNTNL
5540 ;GET BACK
5550 DISKERR_1
5560     PLA
5570     PLA
5580     JMP (RTNPTR) ;GO BACK
5590 ;
5600 ;RETURN CIO ERROR TEXT | Y-CODE,FILE-TEXT (EMPTY IF UNKNOWN)
5608 ;CIO_MSG: CODE, TEXT, EOL, ... , $FF
5616 GETERRTXT
5624     STY TMP
5632     LDA # <CIO_MSG
5640     STA INDPTR
5648     LDA # >CIO_MSG
5656     STA INDPTR+1
5664 GETERRTXT_1
5672     LDY #$00
5680     LDA (INDPTR),Y
5688     CMP #$FF    ;END OF LIST?
5696     BEQ GETERRTXT_4
5704     CMP TMP
5712     BEQ GETERRTXT_2
5720 ;SKIP THIS MESSAGE
5728 GETERRTXT_5
5736     INY
5744     LDA (INDPTR),Y
5752     CMP #EOL
5760     BNE GETERRTXT_5
5768     INY
5776     TYA
5784     CLC
5792     ADC INDPTR
5800     STA INDPTR
5808     BCC GETERRTXT_1
5816     INC INDPTR+1
5824     BCS GETERRTXT_1
5832 ;COPY TEXT AFTER THE CODE
5840 GETERRTXT_2
5848     INY
5856     LDA (INDPTR),Y
5864     STA FILE-1,Y
5872     CMP #EOL
5880     BNE GETERRTXT_2
5888     RTS
5896 GETERRTXT_4
5904     LDA #EOL
5912     STA FILE
5920     RTS
5940 ;
5950 ;GET A SINGLE CHAR FROM USER
5960 GETCHR
5970      @MKCAPS
5980     LDX #KBDID
5990     LDA #ICM.GB
6000     STA ICCOM,X
6010     LDA #0
6020     STA ICBLL,X
6030     STA ICBLH,X
6040     JSR CIOV
6050     BMI GETCHRERR
6060 ;
6070     CMP #$1B    ;ESCAPE KEY
6080     BEQ GETCHRERR
6090 ; RELAY TO SCREEN
6100     STA MOD10
6110     LDA #DEL
6120     STA MOD10+1
6130      @PRNTLN  MOD10,DEL
6140 ;
6150     LDA MOD10   ;RECALL CHAR
6160     RTS
6170 GETCHRERR
6180     JSR PRNTNL
6190     JMP DISKERR_1
6200 ;
6380 ;GET A TEXT INPUT FROM USER | Y-RETURN # CHARACTERS | A-LO BYTE INPUT
6390 ;Y-HI BYTE INPUT
6400 GETTEXT
6410     LDX #SCRID
6420     STA ICBAL,X
6430     LDA #ICM.GT
6440     STA ICCOM,X
6450     TYA
6460     STA ICBAH,X
6470     LDA TXTLEN  ;MAX LEN, LONGER->137
6480     STA ICBLL,X
6490     LDA #0
6500     STA ICAX2,X
6510     JSR CIOV
6520     BMI GETTEXTERR
6530     DEC ICBLL,X ;REMOVE EOL
6540     LDY ICBLL,X ;# CHARS READ
6550     RTS
6560 GETTEXTERR
6570     CPY #BREAK
6580     BEQ HANDLEBREAK
6590     JMP DISKERR ;NO, IO ERROR
6600 HANDLEBREAK
6610     JMP DISKERR_1
6620 ;
6630 ;PRINT TEXT LINE ON SCREEN | INLINE AFTER JSR: .WORD BUF, .BYTE DELIM
6635 ;DELIM $80-$FF: PRINT UP TO IT | $00-$7F: PRINT THAT MANY CHARS
6640 PRNTLN
6645      @GETRETADR
6650     STX D0
6655     STY D1
6660 ;INLINE PARAMS
6665     LDY #$01
6670     LDA (RETADR),Y
6675     STA INDPTR
6680     INY
6685     LDA (RETADR),Y
6690     STA INDPTR+1
6695     INY
6700     LDA (RETADR),Y
6705     STA TMP
6710 ;RETURN PAST THEM
6715     CLC
6720     LDA RETADR
6725     ADC #$03
6730     STA RETADR
6735     BCC PRNTLN_0
6740     INC RETADR+1
6745 PRNTLN_0
6760 ; PRINT TEXT
6770     LDX #SCRID
6780     LDA #ICM.PB
6790     STA ICCOM,X
6800     LDA INDPTR
6810     STA ICBAL,X
6820     LDA INDPTR+1
6830     STA ICBAH,X
6840     LDA TMP
6850     STA ICBLL,X
6860     LDA #$00
6870     STA ICBLH,X
6880 ; FIND DELIM?
6890     LDA TMP
6900     BPL PRNTLN_3
6910     LDY #$00
6920 PRNTLN_1
6930     LDA (INDPTR),Y
6940     INY
6950     CMP TMP
6960     BNE PRNTLN_1
6970 ;
6980     LDA TMP
6990     CMP #EOL
7000     BEQ PRNTLN_2
7010     DEY         ;REMOVE DEL
7020 ;UPDATE # CHARS TO PRINT
7030 PRNTLN_2
7040     TYA
7050     STA ICBLL,X
7060 PRNTLN_3
7070     JSR CIOV
7080 ; RESTORE
7090     LDX D0
7100     LDY D1
7110      @SETRETADR
7120     RTS
7130 ;
7140 ;PRINT A NEW LINE ON SCREEN
7150 PRNTNL
7160     LDA #EOL
7170     STA D2
7180      @PRNTLN  D2,1
7190     RTS
7200 ;
7210 ;HEX 2 DECIMAL ASCII | FF->"255"
7220 BIN2DEC
7230      @GETRETADR
7240     PLA
7250     STA FR0
7260     PLA
7270     STA FR1
7280     PLA
7290     STA INDPTR
7300     PLA
7310     STA INDPTR+1
7320     JSR IFP
7330     JSR FASC
7340     LDY #$00
7350     LDX #$FF
7360 ; DISREGARD FIRST 0
7370     LDA LBUFF
7380     CMP #'0
7390     BNE BIN2HEX_1
7400     INX
7410 BIN2HEX_1
7420     INX
7430     INY
7440     LDA LBUFF,X
7450     STA (INDPTR),Y
7460     BPL BIN2HEX_1
7470     AND #$7F
7480     STA (INDPTR),Y
7490     INY
7500     LDA #EOL
7510     STA (INDPTR),Y
7520 ;# CHARS
7530     DEY
7540     TYA
7550     LDY #$00
7560     STA (INDPTR),Y
7570 ;
7580      @SETRETADR
7590     RTS
7600 ;
7610 ;NUM TO HEX REP | A0->"A0" | A - BYTE TO CNVRT
7620 BIN2HEX
7630 ; CACHE
7640     STA TMP
7650     PHA
7660     TXA
7670     PHA
7680     TYA
7690     PHA
7700     LDA TMP
7710 ;HI NIBBLE
7720     TAX
7730     AND #$F0
7740     LSR A
7750     LSR A
7760     LSR A
7770     LSR A
7780     JSR NASCII
7790     STA D1
7800 ;LO NIBBLE
7810     TXA
7820     AND #$0F
7830     JSR NASCII
7840     STA D0
7850 ;RECALL
7860     PLA
7870     TAY
7880     PLA
7890     TAX
7900     PLA
7910     RTS
7920 ;
7930 NASCII
7940     CMP #$0A
7950     BCC NAS1
7960     CLC
7970     ADC #$07
7980 NAS1
7990     ADC #'0
8000     RTS
8010 ;
8020 ;DETECT # EXTENDED RAM BANKS | A-# MEM PAGES
8030 DTXMEM
8040     LDA PORTB
8050     PHA
8060     LDA #$00
8070     STA NUMBKS
8080 ; SAVE RAMDISK
8090     LDX #$7F
8100 DTXMEM_1
8110     TXA
8120     ASL A
8130     ORA #$01
8140     STA PORTB
8150     LDA M4000
8160     STA BUF,X
8170     DEX
8180     BPL DTXMEM_1
8190 ; CLR RAM TO TEST
8200     LDX #$7F
8210 DTXMEM_2
8220     TXA
8230     ASL A
8240     ORA #$01
8250     STA PORTB
8260     LDA #$00
8270     STA M4000
8280     DEX
8290     BPL DTXMEM_2
8300     LDA #$FF    ;RST POTB
8310     STA PORTB
8320     LDA #'K
8330     STA M4000
8340 ; COUNT BANKS
8350     LDX #$7F
8360 DTXMEM_3
8370     TXA
8380     ASL A
8390     ORA #$01
8400     STA PORTB
8410     LDA M4000
8420     BNE SKIP
8430     INC NUMBKS
8440     LDA #'K
8450     STA M4000
8460 SKIP DEX
8470     BPL DTXMEM_3
8480 ; RESTORE RAMDISK
8490     LDX #$7F
8500 DTXMEM_4
8510     TXA
8520     ASL A
8530     ORA #$01
8540     STA PORTB
8550     LDA BUF,X
8560     STA M4000
8570     DEX
8580     BPL DTXMEM_4
8590     PLA
8600     STA PORTB
8610     LDA NUMBKS
8620     RTS
8630 ;
8640 ;4 DIGITS DEC TO HEX CONVERT | A-LO BYTE | Y-HI BYTE
8650 DEC2HEX
8660     STA INBUFF
8670     STY INBUFF+1
8680     LDA #$01
8690     STA CIX
8700     JSR AFP
8710     JSR FPI
8720     LDA FR0
8730     STA VALUE
8740     LDA FR1
8750     STA VALUE+1
8760     RTS
8770 ;
8780 ; VARIABLES
8790 ;
8800 ; (D0,D1,D2,FILPOS,TMP,VALUE,DSKNUM,BYTRD,DENSITY,
8810 ; SCTR,NUMBKS,RTNPTR,RETADR,MOD10 NOW IN ZERO PAGE -
8820 ; SEE SYSTEM.M65)
8830 NUM2CNV *= *+1
8835 STKPTR *= *+1   ;SP AT START (<$4000)
8840 ABORT *= *+1    ;ABRT ACTV COM
8850 MEMD *= *+7     ;MEM
8860 EMSG .BYTE "* Error -",EOL
8870 ;WORK AREA $3D40-$3FFF: BELOW THE $4000 BANK WINDOW, ALWAYS MAPPED
8875 ;EDOS MUST END BELOW WRKBEG - CHECKED AT THE END OF EDOS.M65
8880 FSIOV = $3F00   ;FAST SIO CODE, 1 PAGE
8885 BUF =   $3E00   ;$100
8890 INP1 =  $3D80   ;INPUT/HELPER $80
8895 FILE =  $3D40   ;FILE BUF $40
8900 WRKBEG = FILE   ;LOWEST WORK AREA ADDR
8905 DOSIN *= *+2    ;DOSINI CACHE
8910 TXTLEN .BYTE MAXBUF ;GETTEXT MAX LEN
8920 BANKS .BYTE $FD
8930     .BYTE $A3,$A7,$AB,$AF
8940     .BYTE $E3,$E7,$EB,$EF
8950     .BYTE $83,$87,$8B,$8F
8960     .BYTE $C3,$C7,$CB,$CF
8970 ;
8980 ;LOAD D:EDOS.FNT (1K) BELOW THE SCREEN | SETS FONTPG IF LOADED
8990 ;NO ERROR MESSAGES: NO FILE OR NO ROOM KEEPS THE ROM FONT
9000 LDFONT
9010     LDA RAMTOP
9020     SEC
9030     SBC #$08    ;1K PAGE BELOW SCREEN
9040     AND #$FC
9050     CMP #$80    ;NOT IN $4000-$7FFF
9060     BCC LDFONT_1
9070     STA TMP
9080     LDX #DSKID1
9090     LDA #ICM.OP
9100     STA ICCOM,X
9110     LDA # <FNTNAM
9120     STA ICBAL,X
9130     LDA # >FNTNAM
9140     STA ICBAH,X
9150     LDA #ICAX.RD
9160     STA ICAX1,X
9170     LDA #$00
9180     STA ICAX2,X
9190     JSR CIOV
9200     BMI LDFONT_2
9210     LDA #ICM.GB
9220     STA ICCOM,X
9230     LDA #$00
9240     STA ICBAL,X
9250     STA ICBLL,X
9260     LDA TMP
9270     STA ICBAH,X
9280     LDA #$04    ;$400 BYTES
9290     STA ICBLH,X
9300     JSR CIOV
9310     BMI LDFONT_2
9320     LDA TMP
9330     STA FONTPG
9340 LDFONT_2
9350     JMP CLOSECHANNEL
9360 LDFONT_1
9370     RTS
9380 FONTPG .BYTE 0  ;CUSTOM FONT PAGE, 0=ROM
9390 FNTNAM .BYTE "D:EDOS.FNT",EOL
