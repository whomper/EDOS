;
; UTILS.M65 - EDOS 3.2
; Screen, input, SIO and CIO routines
; Copyright (C) 2026 AERA | Erez Yaary
;
; DSPBIN - show BYTRD bytes of BUF (up
; to $80), 8 a row with the address
; (FILPOS), under DRWHDR's header
; Exit: FILPOS past them; ABORT = 1 if
; BYTRD was under $80 (end of file);
; A, X, Y, D0-D2, BYTRD, FILE changed
;
DSPBIN
         @SHWCHR
         LDA BYTRD
         BMI DSPBIN_0       ;$80: a full block
         LDA #$01           ;fewer: end of file
         STA ABORT
DSPBIN_0
         JSR DRWHDR
         LDX #$00
DSPBIN_1
         @FILLMEM FILE,$28,$20
         LDA #EOL
         STA FILE+$25
         LDY #$00
         STY D2             ;character column
         LDA FILPOS+1
         JSR HEXOUT
         LDA FILPOS
         JSR HEXOUT
         LDA #'-
         STA FILE,Y
; a byte: hex at FILE+5+3*N, the
; character at FILE+$1D+N
DSPBIN_2
         INY
         LDA BUF,X
         JSR HEXOUT
         STY D1
         LDY D2
         LDA BUF,X
         CMP #EOL
         BNE DSPBIN_3
         LDA #$00           ;EOL would end the row
DSPBIN_3
         STA FILE+$1D,Y
         INY
         STY D2
         LDY D1
         INX
         INC FILPOS
         BNE DSPBIN_3_5
         INC FILPOS+1
DSPBIN_3_5
         DEC BYTRD
         BEQ DSPBIN_4       ;all shown
         TXA
         AND #$07           ;row full?
         BNE DSPBIN_2
         @PRNTLN FILE
         CPX #$80
         BNE DSPBIN_1
         BEQ DSPBIN_5
DSPBIN_4
         @PRNTLN FILE
DSPBIN_5
         @HIDCHR
         RTS
;
; DRWHDR - print the column header, 00
; to 07 over the hex columns, and a
; line under it (into DRAW)
; Exit: as DRAW; FILE changed
;
DRWHDR
         @FILLMEM FILE,$28,$20
         LDX #$00
         LDY #$05
DRWHDR_1
         TXA
         JSR HEXOUT
         INY
         INX
         CPX #$08
         BNE DRWHDR_1
         LDA #EOL
         STA FILE,Y
         @PRNTLN FILE
         LDA #CHL
         LDX #$05
         LDY #$17           ;into DRAW
;
; DRAW - print a line in INP1: X
; spaces, then Y (1 or more) times the
; character in A (@DRAW)
; Exit: Y kept; A, X, D0 changed
;
DRAW
         PHA
         STX D0
         LDA #$20           ;spaces 0..X-1
         LDX #$00
DRAW_0
         CPX D0
         BEQ DRAW_2
         STA INP1,X
         INX
         BNE DRAW_0
DRAW_2
         TYA
         CLC
         ADC D0
         STA D0
         PLA
DRAW_1
         STA INP1,X
         INX
         CPX D0
         BNE DRAW_1
         LDA #EOL
         STA INP1,X
         @PRNTLN INP1
         RTS
;
; RSTSCTCNT - set the sector counter
; SCTR to "0001" and a DEL
; Exit: A = DEL
;
RSTSCTCNT
         LDA #'1
         STA SCTR+3
         LDA #'0
         STA SCTR+2
         STA SCTR+1
         STA SCTR
         LDA #DEL
         STA SCTR+4
         RTS
;
; BNK2DEC - memory in K as text at
; MEMD: the count, digits, "K ", DEL.
; A: number of 16K banks. MEMD has
; room for 3 digits (under 63 banks)
; Exit: VALUE = K; A, X, Y changed
;
BNK2DEC
         STA VALUE
         LDA #$00
         STA VALUE+1
         LDX #$04           ;banks * 16
BNK2DEC_1
         ASL VALUE
         ROL VALUE+1
         DEX
         BNE BNK2DEC_1
         LDA # <MEMD
         LDY # >MEMD
         JSR BIN2DEC
         LDX MEMD
         LDA #'K            ;over the EOL
         STA MEMD+1,X
         LDA #$20
         STA MEMD+2,X
         LDA #DEL
         STA MEMD+3,X
         RTS
;
; INCSCTCNT - add 1 to the 4 decimal
; digits at SCTR ("9999" -> "0000")
; Exit: A, X changed
;
INCSCTCNT
         LDX #$03
INCSCTCNT_1
         INC SCTR,X
         LDA SCTR,X
         CMP #$3A           ;past '9?
         BNE INCSCTCNT_2
         LDA #'0
         STA SCTR,X
         DEX
         BPL INCSCTCNT_1
INCSCTCNT_2
         RTS
;
; DTCDNS - the density of the disk in
; drive DSKNUM: read sector $10 (the
; result is not checked), then the
; drive's status. SIO beeps off
; Exit: A = X = 1 single, 2 enhanced,
; 3 double; BUF changed; beeps on
;
DTCDNS
         @SIOSNDOFF
         @SETSCT $10,$00
         LDA #SIO.RD
         STA DCOMND
         LDA DSKNUM
         STA DUNIT
         LDA #SIOST.RD
         STA DSTATS
         LDA # <BUF
         STA DBUFLO
         LDA # >BUF
         STA DBUFHI
         LDA #$07
         STA DTIMLO
         LDA #$80
         STA DBYTLO
         LDA #$00
         STA DBYTHI
         JSR SIOV
         LDA #SIO.ST
         STA DCOMND
         JSR DSKINV         ;status to DVSTAT
         LDX #$03
         LDA DVSTAT
         AND #$20           ;bit 5: double
         BNE DTCDNS_4
         DEX
         BIT DVSTAT         ;bit 7: enhanced
         BMI DTCDNS_4
         DEX
DTCDNS_4
         @SIOSNDON
         TXA
         RTS
;
; RESETFIO - forget the fast SIO code:
; zero its first 2 bytes at FSIOV
; Exit: A = 0
;
RESETFIO
         LDA #$00
         STA FSIOV
         STA FSIOV+1
         RTS
;
; READFIO - unless it is there, load
; drive DSKNUM's fast SIO code into
; FSIOV: command $68 gives its length,
; $69 the code, made to run at DAUX
; Exit: A, Y changed; none loaded on
; an error or if over FSIOMAX
;
READFIO
         LDA FSIOV
         ORA FSIOV+1
         BNE READFIO_1
         LDA #$31
         STA DDEVIC
         LDA DSKNUM
         STA DUNIT
         LDA #SIO.SL
         STA DCOMND
         LDA #SIOST.RD
         STA DSTATS
         LDA #$08           ;to DBYTLO/HI ($0308)
         STA DBUFLO
         STA DTIMLO
         LDA #$03
         STA DBUFHI
         LDA #$02
         STA DBYTLO
         LDA #$00
         STA DBYTHI
         JSR SIOV
         BMI READFIO_1
; it must fit FSIOV..FILE-1 (FSIOMAX)
         LDA # <FSIOMAX
         CMP DBYTLO
         LDA # >FSIOMAX
         SBC DBYTHI         ;C=0: too long
         BCC READFIO_1
         INC DCOMND         ;$69: the code
         LDA # <FSIOV
         STA DBUFLO
         STA DAUX1          ;where it runs
         LDA # >FSIOV
         STA DBUFHI
         STA DAUX2
         LDA #SIOST.RD
         STA DSTATS
         JSR SIOV
READFIO_1
         RTS
;
; HIDECURSOR - cursor off (@HIDCUR)
; Exit: A = 1
;
HIDECURSOR
         LDA #$01
         STA CRSINH
         RTS
;
; SHOWCURSOR - cursor on (@SHWCUR)
; Exit: A = 0
;
SHOWCURSOR
         LDA #$00
         STA CRSINH
         RTS
;
; SETCOLRED - border red (@COLRED)
; Exit: A = $40
;
SETCOLRED
         LDA #$40
         STA COLOR4
         RTS
;
; CLOSECHANNEL - close IOCB X (IOCB
; * 16), for @CLOSEIO
; Exit: Y = CIO status, N=1 on error
;
CLOSECHANNEL
         LDA #AXCLOSE
         STA ICCOM,X
         JMP CIOV
;
; WRTSCT - write BUF to sector A/Y
; (lo/hi), with verify; size: FXSCSZ
; Exit: A = DSTATS; errors to DISKERR
;
WRTSCT
         STA DAUX1
         STY DAUX2
         @DOSIO SIO.WT,SIOST.WT,BUF,$07,$80,$00
         RTS
;
; INLINE - called first (before any
; push) by a routine with Y bytes
; after its JSR: RETADR -> the byte
; before them, (RETADR),Y=1.. reads
; them; its RTS returns past them
; Exit: Y kept; A, X, C changed
;
INLINE
         TSX
         LDA $0103,X        ;the routine's return
         STA RETADR
         LDA $0104,X
         STA RETADR+1
         TYA
         CLC
         ADC $0103,X
         STA $0103,X
         BCC INLINE_1
         INC $0104,X
INLINE_1
         RTS
;
; DOSIO - an SIO operation (@DOSIO):
; 8 bytes after the JSR to DCOMND..
; DBYTHI: command, DSTATS, buffer,
; time, flags (DUNUSE), size. Flags:
; CNGDSK - keep DUNIT, else DSKNUM;
; SKPERR - see CALLSIO. DAUX: the
; sector (0 is taken as 1)
; Exit: A = DSTATS, Y = status
;
DOSIO
         LDY #$08
         JSR INLINE
         LDA #$31
         STA DDEVIC
DOSIO_1
         LDA (RETADR),Y
         STA DCOMND-1,Y
         DEY
         BNE DOSIO_1
         LDA DUNUSE
         AND #CNGDSK
         BNE DOSIO_2
         LDA DSKNUM
         STA DUNIT
DOSIO_2
         LDA DAUX1
         ORA DAUX2
         BNE DOSIO_3
         INC DAUX1
DOSIO_3
         JSR CALLSIO
         LDA DSTATS
         RTS
;
; CALLSIO - call SIO with the DCB set.
; Read and write: size from FXSCSZ,
; the fast SIO code if loaded. Errors
; (not Break, SIO.HS, ST, WP) go to
; DISKERR, or return with SKPERR
; Exit: Y = status; DUNUSE = SIOERR
; for an error with SKPERR
;
CALLSIO
         LDA DCOMND
         CMP #SIO.RD
         BEQ CALLSIO_1
         CMP #SIO.WT
         BNE CALLSIO_2
CALLSIO_1
         JSR FXSCSZ
         LDA FSIOV
         ORA FSIOV+1
         BEQ CALLSIO_2
         JSR FSIOV
         JMP CALLSIO_6      ;N=1: an error
CALLSIO_2
         JSR SIOV
CALLSIO_6
         BPL CALLSIO_5
CALLSIO_3
         CPY #BREAK
         BEQ CALLSIO_5
         LDA DCOMND
         CMP #SIO.HS
         BEQ CALLSIO_5
         CMP #SIO.ST
         BEQ CALLSIO_5
         CMP #SIO.WP
         BEQ CALLSIO_5
         LDA DUNUSE
         AND #SKPERR
         BNE CALLSIO_4
         JMP DISKERR
CALLSIO_4
         LDA #SIOERR
         STA DUNUSE
CALLSIO_5
         RTS
;
; FXSCSZ - DBYTLO/HI = the size of
; sector DAUX: 256 if DENSITY is 3
; (double) and the sector 4 or more,
; else 128
; Exit: A changed
;
FXSCSZ
         LDA DAUX2
         BNE FXSCSZ_1
         LDA DAUX1
         CMP #$04
         BCC FXSCSZ_2
FXSCSZ_1
         LDA DENSITY
         CMP #$03
         BEQ FXSCSZ_3
FXSCSZ_2
         LDA #$00           ;128
         STA DBYTHI
         LDA #$80
         BNE FXSCSZ_4       ;always
FXSCSZ_3
         LDA #$01           ;256
         STA DBYTHI
         LDA #$00
FXSCSZ_4
         STA DBYTLO
         RTS
;
; GETADDR - read a line into INP1
; (GETINP1), then INP2ADDR
; Exit: as INP2ADDR
;
GETADDR
         JSR GETINP1
;
; INP2ADDR - the address in INP1: up
; to 4 hex digits, "600" -> $0600,
; "12345" -> $1234. Y: characters.
; The digits are not checked
; Exit: FILPOS; A, X, Y, TMP changed
;
INP2ADDR
         LDA #$00
         STA FILPOS
         STA FILPOS+1
         CPY #$05
         BCC INP2ADDR_0
         LDY #$04
INP2ADDR_0
         STY TMP            ;digits left
         LDX #$00
INP2ADDR_1
         DEC TMP
         BMI INP2ADDR_3
; FILPOS = FILPOS * 16 + the digit
         LDY #$04
INP2ADDR_2
         ASL FILPOS
         ROL FILPOS+1
         DEY
         BNE INP2ADDR_2
         LDA INP1,X
         JSR A2HEX
         ORA FILPOS
         STA FILPOS
         INX
         BNE INP2ADDR_1     ;always
INP2ADDR_3
         RTS
;
; A2HEX - a hex digit ('0'-'9', 'A'-
; 'F') in A to its value, 0-15
; Exit: A; C changed
;
A2HEX
         SEC
         SBC #'0
         CMP #10
         BCC A2HEX1
         SBC #7
A2HEX1
         RTS
;
; DOCIO - a CIO operation (@DOCIO);
; after the JSR: IOCB*16 + flags,
; command, .WORD buffer, ICAX1, with
; flag 1 .WORD the length's address
; (flag 2: a word, else a byte), else
; the length is 0. Flag 4: the buffer
; holds the data's address. ICAX2 = 0
; Exit: X kept, Y = status; errors but
; EOF go to DISKERR
;
DOCIO
         STX TMP
         LDY #$00
         JSR INLINE         ;RETADR only
         INY
         LDA (RETADR),Y
         STA DOCFLG
         AND #$01           ;length: 7 bytes
         ASL A
         ADC #$05
         TAY
         JSR INLINE         ;return past them
         LDA DOCFLG
         AND #$F0
         TAX
         LDY #$02
         LDA (RETADR),Y
         STA ICCOM,X
         INY
         LDA (RETADR),Y
         STA ICBAL,X
         STA CIOPTR
         INY
         LDA (RETADR),Y
         STA ICBAH,X
         STA CIOPTR+1
         INY
         LDA (RETADR),Y
         STA ICAX1,X
         LDA #$00
         STA ICAX2,X
         STA ICBLL,X
         STA ICBLH,X
         LDA DOCFLG
         AND #$04           ;buffer a pointer?
         BEQ DOCIO_2
         LDY #$00
         LDA (CIOPTR),Y
         STA ICBAL,X
         INY
         LDA (CIOPTR),Y
         STA ICBAH,X
DOCIO_2
         LDA DOCFLG
         LSR A              ;a length?
         BCC DOCIO_4
         LDY #$06
         LDA (RETADR),Y
         STA CIOPTR
         INY
         LDA (RETADR),Y
         STA CIOPTR+1
         LDY #$00
         LDA (CIOPTR),Y
         STA ICBLL,X
         LDA DOCFLG
         AND #$02           ;a word?
         BEQ DOCIO_4
         INY
         LDA (CIOPTR),Y
         STA ICBLH,X
DOCIO_4
         JSR CIOV
         BPL DOCIO_1
         CPY #AXEOF         ;EOF is no error
         BNE DISKERR
DOCIO_1
         LDX TMP
         RTS
;
; DISKERR - the error handler: print
; "* Error NNN" and the text, then the
; menu. Y: the error code
; Exit: never returns; to NLMENU
;
DISKERR
         STY VALUE
         JSR ERRTXT
         LDA #$00
         STA VALUE+1
         LDA # <INP1
         LDY # >INP1
         JSR BIN2DEC
; codes 128-255: 3 digits, then EOL
         LDA #$20
         STA INP1+4         ;a space for EOL
         LDA #DEL
         STA INP1+5
         JSR PRNTNL
         @PRNTLN EMSG,DEL
         @PRNTLN INP1+1,DEL
         @PRNTLN FILE
         JMP NLMENU
;
; ERRTXT - the text of CIO error Y
; (xl's AXERRT) into FILE, with EOL;
; only an EOL if it has none
; Exit: A = EOL; X, Y, INDPTR changed
;
ERRTXT
         JSR AXERRT
         BCC ERRTXT_1
         LDA #EOL           ;no text
         STA FILE
         RTS
ERRTXT_1
         STA INDPTR
         STY INDPTR+1
         LDY #$FF
ERRTXT_2
         INY
         LDA (INDPTR),Y
         STA FILE,Y
         CMP #EOL
         BNE ERRTXT_2
         RTS
;
; GETCHR - read a key (K:, caps lock
; on) and show it. Esc or an error
; (Break) go back to the menu
; Exit: A = the key; MOD10 changed
;
GETCHR
         @MKCAPS
         LDX #KBDID
         LDA #AXGETCHR
         STA ICCOM,X
         LDA #0
         STA ICBLL,X
         STA ICBLH,X
         JSR CIOV
         BMI GETCHRERR
         CMP #$1B           ;Esc
         BEQ GETCHRERR
         STA MOD10
         LDA #DEL
         STA MOD10+1
         @PRNTLN MOD10,DEL
         LDA MOD10
         RTS
GETCHRERR
         JMP NLMENU
;
; GETINP1 - read a line into INP1, at
; most MAXBUF with EOL (GETTEXT)
; Exit: as GETTEXT
;
GETINP1
         LDX #MAXBUF
         STX TXTLEN
         LDA # <INP1
         LDY # >INP1        ;into GETTEXT
;
; GETTEXT - read a line from E: into
; A/Y (lo/hi), at most TXTLEN bytes
; with EOL (longer: error 137). Break
; goes to GETCOM, errors to DISKERR
; Exit: Y = characters (no EOL); X = 0
;
GETTEXT
         LDX #SCRID
         STA ICBAL,X
         LDA #AXGETREC
         STA ICCOM,X
         TYA
         STA ICBAH,X
         LDA TXTLEN
         STA ICBLL,X
         LDA #0
         STA ICAX2,X
         JSR CIOV
         BMI GETTEXTERR
         DEC ICBLL,X        ;less the EOL
         LDY ICBLL,X
         RTS
GETTEXTERR
         CPY #BREAK
         BEQ HANDLEBREAK
         JMP DISKERR
HANDLEBREAK
         JMP GETCOM
;
; PRNTDL - print text on E: up to a
; DEL, not printed (@PRNTLN with DEL);
; .WORD the text after the JSR
; Exit: X, Y kept; A, D0, D1, TMP,
; INDPTR changed
;
PRNTDL
         LDA #DEL
         BNE PRNTLN_D       ;always
;
; PRNTLN - the same, up to and with
; the EOL (@PRNTLN)
; Exit: as PRNTDL
;
PRNTLN
         LDA #EOL
PRNTLN_D
         STA TMP            ;the delimiter
         STX D0
         STY D1
         LDY #$02
         JSR INLINE
         LDX #SCRID
         LDA (RETADR),Y
         STA INDPTR+1
         STA ICBAH,X
         DEY
         LDA (RETADR),Y
         STA INDPTR
         STA ICBAL,X
         LDA #AXPUTCHR
         STA ICCOM,X
         LDA #$00
         STA ICBLH,X
         LDY #$00
PRNTLN_1
         LDA (INDPTR),Y
         INY
         CMP TMP
         BNE PRNTLN_1
         CMP #EOL
         BEQ PRNTLN_2
         DEY                ;not the DEL
PRNTLN_2
         TYA
         STA ICBLL,X
         JSR CIOV
         LDX D0
         LDY D1
         RTS
;
; PRNTNL - print an EOL (EOLB)
; Exit: as PRNTLN
;
PRNTNL
         @PRNTLN EOLB
         RTS
;
; BIN2DEC - VALUE (16 bits) as decimal
; text at A/Y (lo/hi): the count, the
; digits, EOL; $FF -> 3,"255",EOL. By
; the OS's IFP and FASC
; Exit: A = the count, Y = 0; INDPTR,
; FR0, LBUFF changed
;
BIN2DEC
         STA INDPTR
         STY INDPTR+1
         LDA VALUE
         STA FR0
         LDA VALUE+1
         STA FR1
         JSR IFP
         JSR FASC
         LDY #$00
         LDX #$FF
         LDA LBUFF          ;skip a leading '0'
         CMP #'0
         BNE BIN2DEC_1
         INX
BIN2DEC_1
         INX
         INY
         LDA LBUFF,X
         STA (INDPTR),Y
         BPL BIN2DEC_1      ;bit 7: the last
         AND #$7F
         STA (INDPTR),Y
         INY
         LDA #EOL
         STA (INDPTR),Y
         DEY
         TYA
         LDY #$00
         STA (INDPTR),Y
         RTS
;
; COPY - copy text up to and with EOL
; (@CPYMEM with 2 parameters): .WORD
; source, destination after the JSR
; Exit: Y = bytes copied, A = EOL;
; CPYSRC, CPYDST changed
;
COPY
         LDY #$04
         JSR INLINE
COPY_1
         LDA (RETADR),Y
         STA CPYSRC-1,Y
         DEY
         BNE COPY_1
COPY_3
         LDA (CPYSRC),Y
         STA (CPYDST),Y
         INY
         CMP #EOL
         BNE COPY_3
         RTS
; CPYDST must follow CPYSRC, or the
; undefined label stops assembly
         .IF CPYDST-CPYSRC-2
         JMP CPYDST_MUST_FOLLOW_CPYSRC
         .ENDIF
;
; HEXOUT - A as 2 hex digits at FILE,Y
; Exit: Y + 2; X kept; A changed
;
HEXOUT
         PHA
         LSR A
         LSR A
         LSR A
         LSR A
         JSR HEXOUT_1
         PLA
         AND #$0F
HEXOUT_1
         CMP #$0A
         BCC HEXOUT_2
         ADC #$06           ;C=1: +7, 10 -> 'A
HEXOUT_2
         ADC #'0
         STA FILE,Y
         INY
         RTS
;
; FILL - fill memory (@FILLMEM): .WORD
; address, .BYTE length, character
; after the JSR; length 0 is 256
; Exit: X kept; A, Y, TMP, CPYSRC,
; CPYDST changed
;
FILL
         STX TMP
         LDY #$04
         JSR INLINE
FILL_1
         LDA (RETADR),Y
         STA CPYSRC-1,Y     ;to CPYSRC, CPYDST
         DEY
         BNE FILL_1
         LDA CPYDST+1       ;the character
         LDY CPYDST         ;the length
FILL_2
         DEY
         STA (CPYSRC),Y
         BNE FILL_2
         LDX TMP
         RTS
;
; DTXMEM - count the extended memory
; banks: each of the 128 PORTB values
; with the OS ROM on shows a bank or
; main memory at $4000. The byte there
; is kept in BUF and put back (a RAM
; disk may be in the banks)
; Exit: A = NUMBKS = banks; PORTB as
; it was; X = $FF; BUF changed
;
DTXMEM
         LDA PORTB
         PHA
         LDA #$00
         STA NUMBKS
         LDX #$7F           ;keep the bytes
DTXMEM_1
         TXA
         ASL A
         ORA #$01           ;OS ROM on
         STA PORTB
         LDA M4000
         STA BUF,X
         DEX
         BPL DTXMEM_1
         LDX #$7F           ;zero them
DTXMEM_2
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA #$00
         STA M4000
         DEX
         BPL DTXMEM_2
         LDA #$FF           ;main memory
         STA PORTB
         LDA #'K            ;not 0: not a bank
         STA M4000
         LDX #$7F           ;count those still 0
DTXMEM_3
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA M4000
         BNE SKIP
         INC NUMBKS
         LDA #'K
         STA M4000
SKIP     DEX
         BPL DTXMEM_3
         LDX #$7F           ;put them back
DTXMEM_4
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA BUF,X
         STA M4000
         DEX
         BPL DTXMEM_4
         PLA
         STA PORTB
         LDA NUMBKS
         RTS
;
; DEC2HEX - decimal text to a number
; by the OS's AFP, FPI: "1234" ->
; $04D2. A/Y (lo/hi): the buffer; the
; digits from its second byte
; Exit: VALUE; A, FR0, CIX changed
;
DEC2HEX
         STA INBUFF
         STY INBUFF+1
         LDA #$01
         STA CIX
         JSR AFP
         JSR FPI
         LDA FR0
         STA VALUE
         LDA FR1
         STA VALUE+1
         RTS
;
; Data and the work area. Zero page:
; SYSTEM.M65; the variables not in the
; file: the end of EDOSVARS.M65
;
EMSG     .BYTE "* Error ",DEL
; The work area $3A00-$3FFF, below the
; $4000 bank window: always mapped.
; EDOS must end below WRKBEG (checked
; at the end of EDOS.M65)
BUF      = $3F00            ;$100
INP1     = $3E80            ;input, helper $80
FILE     = $3E40            ;file name, row $40
FSIOV    = $3A00            ;the fast SIO code
FSIOMAX  = FILE-FSIOV       ;$440 bytes
WRKBEG   = FSIOV            ;the work area's start
; BANKS - PORTB values: main memory
; (set at START), then the 16 banks
BANKS    .BYTE $FD
         .BYTE $A3,$A7,$AB,$AF
         .BYTE $E3,$E7,$EB,$EF
         .BYTE $83,$87,$8B,$8F
         .BYTE $C3,$C7,$CB,$CF
;
; LDFONT - load D:AERA.FNT (1K, xl's
; AXFONT) below the screen, at page
; (RAMTOP-8) AND $FC, and set FONTPG
; to it. No file, a short one, or no
; room (under $8000) keep the ROM
; font; no message
; Exit: A, X, Y, TMP changed
;
LDFONT
         LDA RAMTOP
         SEC
         SBC #$08
         AND #$FC
         CMP #$80           ;not under $8000
         BCC LDFONT_1
         STA TMP
         LDX #DSKID1
         JSR AXFONT
         BCS LDFONT_1       ;not read
         LDA TMP
         STA FONTPG
LDFONT_1
         RTS
FONTPG   .BYTE 0            ;the font's page, 0: ROM
