10 ;UTILS.M65, V. 2.9 | UTILITIES | DISPLAYS BYTRD ($80 MAX) BYTES OF BUF
20 ;8 PER ROW FROM ADDRESS FILPOS | FILE-PRINTED LINE | ABORT=1 IF <$80
30 DSPBIN
40        @SHWCHR
50       LDA BYTRD
60       BMI DSPBIN_0 ;$80: A FULL BLOCK
70       LDA #$01    ;EOF REACHED
80       STA ABORT
90 DSPBIN_0
0100     JSR DRWHDR
0110     LDX #$00
0120 DSPBIN_1
0130      @FILLMEM  FILE,$28,$20 ;CLEAR LINE
0140     LDA #EOL
0150     STA FILE+$25
0160 ; LOCATION
0170     LDY #$00
0180     STY D2      ;CHAR COLUMN
0190     LDA FILPOS+1
0200     JSR HEXOUT
0210     LDA FILPOS
0220     JSR HEXOUT
0230     LDA #'-
0240     STA FILE,Y
0250 ;8 BYTES: HEX AT FILE+5+3*N, CHAR AT FILE+$1D+N
0260 DSPBIN_2
0270     INY
0280     LDA BUF,X
0290     JSR HEXOUT
0300     STY D1
0310     LDY D2
0320     LDA BUF,X
0330     CMP #EOL
0340     BNE DSPBIN_3
0350     LDA #$00    ;EOL->ZERO
0360 DSPBIN_3
0370     STA FILE+$1D,Y ;CHAR
0380     INY
0390     STY D2
0400     LDY D1
0410     INX
0420     INC FILPOS  ;NEXT ADDRESS
0430     BNE DSPBIN_3_5
0440     INC FILPOS+1
0450 DSPBIN_3_5
0460     DEC BYTRD
0470     BEQ DSPBIN_4 ;MXD READ CHRS?
0480     TXA
0490     AND #$07    ;ROW FULL?
0500     BNE DSPBIN_2
0510      @PRNTLN  FILE
0520 ; NEW ROW?
0530     CPX #$80
0540     BNE DSPBIN_1
0550     BEQ DSPBIN_5
0560 DSPBIN_4
0570      @PRNTLN  FILE
0580 DSPBIN_5
0590      @HIDCHR
0600     RTS
0610 ;
0620 ;DRAW HEADER LINE USING FILPOS
0630 DRWHDR
0640      @FILLMEM  FILE,$28,$20
0650     LDX #$00
0660     LDY #$05
0670 DRWHDR_1
0680     TXA
0690     JSR HEXOUT
0700     INY
0710     INX
0720     CPX #$08
0730     BNE DRWHDR_1
0740     LDA #EOL
0750     STA FILE,Y
0760      @PRNTLN  FILE
0990 ;
1000     LDA #CHL
1006     LDX #$05
1012     LDY #$17    ;FALL INTO DRAW
1020 ;
1030 ;DRAWS A LINE | A-CHAR, INP1-BUF | X-POS, Y-LEN | SPACES BEFORE X-POS
1035 DRAW
1040     PHA
1045     STX D0
1050     LDA #$20    ;BLANK 0..POS-1
1055     LDX #$00
1060 DRAW_0
1065     CPX D0
1070     BEQ DRAW_2
1075     STA INP1,X
1080     INX
1085     BNE DRAW_0
1090 DRAW_2
1095     TYA
1100     CLC
1105     ADC D0
1110     STA D0
1115     PLA
1120 DRAW_1
1130     STA INP1,X
1140     INX
1150     CPX D0
1160     BNE DRAW_1
1170     LDA #EOL
1180     STA INP1,X
1190      @PRNTLN  INP1
1200     RTS
1210 ;
1220 ;RESETS A 4 DIGITS | DECIMAL COUNTER
1230 RSTSCTCNT
1240     LDA #'1
1250     STA SCTR+3
1260     LDA #'0
1270     STA SCTR+2
1280     STA SCTR+1
1290     STA SCTR
1300     LDA #DEL
1310     STA SCTR+4
1320     RTS
1330 ;
1340 ;CONVERT # BANKS TO MEM IN K | A-# BANKS | MEMD-TEXT DECIMAL
1350 BNK2DEC
1360 ; # BANKS * 16 = K -> VALUE
1362     STA VALUE
1364     LDA #$00
1366     STA VALUE+1
1368     LDX #$04
1370 BNK2DEC_1
1372     ASL VALUE
1374     ROL VALUE+1
1376     DEX
1378     BNE BNK2DEC_1
1380 ; TO DECIMAL
1390     LDA # <MEMD
1400     LDY # >MEMD
1410     JSR BIN2DEC
1420     LDX MEMD
1430     LDA #'K
1440     STA MEMD+1,X
1450     LDA #$20
1460     STA MEMD+2,X
1470     LDA #DEL
1480     STA MEMD+3,X
1490     RTS
1500 ;
1510 ;INCREMENT SECTOR COUNTER BY 1
1520 INCSCTCNT
1530     LDX #$03    ;LAST DIGIT
1540 INCSCTCNT_1
1550     INC SCTR,X
1560     LDA SCTR,X
1570     CMP #$3A    ;PAST '9?
1580     BNE INCSCTCNT_2
1590     LDA #'0
1600     STA SCTR,X
1610     DEX         ;CARRY TO NEXT DIGIT
1620     BPL INCSCTCNT_1
1630 INCSCTCNT_2
1640     RTS
1740 ;
1750 ;DETECT INSERTED DISK DENSITY | A - 1-SNG,2-ENH,3-DBL
1760 DTCDNS
1770      @SIOSNDOFF
1780      @SETSCT  $10,$00
1790 ; READ SECTOR AND GET STAT
1800     LDA #SIO.RD
1810     STA DCOMND
1820     LDA DSKNUM
1830     STA DUNIT
1840     LDA #SIOST.RD
1850     STA DSTATS
1860     LDA # <BUF
1870     STA DBUFLO
1880     LDA # >BUF
1890     STA DBUFHI
1900     LDA #$07
1910     STA DTIMLO
1920     LDA #$80
1930     STA DBYTLO
1940     LDA #$00
1950     STA DBYTHI
1960     JSR SIOV
1970 ; @DOSIO SIO.RD,SIOST.RD,BUF,$07,$80,$00,SKPERR
1980 ; JSR DOSIO
1990 ; LDA DUNUSE
2000 ; CMP #SIOERR
2010 ; BEQ DTCDNS_3
2020 ;
2030     LDA #SIO.ST
2040     STA DCOMND
2050     JSR DSKINV
2060 ; X=3 DOUBLE, 2 ENHANCED, 1 SINGLE
2070     LDX #$03
2080     LDA DVSTAT
2090     AND #$20
2100     BNE DTCDNS_4
2110     DEX
2120     BIT DVSTAT  ;BIT 7: ENHANCED
2130     BMI DTCDNS_4
2140     DEX
2150 DTCDNS_4
2160      @SIOSNDON
2170     TXA
2180     RTS
2350 ;
2360 ;RESETS HS SIO MEM LOCATION
2370 RESETFIO
2380     LDA #$00
2390     STA FSIOV
2400     STA FSIOV+1
2410     RTS
2420 ;
2430 ;READ HS SIO CODE FROM DRIVE | AND PLACE IN FSIOV
2440 READFIO
2450     LDA FSIOV
2460     ORA FSIOV+1
2470     BNE READFIO_1
2480 ;
2490     LDA #$31
2500     STA DDEVIC
2510     LDA DSKNUM
2520     STA DUNIT
2530     LDA #SIO.SL
2540     STA DCOMND
2550     LDA #SIOST.RD
2560     STA DSTATS
2570     LDA #$08
2580     STA DBUFLO
2590     STA DTIMLO
2600     LDA #$03
2610     STA DBUFHI
2620     LDA #$02
2630     STA DBYTLO
2640     LDA #$00
2650     STA DBYTHI
2660     JSR SIOV
2670     BMI READFIO_1
2671 ; CODE MUST FIT ITS PAGE AT FSIOV
2672     LDA DBYTHI
2673     BEQ READFIO_0
2674     CMP #$01
2675     BNE READFIO_1
2676     LDA DBYTLO
2677     BNE READFIO_1
2678 READFIO_0
2680 ;
2690     INC DCOMND
2700     LDA # <FSIOV
2710     STA DBUFLO
2720     STA DAUX1
2730     LDA # >FSIOV
2740     STA DBUFHI
2750     STA DAUX2
2760     LDA #SIOST.RD
2770     STA DSTATS
2780     JSR SIOV
2790 READFIO_1
2800     RTS
2810 ;
2820 ;HIDECURSOR / SHOWCURSOR / SETCOLRED / CLOSECHANNEL
2830 ;SHARED SUBROUTINES FOR FORMERLY-INLINE MACROS
2840 HIDECURSOR
2850     LDA #$01
2860     STA CRSINH
2870     RTS
2880 ;
2890 SHOWCURSOR
2900     LDA #$00
2910     STA CRSINH
2920     RTS
2930 ;
2940 SETCOLRED
2950     LDA #$40
2960     STA COLOR4
2970     RTS
2980 ;
2990 ;CLOSECHANNEL - X = IOCB INDEX (SET BY CALLER)
3000 CLOSECHANNEL
3010     LDA #ICM.CL
3020     STA ICCOM,X
3030     JMP CIOV
3050 ;
3060 ;WRITE A SINGLE SECTOR | BUF - BUFFER | A - SCTR LO | Y - SCTR HI
3070 WRTSCT
3080     STA DAUX1
3090     STY DAUX2
3100      @DOSIO  SIO.WT,SIOST.WT,BUF,$07,$80,$00
3120     RTS
3130 ;
3300 ;EXECUTE AN SIO COMMAND | INLINE AFTER JSR (SEE @DOSIO): COMND,STAT,
3310 ;BUF,TIME,FLAG,SIZE - COPIED TO DCOMND-DBYTHI | DUNUSE - BITS 1,2
3320 DOSIO
3330      @GETRETADR
3340     LDA #$31
3350     STA DDEVIC
3360 ;INLINE PARAMS -> DCOMND..DBYTHI
3370     LDY #$08
3380 DOSIO_1
3390     LDA (RETADR),Y
3400     STA DCOMND-1,Y
3410     DEY
3420     BNE DOSIO_1
3430 ;RETURN PAST THEM
3440     CLC
3450     LDA RETADR
3460     ADC #$08
3470     STA RETADR
3480     BCC DOSIO_0
3490     INC RETADR+1
3500 DOSIO_0
3530 ;
3540     LDA DUNUSE
3550     AND #CNGDSK
3560     BNE DOSIO_2
3580     LDA DSKNUM
3590     STA DUNIT
3600 ;POINT TO VALID SECTOR?
3610 DOSIO_2
3620     LDA DAUX1   ;BOTH 0?
3630     ORA DAUX2
3640     BNE DOSIO_3
3650     INC DAUX1   ;DEF SCTR 1
3660 DOSIO_3
3670     JSR CALLSIO
3680 DOSIO_7
3690      @SETRETADR
3700     LDA DSTATS
3710 ;LDA #$00 | STA DUNUSE
3720     RTS
3730 ;
3740 ;THE ACTUAL SIO CALL ROUTINE
3750 CALLSIO
3760 ; FAST SIO ONLY ON READ/WRITE
3770     LDA DCOMND
3780     CMP #SIO.RD
3790     BEQ CALLSIO_1
3800     CMP #SIO.WT
3810     BNE CALLSIO_2
3820 ;READ/WRITE
3830 CALLSIO_1
3840 ; USE THE CORRECT SECTOR SIZE
3850     JSR FXSCSZ
3860 ; HAVE FAST SIO?
3870     LDA FSIOV
3880     ORA FSIOV+1
3890     BEQ CALLSIO_2 ;NOT FSIOV?
3900     JSR FSIOV
3910     JMP CALLSIO_6 ;N=ERROR
3920 ;OTHER
3930 CALLSIO_2
3940     JSR SIOV
3950 CALLSIO_6
3960     BPL CALLSIO_5
3990 ;ERROR FOR READ/WRITE ONLY
4000 CALLSIO_3
4010 ; $8B MAYBE OK (MyDos)
4020 ; CPY #$8B
4030 ; BEQ CALLSIO_5
4040     CPY #BREAK  ;BRK KEY
4050     BEQ CALLSIO_5
4060     LDA DCOMND
4070     CMP #SIO.HS
4080     BEQ CALLSIO_5
4090     CMP #SIO.ST
4100     BEQ CALLSIO_5
4110     CMP #SIO.WP
4120     BEQ CALLSIO_5
4130     LDA DUNUSE
4140     AND #SKPERR
4150     BNE CALLSIO_4
4170 ;
4180 ; PLP
4190     JMP DISKERR
4200 CALLSIO_4
4210     LDA #SIOERR
4220     STA DUNUSE
4230 CALLSIO_5
4240     RTS
4250 ;
4260 ;READ DAUX SECTOR NUMBER | FIX DBUFLO/HI FOR RIGHT SIZE
4270 ;USE SINGLE FOR SECTORS 1-3
4280 FXSCSZ
4290     LDA DAUX2
4300     BNE FXSCSZ_1
4310     LDA DAUX1
4320     CMP #$04
4330     BCC FXSCSZ_2
4340 FXSCSZ_1
4350     LDA DENSITY
4360     CMP #$03
4370     BEQ FXSCSZ_3
4380 ;SINGLE
4390 FXSCSZ_2
4400     LDA #$00
4410     STA DBYTHI
4420     LDA #$80
4430     BNE FXSCSZ_4 ;ALWAYS
4440 ;DOUBLE
4450 FXSCSZ_3
4460     LDA #$01
4470     STA DBYTHI
4480     LDA #$00
4490 FXSCSZ_4
4500     STA DBYTLO
4510     RTS
4520 ;
4530 ;CONVERT TEXT INPUT TO BINARY | Y-LEN, INP1-IN
4540 ;UP TO 4 HEX DIGITS: "600"->$0600, "12345"->$1234
4550 INP2ADDR
4560     LDA #$00
4570     STA FILPOS
4580     STA FILPOS+1
4590     CPY #$05
4600     BCC INP2ADDR_0
4610     LDY #$04    ;FIRST 4 DIGITS ONLY
4620 INP2ADDR_0
4630     STY TMP     ;DIGITS LEFT
4640     LDX #$00
4650 INP2ADDR_1
4660     DEC TMP
4670     BMI INP2ADDR_3
4680 ; FILPOS = FILPOS*16 + DIGIT
4690     LDY #$04
4700 INP2ADDR_2
4710     ASL FILPOS
4720     ROL FILPOS+1
4730     DEY
4740     BNE INP2ADDR_2
4750     LDA INP1,X
4760     JSR A2HEX
4770     ORA FILPOS
4780     STA FILPOS
4790     INX
4800     BNE INP2ADDR_1 ;ALWAYS
4810 INP2ADDR_3
4820     RTS
4830 ;
4960 ;CONVERT ASCII TO HEX NIBBLE | HELPER TO INP2ADDR
4970 A2HEX
4980     SEC
4990     SBC #'0
5000     CMP #10
5010     BCC A2HEX1
5020     SBC #7
5030 A2HEX1
5040     RTS
5050 ;
5060 ;EXECUTE A CIO COMMAND | INLINE AFTER JSR (SEE @DOCIO):
5062 ;.BYTE IOCB+FLAGS,CMD | .WORD BUF | .BYTE ICAX1 | [.WORD LEN ADDR]
5064 ;FLAGS: 1-LEN AT LEN ADDR | 2-LEN IS A WORD | 4-BUF HOLDS A POINTER
5066 DOCIO
5068      @GETRETADR
5070     STX TMP     ;CACHE X
5072     LDY #$01
5074     LDA (RETADR),Y
5076     STA DOCFLG
5078     AND #$F0
5080     TAX
5082     INY
5084     LDA (RETADR),Y
5086     STA ICCOM,X
5088     INY
5090     LDA (RETADR),Y
5092     STA ICBAL,X
5094     STA CIOPTR
5096     INY
5098     LDA (RETADR),Y
5100     STA ICBAH,X
5102     STA CIOPTR+1
5104     INY
5106     LDA (RETADR),Y
5108     STA ICAX1,X
5110     LDA #$00
5112     STA ICAX2,X
5114     STA ICBLL,X
5116     STA ICBLH,X
5118 ;BUF HOLDS A POINTER?
5120     LDA DOCFLG
5122     AND #$04
5124     BEQ DOCIO_2
5126     LDY #$00
5128     LDA (CIOPTR),Y
5130     STA ICBAL,X
5132     INY
5134     LDA (CIOPTR),Y
5136     STA ICBAH,X
5138 DOCIO_2
5140 ;LENGTH GIVEN?
5142     LDA DOCFLG
5144     LSR A
5146     BCC DOCIO_4
5148     LDY #$06
5150     LDA (RETADR),Y
5152     STA CIOPTR
5154     INY
5156     LDA (RETADR),Y
5158     STA CIOPTR+1
5160     LDY #$00
5162     LDA (CIOPTR),Y
5164     STA ICBLL,X
5166     LDA DOCFLG
5168     AND #$02
5170     BEQ DOCIO_4
5172     INY
5174     LDA (CIOPTR),Y
5176     STA ICBLH,X
5178 ;RETURN PAST 5 OR 7 INLINE BYTES
5180 DOCIO_4
5182     LDA DOCFLG
5184     AND #$01
5186     ASL A
5188     ADC #$05
5190     ADC RETADR
5192     STA RETADR
5194     BCC DOCIO_5
5196     INC RETADR+1
5198 DOCIO_5
5260     JSR CIOV
5270     BPL DOCIO_1
5280     CPY #ICSTAT.EOF ;EOF IS NOT AN ERROR
5290     BNE DISKERR
5300 DOCIO_1
5310     LDX TMP
5320      @SETRETADR
5330     RTS
5370 ;GENERIC ERROR HANDLER
5380 DISKERR
5390     STY VALUE
5400     JSR GETERRTXT
5410     LDA #$00
5420     STA VALUE+1
5430     LDA # <INP1
5440     LDY # >INP1
5450     JSR BIN2DEC
5460 ; PRINT "* Error ", THE CODE (128-255: 3 DIGITS) AND TEXT
5467     LDA #$20
5474     STA INP1+4  ;SPACE INSTEAD OF EOL
5481     LDA #DEL
5488     STA INP1+5
5495     JSR PRNTNL
5502      @PRNTLN  EMSG,DEL
5509      @PRNTLN  INP1+1,DEL
5516      @PRNTLN  FILE
5530     JSR PRNTNL
5540     JMP GETCOM  ;RESETS THE STACK
5590 ;
5600 ;RETURN CIO ERROR TEXT | Y-CODE,FILE-TEXT (EMPTY IF UNKNOWN)
5608 ;CIO_MSG: CODE, TEXT, EOL, ... , $FF
5616 GETERRTXT
5624     STY TMP
5632     LDA # <CIO_MSG
5640     STA INDPTR
5648     LDA # >CIO_MSG
5656     STA INDPTR+1
5664 GETERRTXT_1
5672     LDY #$00
5680     LDA (INDPTR),Y
5688     CMP #$FF    ;END OF LIST?
5696     BEQ GETERRTXT_4
5704     CMP TMP
5712     BEQ GETERRTXT_2
5720 ;SKIP THIS MESSAGE
5728 GETERRTXT_5
5736     INY
5744     LDA (INDPTR),Y
5752     CMP #EOL
5760     BNE GETERRTXT_5
5768     INY
5776     TYA
5784     CLC
5792     ADC INDPTR
5800     STA INDPTR
5808     BCC GETERRTXT_1
5816     INC INDPTR+1
5824     BCS GETERRTXT_1
5832 ;COPY TEXT AFTER THE CODE
5840 GETERRTXT_2
5848     INY
5856     LDA (INDPTR),Y
5864     STA FILE-1,Y
5872     CMP #EOL
5880     BNE GETERRTXT_2
5888     RTS
5896 GETERRTXT_4
5904     LDA #EOL
5912     STA FILE
5920     RTS
5940 ;
5950 ;GET A SINGLE CHAR FROM USER
5960 GETCHR
5970      @MKCAPS
5980     LDX #KBDID
5990     LDA #ICM.GB
6000     STA ICCOM,X
6010     LDA #0
6020     STA ICBLL,X
6030     STA ICBLH,X
6040     JSR CIOV
6050     BMI GETCHRERR
6060 ;
6070     CMP #$1B    ;ESCAPE KEY
6080     BEQ GETCHRERR
6090 ; RELAY TO SCREEN
6100     STA MOD10
6110     LDA #DEL
6120     STA MOD10+1
6130      @PRNTLN  MOD10,DEL
6140 ;
6150     LDA MOD10   ;RECALL CHAR
6160     RTS
6170 GETCHRERR
6180     JSR PRNTNL
6190     JMP GETCOM
6200 ;
6380 ;GET A TEXT INPUT FROM USER | Y-RETURN # CHARACTERS | A-LO BYTE INPUT
6390 ;Y-HI BYTE INPUT
6400 GETTEXT
6410     LDX #SCRID
6420     STA ICBAL,X
6430     LDA #ICM.GT
6440     STA ICCOM,X
6450     TYA
6460     STA ICBAH,X
6470     LDA TXTLEN  ;MAX LEN, LONGER->137
6480     STA ICBLL,X
6490     LDA #0
6500     STA ICAX2,X
6510     JSR CIOV
6520     BMI GETTEXTERR
6530     DEC ICBLL,X ;REMOVE EOL
6540     LDY ICBLL,X ;# CHARS READ
6550     RTS
6560 GETTEXTERR
6570     CPY #BREAK
6580     BEQ HANDLEBREAK
6590     JMP DISKERR ;NO, IO ERROR
6600 HANDLEBREAK
6610     JMP GETCOM
6620 ;
6630 ;PRINT TEXT ON SCREEN | INLINE AFTER JSR: .WORD BUF | X,Y KEPT
6639 ;PRNTLN: UP TO AND WITH EOL | PRNTDL: UP TO DEL (NOT PRINTED)
6648 PRNTDL
6657     LDA #DEL
6666     BNE PRNTLN_D ;ALWAYS
6675 PRNTLN
6684     LDA #EOL
6693 PRNTLN_D
6702     STA TMP     ;DELIMITER
6711      @GETRETADR
6720     STX D0
6729     STY D1
6738     LDX #SCRID
6747 ;INLINE PARAM
6756     LDY #$01
6765     LDA (RETADR),Y
6774     STA INDPTR
6783     STA ICBAL,X
6792     INY
6801     LDA (RETADR),Y
6810     STA INDPTR+1
6819     STA ICBAH,X
6828 ;RETURN PAST IT (Y=2)
6837     TYA
6846     CLC
6855     ADC RETADR
6864     STA RETADR
6873     BCC PRNTLN_0
6882     INC RETADR+1
6891 PRNTLN_0
6900     LDA #ICM.PB
6909     STA ICCOM,X
6918     LDA #$00
6927     STA ICBLH,X
6936 ; FIND DELIM
6945     LDY #$00
6954 PRNTLN_1
6963     LDA (INDPTR),Y
6972     INY
6981     CMP TMP
6990     BNE PRNTLN_1
6999     CMP #EOL
7008     BEQ PRNTLN_2
7017     DEY         ;REMOVE DEL
7026 PRNTLN_2
7035     TYA
7044     STA ICBLL,X
7053     JSR CIOV
7062 ; RESTORE
7071     LDX D0
7080     LDY D1
7089      @SETRETADR
7098     RTS
7130 ;
7140 ;PRINT A NEW LINE ON SCREEN
7150 PRNTNL
7160      @PRNTLN  EOLB
7170     RTS
7200 ;
7210 ;VALUE (16 BIT) TO DECIMAL TEXT AT A/Y (LO/HI): # CHARS, DIGITS, EOL
7220 ;$FF -> 3,"255",EOL
7230 BIN2DEC
7240     STA INDPTR
7250     STY INDPTR+1
7260     LDA VALUE
7270     STA FR0
7280     LDA VALUE+1
7290     STA FR1
7300     JSR IFP
7310     JSR FASC
7320     LDY #$00
7330     LDX #$FF
7340 ; DISREGARD FIRST 0
7350     LDA LBUFF
7360     CMP #'0
7370     BNE BIN2DEC_1
7380     INX
7390 BIN2DEC_1
7400     INX
7410     INY
7420     LDA LBUFF,X
7430     STA (INDPTR),Y
7440     BPL BIN2DEC_1
7450     AND #$7F
7460     STA (INDPTR),Y
7470     INY
7480     LDA #EOL
7490     STA (INDPTR),Y
7500 ;# CHARS
7510     DEY
7520     TYA
7530     LDY #$00
7540     STA (INDPTR),Y
7550     RTS
7600 ;
7610 ;A -> 2 HEX DIGITS AT FILE,Y | Y+2 | X KEPT
7620 HEXOUT
7630     PHA
7640     LSR A
7650     LSR A
7660     LSR A
7670     LSR A
7680     JSR HEXOUT_1
7690     PLA
7700     AND #$0F
7710 HEXOUT_1
7720     CMP #$0A
7730     BCC HEXOUT_2
7740     ADC #$06    ;C=1: +7, 10 -> 'A
7750 HEXOUT_2
7760     ADC #'0
7770     STA FILE,Y
7780     INY
7790     RTS
8010 ;
8020 ;DETECT # EXTENDED RAM BANKS | A-# MEM PAGES
8030 DTXMEM
8040     LDA PORTB
8050     PHA
8060     LDA #$00
8070     STA NUMBKS
8080 ; SAVE RAMDISK
8090     LDX #$7F
8100 DTXMEM_1
8110     TXA
8120     ASL A
8130     ORA #$01
8140     STA PORTB
8150     LDA M4000
8160     STA BUF,X
8170     DEX
8180     BPL DTXMEM_1
8190 ; CLR RAM TO TEST
8200     LDX #$7F
8210 DTXMEM_2
8220     TXA
8230     ASL A
8240     ORA #$01
8250     STA PORTB
8260     LDA #$00
8270     STA M4000
8280     DEX
8290     BPL DTXMEM_2
8300     LDA #$FF    ;RST POTB
8310     STA PORTB
8320     LDA #'K
8330     STA M4000
8340 ; COUNT BANKS
8350     LDX #$7F
8360 DTXMEM_3
8370     TXA
8380     ASL A
8390     ORA #$01
8400     STA PORTB
8410     LDA M4000
8420     BNE SKIP
8430     INC NUMBKS
8440     LDA #'K
8450     STA M4000
8460 SKIP DEX
8470     BPL DTXMEM_3
8480 ; RESTORE RAMDISK
8490     LDX #$7F
8500 DTXMEM_4
8510     TXA
8520     ASL A
8530     ORA #$01
8540     STA PORTB
8550     LDA BUF,X
8560     STA M4000
8570     DEX
8580     BPL DTXMEM_4
8590     PLA
8600     STA PORTB
8610     LDA NUMBKS
8620     RTS
8630 ;
8640 ;4 DIGITS DEC TO HEX CONVERT | A-LO BYTE | Y-HI BYTE
8650 DEC2HEX
8660     STA INBUFF
8670     STY INBUFF+1
8680     LDA #$01
8690     STA CIX
8700     JSR AFP
8710     JSR FPI
8720     LDA FR0
8730     STA VALUE
8740     LDA FR1
8750     STA VALUE+1
8760     RTS
8770 ;
8780 ; VARIABLES
8790 ;
8800 ; ZERO PAGE: SEE SYSTEM.M65
8810 ; RESERVED (NOT IN THE FILE): SEE THE END OF EDOSVARS.M65
8860 EMSG .BYTE "* Error ",DEL
8870 ;WORK AREA $3D40-$3FFF: BELOW THE $4000 BANK WINDOW, ALWAYS MAPPED
8875 ;EDOS MUST END BELOW WRKBEG - CHECKED AT THE END OF EDOS.M65
8880 FSIOV = $3F00   ;FAST SIO CODE, 1 PAGE
8885 BUF =   $3E00   ;$100
8890 INP1 =  $3D80   ;INPUT/HELPER $80
8895 FILE =  $3D40   ;FILE BUF $40
8900 WRKBEG = FILE   ;LOWEST WORK AREA ADDR
8920 BANKS .BYTE $FD
8930     .BYTE $A3,$A7,$AB,$AF
8940     .BYTE $E3,$E7,$EB,$EF
8950     .BYTE $83,$87,$8B,$8F
8960     .BYTE $C3,$C7,$CB,$CF
8970 ;
8980 ;LOAD D:EDOS.FNT (1K) BELOW THE SCREEN | SETS FONTPG IF LOADED
8990 ;NO ERROR MESSAGES: NO FILE OR NO ROOM KEEPS THE ROM FONT
9000 LDFONT
9010     LDA RAMTOP
9020     SEC
9030     SBC #$08    ;1K PAGE BELOW SCREEN
9040     AND #$FC
9050     CMP #$80    ;NOT IN $4000-$7FFF
9060     BCC LDFONT_1
9070     STA TMP
9080     LDX #DSKID1
9090     LDA #ICM.OP
9100     STA ICCOM,X
9110     LDA # <FNTNAM
9120     STA ICBAL,X
9130     LDA # >FNTNAM
9140     STA ICBAH,X
9150     LDA #ICAX.RD
9160     STA ICAX1,X
9170     LDA #$00
9180     STA ICAX2,X
9190     JSR CIOV
9200     BMI LDFONT_2
9210     LDA #ICM.GB
9220     STA ICCOM,X
9230     LDA #$00
9240     STA ICBAL,X
9250     STA ICBLL,X
9260     LDA TMP
9270     STA ICBAH,X
9280     LDA #$04    ;$400 BYTES
9290     STA ICBLH,X
9300     JSR CIOV
9310     BMI LDFONT_2
9320     LDA TMP
9330     STA FONTPG
9340 LDFONT_2
9350     JMP CLOSECHANNEL
9360 LDFONT_1
9370     RTS
9380 FONTPG .BYTE 0  ;CUSTOM FONT PAGE, 0=ROM
9390 FNTNAM .BYTE "D:EDOS.FNT",EOL
