;UTILS.M65, V. 3.2 | UTILITIES | DISPLAYS BYTRD ($80 MAX) BYTES OF BUF
;Copyright (C) 2026 AERA | Erez Yaary
;8 PER ROW FROM ADDRESS FILPOS | FILE-PRINTED LINE | ABORT=1 IF <$80
DSPBIN
         @SHWCHR
         LDA BYTRD
         BMI DSPBIN_0       ;$80: A FULL BLOCK
         LDA #$01           ;EOF REACHED
         STA ABORT
DSPBIN_0
         JSR DRWHDR
         LDX #$00
DSPBIN_1
         @FILLMEM FILE,$28,$20 ;CLEAR LINE
         LDA #EOL
         STA FILE+$25
; LOCATION
         LDY #$00
         STY D2             ;CHAR COLUMN
         LDA FILPOS+1
         JSR HEXOUT
         LDA FILPOS
         JSR HEXOUT
         LDA #'-
         STA FILE,Y
;8 BYTES: HEX AT FILE+5+3*N, CHAR AT FILE+$1D+N
DSPBIN_2
         INY
         LDA BUF,X
         JSR HEXOUT
         STY D1
         LDY D2
         LDA BUF,X
         CMP #EOL
         BNE DSPBIN_3
         LDA #$00           ;EOL->ZERO
DSPBIN_3
         STA FILE+$1D,Y     ;CHAR
         INY
         STY D2
         LDY D1
         INX
         INC FILPOS         ;NEXT ADDRESS
         BNE DSPBIN_3_5
         INC FILPOS+1
DSPBIN_3_5
         DEC BYTRD
         BEQ DSPBIN_4       ;MXD READ CHRS?
         TXA
         AND #$07           ;ROW FULL?
         BNE DSPBIN_2
         @PRNTLN FILE
; NEW ROW?
         CPX #$80
         BNE DSPBIN_1
         BEQ DSPBIN_5
DSPBIN_4
         @PRNTLN FILE
DSPBIN_5
         @HIDCHR
         RTS
;
;DRAW HEADER LINE USING FILPOS
DRWHDR
         @FILLMEM FILE,$28,$20
         LDX #$00
         LDY #$05
DRWHDR_1
         TXA
         JSR HEXOUT
         INY
         INX
         CPX #$08
         BNE DRWHDR_1
         LDA #EOL
         STA FILE,Y
         @PRNTLN FILE
;
         LDA #CHL
         LDX #$05
         LDY #$17           ;FALL INTO DRAW
;
;DRAWS A LINE | A-CHAR, INP1-BUF | X-POS, Y-LEN | SPACES BEFORE X-POS
DRAW
         PHA
         STX D0
         LDA #$20           ;BLANK 0..POS-1
         LDX #$00
DRAW_0
         CPX D0
         BEQ DRAW_2
         STA INP1,X
         INX
         BNE DRAW_0
DRAW_2
         TYA
         CLC
         ADC D0
         STA D0
         PLA
DRAW_1
         STA INP1,X
         INX
         CPX D0
         BNE DRAW_1
         LDA #EOL
         STA INP1,X
         @PRNTLN INP1
         RTS
;
;RESETS A 4 DIGITS | DECIMAL COUNTER
RSTSCTCNT
         LDA #'1
         STA SCTR+3
         LDA #'0
         STA SCTR+2
         STA SCTR+1
         STA SCTR
         LDA #DEL
         STA SCTR+4
         RTS
;
;CONVERT # BANKS TO MEM IN K | A-# BANKS | MEMD-TEXT DECIMAL
BNK2DEC
; # BANKS * 16 = K -> VALUE
         STA VALUE
         LDA #$00
         STA VALUE+1
         LDX #$04
BNK2DEC_1
         ASL VALUE
         ROL VALUE+1
         DEX
         BNE BNK2DEC_1
; TO DECIMAL
         LDA # <MEMD
         LDY # >MEMD
         JSR BIN2DEC
         LDX MEMD
         LDA #'K
         STA MEMD+1,X
         LDA #$20
         STA MEMD+2,X
         LDA #DEL
         STA MEMD+3,X
         RTS
;
;INCREMENT SECTOR COUNTER BY 1
INCSCTCNT
         LDX #$03           ;LAST DIGIT
INCSCTCNT_1
         INC SCTR,X
         LDA SCTR,X
         CMP #$3A           ;PAST '9?
         BNE INCSCTCNT_2
         LDA #'0
         STA SCTR,X
         DEX                ;CARRY TO NEXT DIGIT
         BPL INCSCTCNT_1
INCSCTCNT_2
         RTS
;
;DETECT INSERTED DISK DENSITY | A - 1-SNG,2-ENH,3-DBL
DTCDNS
         @SIOSNDOFF
         @SETSCT $10,$00
; READ SECTOR AND GET STAT
         LDA #SIO.RD
         STA DCOMND
         LDA DSKNUM
         STA DUNIT
         LDA #SIOST.RD
         STA DSTATS
         LDA # <BUF
         STA DBUFLO
         LDA # >BUF
         STA DBUFHI
         LDA #$07
         STA DTIMLO
         LDA #$80
         STA DBYTLO
         LDA #$00
         STA DBYTHI
         JSR SIOV
; @DOSIO SIO.RD,SIOST.RD,BUF,$07,$80,$00,SKPERR
; JSR DOSIO
; LDA DUNUSE
; CMP #SIOERR
; BEQ DTCDNS_3
;
         LDA #SIO.ST
         STA DCOMND
         JSR DSKINV
; X=3 DOUBLE, 2 ENHANCED, 1 SINGLE
         LDX #$03
         LDA DVSTAT
         AND #$20
         BNE DTCDNS_4
         DEX
         BIT DVSTAT         ;BIT 7: ENHANCED
         BMI DTCDNS_4
         DEX
DTCDNS_4
         @SIOSNDON
         TXA
         RTS
;
;RESETS HS SIO MEM LOCATION
RESETFIO
         LDA #$00
         STA FSIOV
         STA FSIOV+1
         RTS
;
;READ HS SIO CODE FROM DRIVE | AND PLACE IN FSIOV
READFIO
         LDA FSIOV
         ORA FSIOV+1
         BNE READFIO_1
;
         LDA #$31
         STA DDEVIC
         LDA DSKNUM
         STA DUNIT
         LDA #SIO.SL
         STA DCOMND
         LDA #SIOST.RD
         STA DSTATS
         LDA #$08
         STA DBUFLO
         STA DTIMLO
         LDA #$03
         STA DBUFHI
         LDA #$02
         STA DBYTLO
         LDA #$00
         STA DBYTHI
         JSR SIOV
         BMI READFIO_1
; CODE MUST FIT FSIOV..WRKBEG-1 (FSIOMAX BYTES)
         LDA # <FSIOMAX
         CMP DBYTLO
         LDA # >FSIOMAX
         SBC DBYTHI         ;C=0: LONGER THAN FSIOMAX
         BCC READFIO_1
;
         INC DCOMND
         LDA # <FSIOV
         STA DBUFLO
         STA DAUX1
         LDA # >FSIOV
         STA DBUFHI
         STA DAUX2
         LDA #SIOST.RD
         STA DSTATS
         JSR SIOV
READFIO_1
         RTS
;
;HIDECURSOR / SHOWCURSOR / SETCOLRED / CLOSECHANNEL
;SHARED SUBROUTINES FOR FORMERLY-INLINE MACROS
HIDECURSOR
         LDA #$01
         STA CRSINH
         RTS
;
SHOWCURSOR
         LDA #$00
         STA CRSINH
         RTS
;
SETCOLRED
         LDA #$40
         STA COLOR4
         RTS
;
;CLOSECHANNEL - X = IOCB INDEX (SET BY CALLER)
CLOSECHANNEL
         LDA #ICM.CL
         STA ICCOM,X
         JMP CIOV
;
;WRITE A SINGLE SECTOR | BUF - BUFFER | A - SCTR LO | Y - SCTR HI
WRTSCT
         STA DAUX1
         STY DAUX2
         @DOSIO SIO.WT,SIOST.WT,BUF,$07,$80,$00
         RTS
;
;INLINE: FOR A ROUTINE WITH Y PARAMETER BYTES AFTER ITS JSR. CALL IT
;BEFORE PUSHING ANYTHING: RETADR -> THE BYTE BEFORE THE PARAMETERS
;AND THE ROUTINE'S OWN RTS RETURNS PAST THEM | Y KEPT, X CHANGED
INLINE
         TSX
         LDA $0103,X        ;THE ROUTINE'S RETURN ADDRESS
         STA RETADR
         LDA $0104,X
         STA RETADR+1
         TYA
         CLC
         ADC $0103,X
         STA $0103,X
         BCC INLINE_1
         INC $0104,X
INLINE_1
         RTS
;
;EXECUTE AN SIO COMMAND | INLINE AFTER JSR (SEE @DOSIO): COMND,STAT,
;BUF,TIME,FLAG,SIZE - COPIED TO DCOMND-DBYTHI | DUNUSE - BITS 1,2
DOSIO
         LDY #$08
         JSR INLINE
         LDA #$31
         STA DDEVIC
;INLINE PARAMS -> DCOMND..DBYTHI (Y=8)
DOSIO_1
         LDA (RETADR),Y
         STA DCOMND-1,Y
         DEY
         BNE DOSIO_1
;
         LDA DUNUSE
         AND #CNGDSK
         BNE DOSIO_2
         LDA DSKNUM
         STA DUNIT
;POINT TO VALID SECTOR?
DOSIO_2
         LDA DAUX1          ;BOTH 0?
         ORA DAUX2
         BNE DOSIO_3
         INC DAUX1          ;DEF SCTR 1
DOSIO_3
         JSR CALLSIO
         LDA DSTATS
         RTS
;
;THE ACTUAL SIO CALL ROUTINE
CALLSIO
; FAST SIO ONLY ON READ/WRITE
         LDA DCOMND
         CMP #SIO.RD
         BEQ CALLSIO_1
         CMP #SIO.WT
         BNE CALLSIO_2
;READ/WRITE
CALLSIO_1
; USE THE CORRECT SECTOR SIZE
         JSR FXSCSZ
; HAVE FAST SIO?
         LDA FSIOV
         ORA FSIOV+1
         BEQ CALLSIO_2      ;NOT FSIOV?
         JSR FSIOV
         JMP CALLSIO_6      ;N=ERROR
;OTHER
CALLSIO_2
         JSR SIOV
CALLSIO_6
         BPL CALLSIO_5
;ERROR FOR READ/WRITE ONLY
CALLSIO_3
; $8B MAYBE OK (MyDos)
; CPY #$8B
; BEQ CALLSIO_5
         CPY #BREAK         ;BRK KEY
         BEQ CALLSIO_5
         LDA DCOMND
         CMP #SIO.HS
         BEQ CALLSIO_5
         CMP #SIO.ST
         BEQ CALLSIO_5
         CMP #SIO.WP
         BEQ CALLSIO_5
         LDA DUNUSE
         AND #SKPERR
         BNE CALLSIO_4
;
; PLP
         JMP DISKERR
CALLSIO_4
         LDA #SIOERR
         STA DUNUSE
CALLSIO_5
         RTS
;
;READ DAUX SECTOR NUMBER | FIX DBUFLO/HI FOR RIGHT SIZE
;USE SINGLE FOR SECTORS 1-3
FXSCSZ
         LDA DAUX2
         BNE FXSCSZ_1
         LDA DAUX1
         CMP #$04
         BCC FXSCSZ_2
FXSCSZ_1
         LDA DENSITY
         CMP #$03
         BEQ FXSCSZ_3
;SINGLE
FXSCSZ_2
         LDA #$00
         STA DBYTHI
         LDA #$80
         BNE FXSCSZ_4       ;ALWAYS
;DOUBLE
FXSCSZ_3
         LDA #$01
         STA DBYTHI
         LDA #$00
FXSCSZ_4
         STA DBYTLO
         RTS
;
;GETADDR: READ A LINE INTO INP1, THEN INP2ADDR
GETADDR
         JSR GETINP1
;CONVERT TEXT INPUT TO BINARY | Y-LEN, INP1-IN
;UP TO 4 HEX DIGITS: "600"->$0600, "12345"->$1234
INP2ADDR
         LDA #$00
         STA FILPOS
         STA FILPOS+1
         CPY #$05
         BCC INP2ADDR_0
         LDY #$04           ;FIRST 4 DIGITS ONLY
INP2ADDR_0
         STY TMP            ;DIGITS LEFT
         LDX #$00
INP2ADDR_1
         DEC TMP
         BMI INP2ADDR_3
; FILPOS = FILPOS*16 + DIGIT
         LDY #$04
INP2ADDR_2
         ASL FILPOS
         ROL FILPOS+1
         DEY
         BNE INP2ADDR_2
         LDA INP1,X
         JSR A2HEX
         ORA FILPOS
         STA FILPOS
         INX
         BNE INP2ADDR_1     ;ALWAYS
INP2ADDR_3
         RTS
;
;CONVERT ASCII TO HEX NIBBLE | HELPER TO INP2ADDR
A2HEX
         SEC
         SBC #'0
         CMP #10
         BCC A2HEX1
         SBC #7
A2HEX1
         RTS
;
;EXECUTE A CIO COMMAND | INLINE AFTER JSR (SEE @DOCIO):
;.BYTE IOCB+FLAGS,CMD | .WORD BUF | .BYTE ICAX1 | [.WORD LEN ADDR]
;FLAGS: 1-LEN AT LEN ADDR | 2-LEN IS A WORD | 4-BUF HOLDS A POINTER
DOCIO
         STX TMP            ;CACHE X
         LDY #$00
         JSR INLINE         ;RETADR ONLY
         INY
         LDA (RETADR),Y
         STA DOCFLG
         AND #$01           ;LEN ADDR: 7 BYTES, ELSE 5
         ASL A
         ADC #$05
         TAY
         JSR INLINE         ;RETURN PAST THEM
         LDA DOCFLG
         AND #$F0
         TAX
         LDY #$02
         LDA (RETADR),Y
         STA ICCOM,X
         INY
         LDA (RETADR),Y
         STA ICBAL,X
         STA CIOPTR
         INY
         LDA (RETADR),Y
         STA ICBAH,X
         STA CIOPTR+1
         INY
         LDA (RETADR),Y
         STA ICAX1,X
         LDA #$00
         STA ICAX2,X
         STA ICBLL,X
         STA ICBLH,X
;BUF HOLDS A POINTER?
         LDA DOCFLG
         AND #$04
         BEQ DOCIO_2
         LDY #$00
         LDA (CIOPTR),Y
         STA ICBAL,X
         INY
         LDA (CIOPTR),Y
         STA ICBAH,X
DOCIO_2
;LENGTH GIVEN?
         LDA DOCFLG
         LSR A
         BCC DOCIO_4
         LDY #$06
         LDA (RETADR),Y
         STA CIOPTR
         INY
         LDA (RETADR),Y
         STA CIOPTR+1
         LDY #$00
         LDA (CIOPTR),Y
         STA ICBLL,X
         LDA DOCFLG
         AND #$02
         BEQ DOCIO_4
         INY
         LDA (CIOPTR),Y
         STA ICBLH,X
DOCIO_4
         JSR CIOV
         BPL DOCIO_1
         CPY #ICSTAT.EOF    ;EOF IS NOT AN ERROR
         BNE DISKERR
DOCIO_1
         LDX TMP
         RTS
;GENERIC ERROR HANDLER
DISKERR
         STY VALUE
         JSR GETERRTXT
         LDA #$00
         STA VALUE+1
         LDA # <INP1
         LDY # >INP1
         JSR BIN2DEC
; PRINT "* Error ", THE CODE (128-255: 3 DIGITS) AND TEXT
         LDA #$20
         STA INP1+4         ;SPACE INSTEAD OF EOL
         LDA #DEL
         STA INP1+5
         JSR PRNTNL
         @PRNTLN EMSG,DEL
         @PRNTLN INP1+1,DEL
         @PRNTLN FILE
         JMP NLMENU
;
;RETURN CIO ERROR TEXT | Y-CODE,FILE-TEXT (EMPTY IF UNKNOWN)
;CIO_MSG: CODE, TEXT, EOL, ... , $FF
GETERRTXT
         STY TMP
         LDA # <CIO_MSG
         STA INDPTR
         LDA # >CIO_MSG
         STA INDPTR+1
GETERRTXT_1
         LDY #$00
         LDA (INDPTR),Y
         CMP #$FF           ;END OF LIST?
         BEQ GETERRTXT_4
         CMP TMP
         BEQ GETERRTXT_2
;SKIP THIS MESSAGE
GETERRTXT_5
         INY
         LDA (INDPTR),Y
         CMP #EOL
         BNE GETERRTXT_5
         INY
         TYA
         CLC
         ADC INDPTR
         STA INDPTR
         BCC GETERRTXT_1
         INC INDPTR+1
         BCS GETERRTXT_1
;COPY TEXT AFTER THE CODE
GETERRTXT_2
         INY
         LDA (INDPTR),Y
         STA FILE-1,Y
         CMP #EOL
         BNE GETERRTXT_2
         RTS
GETERRTXT_4
         LDA #EOL
         STA FILE
         RTS
;
;GET A SINGLE CHAR FROM USER
GETCHR
         @MKCAPS
         LDX #KBDID
         LDA #ICM.GB
         STA ICCOM,X
         LDA #0
         STA ICBLL,X
         STA ICBLH,X
         JSR CIOV
         BMI GETCHRERR
;
         CMP #$1B           ;ESCAPE KEY
         BEQ GETCHRERR
; RELAY TO SCREEN
         STA MOD10
         LDA #DEL
         STA MOD10+1
         @PRNTLN MOD10,DEL
;
         LDA MOD10          ;RECALL CHAR
         RTS
GETCHRERR
         JMP NLMENU
;
;GETINP1: READ A LINE INTO INP1 (MAXBUF), Y = # CHARACTERS
GETINP1
         LDX #MAXBUF
         STX TXTLEN
         LDA # <INP1
         LDY # >INP1        ;FALL INTO GETTEXT
;GET A TEXT INPUT FROM USER | Y-RETURN # CHARACTERS | A-LO BYTE INPUT
;Y-HI BYTE INPUT
GETTEXT
         LDX #SCRID
         STA ICBAL,X
         LDA #ICM.GT
         STA ICCOM,X
         TYA
         STA ICBAH,X
         LDA TXTLEN         ;MAX LEN, LONGER->137
         STA ICBLL,X
         LDA #0
         STA ICAX2,X
         JSR CIOV
         BMI GETTEXTERR
         DEC ICBLL,X        ;REMOVE EOL
         LDY ICBLL,X        ;# CHARS READ
         RTS
GETTEXTERR
         CPY #BREAK
         BEQ HANDLEBREAK
         JMP DISKERR        ;NO, IO ERROR
HANDLEBREAK
         JMP GETCOM
;
;PRINT TEXT ON SCREEN | INLINE AFTER JSR: .WORD BUF | X,Y KEPT
;PRNTLN: UP TO AND WITH EOL | PRNTDL: UP TO DEL (NOT PRINTED)
PRNTDL
         LDA #DEL
         BNE PRNTLN_D       ;ALWAYS
PRNTLN
         LDA #EOL
PRNTLN_D
         STA TMP            ;DELIMITER
         STX D0
         STY D1
         LDY #$02
         JSR INLINE         ;.WORD TXT
         LDX #SCRID
         LDA (RETADR),Y
         STA INDPTR+1
         STA ICBAH,X
         DEY
         LDA (RETADR),Y
         STA INDPTR
         STA ICBAL,X
         LDA #ICM.PB
         STA ICCOM,X
         LDA #$00
         STA ICBLH,X
; FIND DELIM
         LDY #$00
PRNTLN_1
         LDA (INDPTR),Y
         INY
         CMP TMP
         BNE PRNTLN_1
         CMP #EOL
         BEQ PRNTLN_2
         DEY                ;REMOVE DEL
PRNTLN_2
         TYA
         STA ICBLL,X
         JSR CIOV
; RESTORE
         LDX D0
         LDY D1
         RTS
;
;PRINT A NEW LINE ON SCREEN
PRNTNL
         @PRNTLN EOLB
         RTS
;
;VALUE (16 BIT) TO DECIMAL TEXT AT A/Y (LO/HI): # CHARS, DIGITS, EOL
;$FF -> 3,"255",EOL
BIN2DEC
         STA INDPTR
         STY INDPTR+1
         LDA VALUE
         STA FR0
         LDA VALUE+1
         STA FR1
         JSR IFP
         JSR FASC
         LDY #$00
         LDX #$FF
; DISREGARD FIRST 0
         LDA LBUFF
         CMP #'0
         BNE BIN2DEC_1
         INX
BIN2DEC_1
         INX
         INY
         LDA LBUFF,X
         STA (INDPTR),Y
         BPL BIN2DEC_1
         AND #$7F
         STA (INDPTR),Y
         INY
         LDA #EOL
         STA (INDPTR),Y
;# CHARS
         DEY
         TYA
         LDY #$00
         STA (INDPTR),Y
         RTS
;COPY UP TO AND WITH EOL | INLINE AFTER JSR: .WORD SRC,DST
;Y = # BYTES COPIED | SEE @CPYMEM
COPY
         LDY #$04
         JSR INLINE
COPY_1
         LDA (RETADR),Y
         STA CPYSRC-1,Y
         DEY
         BNE COPY_1
COPY_3
         LDA (CPYSRC),Y
         STA (CPYDST),Y
         INY
         CMP #EOL
         BNE COPY_3
         RTS
         .IF CPYDST-CPYSRC-2
         JMP CPYDST_MUST_FOLLOW_CPYSRC ;UNDEFINED
         .ENDIF
;
;
;A -> 2 HEX DIGITS AT FILE,Y | Y+2 | X KEPT
HEXOUT
         PHA
         LSR A
         LSR A
         LSR A
         LSR A
         JSR HEXOUT_1
         PLA
         AND #$0F
HEXOUT_1
         CMP #$0A
         BCC HEXOUT_2
         ADC #$06           ;C=1: +7, 10 -> 'A
HEXOUT_2
         ADC #'0
         STA FILE,Y
         INY
         RTS
;
;FILL MEMORY | INLINE AFTER JSR: .WORD ADDR | .BYTE LEN, CHAR
;SEE @FILLMEM | X KEPT
FILL
         STX TMP
         LDY #$04
         JSR INLINE
FILL_1
         LDA (RETADR),Y
         STA CPYSRC-1,Y     ;ADDR, LEN -> CPYDST, CHAR -> CPYDST+1
         DEY
         BNE FILL_1
         LDA CPYDST+1
         LDY CPYDST
FILL_2
         DEY
         STA (CPYSRC),Y
         BNE FILL_2
         LDX TMP
         RTS
;
;DETECT # EXTENDED RAM BANKS | A-# MEM PAGES
DTXMEM
         LDA PORTB
         PHA
         LDA #$00
         STA NUMBKS
; SAVE RAMDISK
         LDX #$7F
DTXMEM_1
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA M4000
         STA BUF,X
         DEX
         BPL DTXMEM_1
; CLR RAM TO TEST
         LDX #$7F
DTXMEM_2
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA #$00
         STA M4000
         DEX
         BPL DTXMEM_2
         LDA #$FF           ;RST POTB
         STA PORTB
         LDA #'K
         STA M4000
; COUNT BANKS
         LDX #$7F
DTXMEM_3
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA M4000
         BNE SKIP
         INC NUMBKS
         LDA #'K
         STA M4000
SKIP     DEX
         BPL DTXMEM_3
; RESTORE RAMDISK
         LDX #$7F
DTXMEM_4
         TXA
         ASL A
         ORA #$01
         STA PORTB
         LDA BUF,X
         STA M4000
         DEX
         BPL DTXMEM_4
         PLA
         STA PORTB
         LDA NUMBKS
         RTS
;
;4 DIGITS DEC TO HEX CONVERT | A-LO BYTE | Y-HI BYTE
DEC2HEX
         STA INBUFF
         STY INBUFF+1
         LDA #$01
         STA CIX
         JSR AFP
         JSR FPI
         LDA FR0
         STA VALUE
         LDA FR1
         STA VALUE+1
         RTS
;
; VARIABLES
;
; ZERO PAGE: SEE SYSTEM.M65
; RESERVED (NOT IN THE FILE): SEE THE END OF EDOSVARS.M65
EMSG     .BYTE "* Error ",DEL
;WORK AREA $3900-$3FFF: BELOW THE $4000 BANK WINDOW, ALWAYS MAPPED
;EDOS MUST END BELOW WRKBEG - CHECKED AT THE END OF EDOS.M65
BUF      = $3E00            ;$100
INP1     = $3D80            ;INPUT/HELPER $80
FILE     = $3D40            ;FILE BUF $40
FSIOV    = $3900            ;DRIVE'S FAST SIO CODE, UP TO FILE
FSIOMAX  = FILE-FSIOV       ;$440 BYTES
WRKBEG   = FSIOV            ;LOWEST WORK AREA ADDR
BANKS    .BYTE $FD
         .BYTE $A3,$A7,$AB,$AF
         .BYTE $E3,$E7,$EB,$EF
         .BYTE $83,$87,$8B,$8F
         .BYTE $C3,$C7,$CB,$CF
;
;LOAD D:EDOS.FNT (1K) BELOW THE SCREEN | SETS FONTPG IF LOADED
;NO ERROR MESSAGES: NO FILE OR NO ROOM KEEPS THE ROM FONT
LDFONT
         LDA RAMTOP
         SEC
         SBC #$08           ;1K PAGE BELOW SCREEN
         AND #$FC
         CMP #$80           ;NOT IN $4000-$7FFF
         BCC LDFONT_1
         STA TMP
         LDX #DSKID1
         LDA #ICM.OP
         STA ICCOM,X
         LDA # <FNTNAM
         STA ICBAL,X
         LDA # >FNTNAM
         STA ICBAH,X
         LDA #ICAX.RD
         STA ICAX1,X
         LDA #$00
         STA ICAX2,X
         JSR CIOV
         BMI LDFONT_2
         LDA #ICM.GB
         STA ICCOM,X
         LDA #$00
         STA ICBAL,X
         STA ICBLL,X
         LDA TMP
         STA ICBAH,X
         LDA #$04           ;$400 BYTES
         STA ICBLH,X
         JSR CIOV
         BMI LDFONT_2
         LDA TMP
         STA FONTPG
LDFONT_2
         JMP CLOSECHANNEL
LDFONT_1
         RTS
FONTPG   .BYTE 0            ;CUSTOM FONT PAGE, 0=ROM
FNTNAM   .BYTE "D:EDOS.FNT",EOL
