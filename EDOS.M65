5840 ;
5850 COMCPY
5860     LDA DSKNUM  ; DEF DSK
5870      @MKASCII
5880     STA TMPDSK
5890 ;
5900      @PRNTLN  COMC
5910     JSR GETFILESPEC
5920     LDA FILE+1  ;CACHE SRC DRV
5930     STA NUM2CNV
5940      @PRNTLN  INST,DEL
5950     JSR GETCHR
5960     CMP #'Y
5970     BEQ COMCPY_2
5980     CMP #'1
5990     BCC COMCPY_1
6000     CMP #'9
6010     BCS COMCPY_1
6020     STA TMPDSK
6030     JMP COMCPY_2
6040 COMCPY_1
6050     JMP COMCPY_4
6060 COMCPY_2
6070     JSR PRNTNL
6080     JSR PRNTNL
6090      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.DR
6100 COMCPY_3
6110     LDA #$12
6120     STA D0
6130      @DOCIO  DSKID1,ICM.GB,FILE,ICAX.DR,D0
6140     CPY #$80
6150     BCS COMCPY_4
6160     LDA #$00
6170     STA D0
6180     LDA #$08
6190     STA D1
6200      @CPYMEM  FILE+$02,INP1,0,D0,D1
6210     LDA #'.
6220     STA INP1+$08
6230     LDA #$09
6240     STA D0
6250     LDA #$03
6260     STA D1
6270      @CPYMEM  FILE+$0A,INP1,0,D0,D1
6280     LDA #EOL
6290     STA INP1+$0C
6300     JSR PROCFILESPEC
6310     LDA NUM2CNV ;RESTORE DRV
6320     STA FILE+1
6330 ;
6340     JSR TRIMSP
6350     JSR FILCPY
6360     JMP COMCPY_3
6370 COMCPY_4
6380     JSR PRNTNL
6390     JMP GETCOM
6400 ;
6410 ;A - READ/WRITE
6420 FILCPY
6430      @COLGRN
6440     LDA #$01
6450     STA ACVMEM
6460     TAX
6470     LDA BANKS,X ; 1ST BANK
6480     STA PORTB
6490 ;
6500     LDA #'-
6510     STA BUF
6520      @CPYMEM  FILE,BUF+1
6530     LDA #DEL
6540     STA BUF,Y
6550      @PRNTLN  BUF,DEL
6560      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.RD
6570 FILCPY_1
6580 ; READ 16K BLCKS
6590 ; INTO XTD MEM
6600     LDA #$00
6610     STA D0
6620     LDA #$40
6630     STA D1
6640 ;
6650      @DOCIO  DSKID2,ICM.GB,M4000,ICAX.RD,D0,D1
6660 ; FULL BANK READ?
6670     LDX #DSKID2
6680     LDA ICBLL,X
6690     BNE FILCPY_4
6700     LDA ICBLH,X
6710     CMP #$40
6720     BNE FILCPY_4
6730 ;SWTCH BNK
6740     INC ACVMEM
6750     LDX ACVMEM
6760     LDA BANKS,X
6770     STA PORTB
6780     JMP FILCPY_1
6790 FILCPY_4
6800 ; CACHE # BYTES READ
6810     LDX #DSKID2
6820     LDA ICBLL,X
6830     STA VALUE
6840     LDA ICBLH,X
6850     STA VALUE+1
6860 ;
6870      @CLOSEIO  DSKID2
6880 ;
6890 ; OPEN NEW FILE FOR SAVE
6900      @COLRED
6910     LDA ACVMEM
6920     STA COUNT   ; # TTL BNKS
6930     LDA TMPDSK
6940     STA FILE+1  ;UPD DRV NUM
6950 ;
6960      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.WT
6970     LDA #$01
6980     STA ACVMEM
6990 FILCPY_5
7000     LDX ACVMEM
7010     LDA BANKS,X
7020     STA PORTB
7030     CPX COUNT   ; LST BNK?
7040     BNE FILCPY_6
7050 ; LST BNK, USE CACHED LEN
7060     LDA VALUE
7070     STA D0
7080     LDA VALUE+1
7090     STA D1
7100     JMP FILCPY_7
7110 FILCPY_6
7120 ; READ FULL BNK
7130     LDA #$00
7140     STA D0
7150     LDA #$40
7160     STA D1
7170 FILCPY_7
