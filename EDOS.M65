4650     LDA FILPOS
4660     STA INDPTR
4670     LDA FILPOS+1
4680     STA INDPTR+1
4690 COMMEM_2
4700     LDA (INDPTR),Y
4710     STA BUF,Y
4720     INY
4730     BPL COMMEM_2
4740 ;
4750     JSR DSPBIN
4760 ;SHW MORE/LESS?
4770      @PRNTLN  VINP,DEL
4780     JSR GETCHR
4790     CMP #'+
4800     BEQ COMMEM_6
4810     CMP #'-
4820     BEQ COMMEM_4
4830     JMP GETCOM
4840 COMMEM_4
4850     LDA FILPOS+1
4860     BNE COMMEM_5
4870     LDA #$00
4880     STA FILPOS
4890     JMP COMMEM_6
4900 COMMEM_5
4910     DEC FILPOS+1
4920 COMMEM_6
4930     JSR PRNTNL
4940     JSR PRNTNL
4950     JMP COMMEM_1
4960 ;
4970 COMNEW
4980      @PRNTLN  COMN
4990     JSR CHKANDUPDSTATBAR
5000      @PRNTLN  DRVN,DEL
5010     JSR GETCHR  ;GET DRV #
5020 ;DRV AVAIL?
5030     STA D0      ;CACHE
5040     SEC
5050     SBC #$30    ;CNVRT TO INDEX
5060     TAX
5070     LDA #$00
5080     SEC
5090 COMNEW_1
5100     ROL A
5110     DEX
5120     CPX #$00
5130     CLC
5140     BNE COMNEW_1
5150     AND DRIVES
5160     BEQ COMNEWERR
5170     LDA D0
5180     STA DISK+1  ;UPD CMD
5190      @RMASCII
5200     STA DSKNUM
5210     JSR UPDSTATBAR
5220     JMP GETCOM
5230 COMNEWERR
5240     JSR PRNTNL
5250     JMP GETCOM
