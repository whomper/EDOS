7660     CMP #$02
7670     BEQ COMDUP_2
7680      @CPYMEM  DDBL,DUPS,0,D0,D1
7690     LDA #$0C
7700     JMP COMDUP_3
7710 COMDUP_1
7720      @CPYMEM  DSNG,DUPS,0,D0,D1
7730     LDA #$06
7740     JMP COMDUP_3
7750 COMDUP_1_5
7760     JMP COMDUP_7
7770 COMDUP_2
7780      @CPYMEM  DENH,DUPS,0,D0,D1
7790     LDA #$09
7800 ;HAVE ENOUGH MEM?
7810 COMDUP_3
7820     CMP NUMBKS
7830     BCS COMDUP_1_5
7840      @PRNTLN  DUPS,DEL
7850     JSR RSTSCTCNT
7860 ; READ
7870     LDA DSKNUM
7880     STA TMPDSK
7890     LDA #$04
7900     STA COLCRS
7910      @PRNTLN  MODR,DEL
7920     LDA #SIO.RD
7930     JSR DSKCPY
7940 ; ASK
7950      @COLRED
7960     JSR PRNTNL
7970     JSR PRNTNL
7980      @PRNTLN  INST,DEL
7990     JSR GETCHR
8000     CMP #'Y
8010     BEQ COMDUP_5
8020     CMP #'1
8030     BCC COMDUP_6
8040     CMP #'9
8050     BCS COMDUP_6
8060 ; UPD DSK #
8070     STA DISK+1
8080      @RMASCII
8090     STA DSKNUM
8100 ;SAME DNSTY?
8110 COMDUP_5
8120      @HIDCUR
8130      @PRNTLN  DELL,DEL
8140     JSR RESETFIO
8150     JSR DTCDNS
8160     PHA
8170     CMP DENSITY
8180     BEQ COMDUP_4
8190 ; FORMAT IF NEEDED
8200     LDA #$04
8210     STA COLCRS
8220      @PRNTLN  MODF,DEL
8230     JSR CLRDUPDSP
8240     JSR DOINIT
8250 ;WRITE
8260 COMDUP_4
8270     JSR RSTSCTCNT
8280     LDA #$04
8290     STA COLCRS
8300      @PRNTLN  MODW,DEL
8310     LDA #SIO.WT
8320     JSR DSKCPY
8330 COMDUP_6
8340 ; RSTR DSK #
8350     LDA TMPDSK
8360     STA DSKNUM
8370      @MKASCII
8380     STA DISK+1
8390 ;
8400      @SHWCUR
8410      @COLDEF
8420     JSR PRNTNL
8430     JMP GETCOM
8440 COMDUP_7
8450      @PRNTLN  NOMM
8460     JSR PRNTNL
8470     JMP GETCOM
8480 ;
8490 ;A - READ/WRITE
8500 DSKCPY
8510     STA D2      ;CACHE
8520     CMP #SIO.RD
8530     BEQ DSKCPY_1
8540     CMP #SIO.WT
8550     BEQ DSKCPY_1
8560     JMP DSKCPY_8 ;ONLY RD/WT
8570 ;PREP XTD MEM
8580 DSKCPY_1
8590      @HIDCUR
8600     LDA #$01
8610     STA ACVMEM
8620     JSR BNK2DEC
8630     LDX #$01
8640     LDA BANKS,X ;1ST BANK
8650     STA PORTB
8660 ; PREP DRV
8670     JSR READFIO
8680     LDA #$31
8690     STA DDEVIC
8700     LDA D2
8710     STA DCOMND
8720     LDA DSKNUM
8730     STA DUNIT
8740     LDA # <M4000
8750     STA DBUFLO
8760     LDA # >M4000
8770     STA DBUFHI
8780     LDA #$07
8790     STA DTIMLO
8800      @SETSCT  $01,$00
8810 ;READ OR WRITE?
8820 DSKCPY_2
8830     LDA DCOMND
8840     CMP #SIO.RD
8850     BEQ DSKCPY_3
8860     LDA #SIOST.WT
8870     JMP DSKCPY_4
8880 DSKCPY_3
8890     LDA #SIOST.RD
8900 ;OPERATION
8910 DSKCPY_4
8920     STA DSTATS
8930     JSR CALLSIO
8940     JSR UPDDUPDSP
8950     JSR INCSCTCNT
8960 ; ADVANCE
8970     CLC
8980     LDA DBUFLO
8990     ADC DBYTLO
9000     STA DBUFLO
9010     LDA DBUFHI
9020     ADC DBYTHI
9030     STA DBUFHI
9040     CMP #$80
9050     BNE DSKCPY_5
9060 ; RST BUF AND INC BNK
9070     LDA # >M4000
9080     STA DBUFHI
9090     INC ACVMEM  ;NXT BNK
9100     LDA ACVMEM
9110     JSR BNK2DEC
9120     LDA ACVMEM
9130     TAX
9140     LDA BANKS,X
9150     STA PORTB
9160 ;NEXT SECTOR
9170 DSKCPY_5
9180     INC DAUX1
9190     BNE DSKCPY_6
9200     INC DAUX2
9210 DSKCPY_6
9220 ; DONE READ?
9230     LDA DENSITY
9240     CMP #$02
9250     BEQ DSKCPY_7
9260 ; 720 SCTRS
9270     LDA DAUX2
9280     CMP #$02
9290     BNE DSKCPY_9
9300     LDA DAUX1
9310     CMP #$D1
9320     BNE DSKCPY_9
9330     JMP DSKCPY_8
9340 ;1040 SCTRS
9350 DSKCPY_7
9360     LDA DAUX2
9370     CMP #$04
9380     BNE DSKCPY_9
9390     LDA DAUX1
9400     CMP #$11
9410     BNE DSKCPY_9
9420 DSKCPY_8
9430      @SHWCUR
9440     LDA BANKS
9450     STA PORTB   ; RESTORE
9460     RTS
9470 DSKCPY_9
9480     JMP DSKCPY_2
9490 ;
9500 CLRDUPDSP
9510     LDA #$17
9520     STA COLCRS
9530      @PRNTLN  DUPE,DEL
9540     LDA #$1E
9550     STA COLCRS
9560      @PRNTLN  DUPE,DEL
9570     RTS
9580 ;
9590 UPDDUPDSP
9600     LDA #$17
9610     STA COLCRS
9620      @PRNTLN  SCTR,DEL
9630     LDA #$1E
9640     STA COLCRS
9650      @PRNTLN  MEMD+1,DEL
9660     RTS
9670 ;
9680 ;A 1-SNGL,2-ENHA,3-DBLE
9690 SETDRVSTAT
9700     PHA
9710     LDA #$00
9720     STA D0
9730     LDA #$12
9740     STA D1
9750     PLA
9760     CMP #$01
9770     BNE TSTENHA
9780      @CPYMEM  SNGL,BUF,0,D0,D1
9790     JMP SETDRVSTAT_1
9800 TSTENHA
9810     CMP #$02
9820     BNE TSTDBLE
9830      @CPYMEM  ENHA,BUF,0,D0,D1
9840     JMP SETDRVSTAT_1
9850 TSTDBLE
9860     CMP #$03
9870     BNE SETDRVSTAT_2
9880      @CPYMEM  DBLE,BUF,0,D0,D1
9890 SETDRVSTAT_1
9900      @DOSIO  SIO.WP,SIOST.WT,BUF,$07,$0B,$00
9910     JSR DOSIO
9920 SETDRVSTAT_2
9930     RTS
9940 ;
9950 ;A 2-ENH, BUF-RSLT
9960 FRMTDRV
9970     CMP #$02
9980     BNE FRMTDRV_1
9990     LDA #SIO.FH
010000   STA D2
010010   JMP FRMTDRV_2
010020 FRMTDRV_1
010030   LDA #SIO.FT
010040   STA D2
010050 FRMTDRV_2
010060    @DOSIO  D2,SIOST.RD,BUF,$E0,$80,$00
010070   JSR DOSIO
010080   RTS
010090 ;
010100 COMERA
010110    @PRNTLN  COME
010120 ;
010130   JSR GETFILESPEC
010140   JSR AREYOUSURE
010150   CMP #'Y
010160   BEQ DOERASE ;EXEC RENAME
010170   JMP GETCOM
010180 DOERASE
010190   JSR PRNTNL
010200    @DOCIO  DSKID1,ICM.ER,FILE,0
010210   JMP GETCOM
010220 ;
010230 COMINI
010240    @PRNTLN  COMI
010250    @PRNTLN  FMTD,DEL
010260   JSR GETCHR
010270    @RMASCII
010280   STA DENSITY
010290   JSR PRNTNL
010300   JSR PRNTNL
010310 ;
010320    @COLRED
010330   LDA DSKNUM
010340    @MKASCII
010350   STA FRMT+$0C
010360    @PRNTLN  FRMT,DEL
010370    @PRNTLN  ARYS,DEL
010380   JSR GETCHR
010390   CMP #'Y
010400   BEQ COMINI_1
010410   JMP GETCOM
010420 COMINI_1
010430   JSR DOINIT
010440   JSR PRNTNL
010450   JMP GETCOM
010460 ;
010470 ;1-SNG,2-ENH,3-DBL
010480 DOINIT
010490   LDA DENSITY
010500   CMP #$02
010510   BEQ DOINIT_1
010520 ; SNGL/DBLE
010530   JSR SETDRVSTAT
010540    @DOCIO  DSKID1,ICM.FT,DISK,0
010550   RTS
010560 DOINIT_1
010570   LDA #$02    ;ENHA
010580   JSR FRMTDRV
010590   JSR WRTVTOC
010600   RTS
010610 ;
010620 WRTVTOC
010630 ; VTOC
010640    @CPYMEM  VTOC,BUF
010650    @FILLMEM  BUF+11,$58,$FF
010660   LDA #$00
010670   STA BUF+55
010680   LDA #$7F
010690   STA BUF+56
010700    @FILLMEM  BUF+$64,$1C,$00
010710   LDA #$68
010720   LDY #$01
010730   JSR WRTSCT
010740 ; VTOC II
010750    @FILLMEM  BUF,$80,$FF
010760   LDA #$00
010770   STA BUF+39
010780   LDA #$7F
010790   STA BUF+40
010800   STA BUF+84
010810   LDA #$2F
010820   STA BUF+122
010830   LDA #$01
010840   STA BUF+123
010850   LDA #$00
010860   STA BUF+124
010870   STA BUF+125
010880   STA BUF+126
010890   STA BUF+127
010900 ;
010910   LDA #$00
010920   LDY #$04
010930   JSR WRTSCT
010940   RTS
010950 ;
010960 COMPRC
010970    @PRNTLN  COMP
010980   JSR GETFILESPEC
010990    @DOCIO  DSKID1,ICM.PC,FILE,0
011000   JMP GETCOM
011010 ;
011020 COMUNP
011030    @PRNTLN  COMU
011040   JSR GETFILESPEC
011050    @DOCIO  DSKID1,ICM.UP,FILE,0
011060   JMP GETCOM
011070 ;
011080 COMREN
011090    @PRNTLN  COMR
011100 ; GET OLD FILE SPEC
011110    @PRNTLN  RENO,DEL
011120    @INPRM  INP1
011130   JSR GETTEXT
011140   JSR PROCFILESPEC
011150    @CPYMEM  FILE,BUF
011160   DEX
011170   LDA #',
011180   STA BUF,X
011190   INX
011200   STX D2
011210 ; GET NEW FILE SPEC
011220    @PRNTLN  RENN,DEL
011230    @INPRM  INP1
011240   JSR GETTEXT
011250    @CPYMEM  INP1,BUF,0,D2
011260   JSR AREYOUSURE
011270   CMP #'Y
011280   BEQ DORENAME
011290   JMP GETCOM
011300 DORENAME
011310   JSR PRNTNL
011320    @PRNTLN  BUF
011330 ; EXECUTE COMMAND
011340    @DOCIO  DSKID1,ICM.RN,BUF,0
011350   JMP GETCOM
011360 ;
011370 COMWRT
011380    @PRNTLN  COMW
011390   JSR AREYOUSURE
011400   CMP #'Y
011410   BEQ COMWRT_1
011420   JMP GETCOM
011430 COMWRT_1
011440    @CPYMEM  EDOS,INP1
011450   JSR PROCFILESPEC
011460   LDA # <START_PROG
011470   STA FILPOS
011480   LDA # >START_PROG
011490   STA FILPOS+1
011500   LDA # <END_PROG
011510   STA FILEND
011520   LDA # >END_PROG
011530   STA FILEND+1
011540   DEC FILEND
011550   LDA # >PRE_START
011560   JSR BIN2HEX
011570   LDA D1
011580   STA MEMD
011590   LDA D0
011600   STA MEMD+1
011610   LDA # <PRE_START
011620   JSR BIN2HEX
011630   LDA D1
011640   STA MEMD+2
011650   LDA D0
011660   STA MEMD+3
011670   LDA #EOL
011680   STA MEMD+4
011690   JMP DOSAVE
011700 ;
011710 COMSAV
011720    @PRNTLN  COMS
011730   JSR GETFILESPEC
011740 ; GET START - BUF
011750    @PRNTLN  FLST,DEL
011760    @INPRM  BUF
011770   JSR GETTEXT
011780 ; GET END - INP1
011790    @PRNTLN  FLED,DEL
011800    @INPRM  INP1
011810   JSR GETTEXT
011820 ; GET RUN
011830    @PRNTLN  FLRN,DEL
011840    @INPRM  MEMD
011850   JSR GETTEXT
011860 ; CNVRT END TO ADDR
011870   JSR INP2ADDR
011880   LDA FILPOS
011890   STA FILEND
011900   LDA FILPOS+1
011910   STA FILEND+1
011920 ; CNVRT STRU TO ADDR
011930    @CPYMEM  BUF,INP1
011940   JSR INP2ADDR
011950 DOSAVE
011960 ; SAVE HEADER
011970   LDA #$FF
011980   STA BUF
011990   STA BUF+1
012000   LDA FILPOS
012010   STA BUF+2
012020   LDA FILPOS+1
012030   STA BUF+3
012040   LDA FILEND
012050   STA BUF+4
012060   LDA FILEND+1
012070   STA BUF+5
012080    @DOCIO  DSKID1,ICM.OP,FILE,ICAX.WT
012090   LDA #$06
012100   STA D0
012110    @DOCIO  DSKID1,ICM.PB,BUF,ICAX.WT,D0
012120 ;SAVE BIN DATA, CALC LEN
012130   SEC
012140   LDA FILEND
012150   SBC FILPOS
012160   STA FILLEN
012170   INC FILLEN
012180   LDA FILEND+1
012190   SBC FILPOS+1
012200   STA FILLEN+1
012210 ; SAVE
012220    @DOCIO  DSKID1,ICM.PB,FILPOS,ICAX.WT,FILLEN,FILLEN+1,1
012230 ; WRITE RUNAD
012240    @CPYMEM  MEMD,INP1
012250   LDY #$04    ; 4 CHR
012260   JSR INP2ADDR
012270   LDA #$E0
012280   STA BUF
012290   LDA #$02
012300   STA BUF+1
012310   LDA #$E1
012320   STA BUF+2
012330   LDA #$02
012340   STA BUF+3
012350   LDA FILPOS
012360   STA BUF+4
012370   LDA FILPOS+1
012380   STA BUF+5
012390   LDA #$06
012400   STA D0
012410    @DOCIO  DSKID1,ICM.PB,BUF,ICAX.WT,D0
012420   JMP GETCOM
012430 ;
012440 COMGOT
012450    @PRNTLN  COMG
012460    @PRNTLN  GOTA,DEL
012470    @INPRM  INP1
012480   JSR GETTEXT
012490   JSR INP2ADDR
012500   JSR PRPEXT
012510   JMP (FILPOS) ;GOTO ADDR
012520 ;
012530 AREYOUSURE
012540    @COLRED
012550    @PRNTLN  ARYS,DEL
012560   JSR GETCHR  ;INPUT PLEASE
012570   RTS
012580 ;
012590 READIR
012600   LDA #0
012610   STA COUNT   ;ZERO COUNTER
012620   STA FILPOS  ;1ST FILE
012630 ;READ LOOP
012640 READLOOP
012650   LDA #$12
012660   STA D0
012670    @DOCIO  DSKID1,ICM.GB,FILE,ICAX.DR,D0
012680   INC COUNT
012690   BMI FINALIZE ;HANDLE END DIR
012700 ; FREE SECTORS OR FILE?
012710   LDA FILE+1  ;FREE SECTORS?
012720   CMP #$20    ;SPACE MEANS NO
012730   BEQ NRMLFILE ;FILE ENTRY
012740 ;FREE SECTORS
012750 FREESEC
012760   DEC COUNT   ;REMOVE FREE SEC
012770 ; IF POS 0, BUF PRINTED, RD FILE
012780   LDA FILPOS
012790   CMP #0      ;PRINT?
012800   BEQ PRNTFREESEC ;DONT PRINT
012810   LDA #EOL
012820   STA BUF+$12
012830    @PRNTLN  BUF,$13
012840 ;DISPLAY FREE SECTORS
012850 PRNTFREESEC
012860    @PRNTLN  FILE
012870   RTS
012880 ;USE 2 COLUMNS
012890 NRMLFILE
012900   LDA FILPOS
012910   CMP #0      ;MEANS FILE 1
012920   BEQ ADD2ND
012930    @CPYMEM  FILE,BUF,0,FILPOS
012940   LDA #0      ;RESET LINE
012950   STA FILPOS
012960    @PRNTLN  BUF,$24
012970   JMP READLOOP ;NEXT FILE
012980 ADD2ND
012990    @CPYMEM  FILE,BUF,0,FILPOS
013000   LDA #$20    ;ADD SPACE
013010   STA BUF+$11 ;BETWEEN CLMNS
013020   LDA #$12    ;2ND TXT POS
013030   STA FILPOS
013040   JMP READLOOP ;ADD 2ND FILE
013050 FINALIZE
013060   CPY #ICSTAT.EOF
013070   BNE COMDIRERR
013080   JMP FREESEC
013090   RTS
013100 COMDIRERR
013110   JMP DISKERR
013120 ;
013130 CLOSEIO
013140    @CLOSEIO  DSKID1
013150    @CLOSEIO  DSKID2
013160    @CLOSEIO  KBDID
013170   RTS
013180 ;
013190 DISPLAYCHECKING
013200    @HIDCUR
013210    @CHECURPOS
013220   LDA #$03
013230   STA ROWCRS
013240   LDA #$02
013250   STA COLCRS
013260    @PRNTLN  UPDT,DEL
013270    @RSTCURPOS
013280    @SHWCUR
013290   RTS
013300 ;
013310 ;DRVS WE HAVE? HS?
013320 CHKDRVS
013330 ; UPD MSG
013340    @SIOSNDOFF
013350   STA DRIVES  ;ZERO BITS
013360   STA DRVHS
013370   LDA #$01
013380   STA BITWISE ;1ST DRV
013390   LDA #$01
013400   STA DUNIT
013410 CHKDRV_0
013420    @DOSIO  SIO.ST,SIOST.RD,BUF,$07,$04,$00,CNGDSK
013430   LDA #$00
013440   STA D0
013450   JSR DOSIO
013460   CPY #$01
013470   BNE CHKDRV_4
013480 ; SPEEDY DRV?
013490    @DOSIO  SIO.HS,SIOST.RD,BUF,$01,$01,$00,CNGDSK
013500   JSR DOSIO
013510   LDA BUF
013520   CMP #$09
013530   BEQ CHKDRV_1
013540   CMP #$0A
013550   BEQ CHKDRV_1
013560   JMP CHKDRV_2
013570 CHKDRV_1
013580   LDA DRVHS
013590   ORA BITWISE
013600   STA DRVHS
013610 ;1 BIT FOR CONN DRV
013620 CHKDRV_2
013630   LDA DRIVES
013640   ORA BITWISE
013650   STA DRIVES
013660   ASL BITWISE ;NXT DRV BIT
013670   INC DUNIT
013680   LDA DUNIT
013690   CMP #$09
013700   BNE CHKDRV_5
013710 CHKDRV_4
013720    @SIOSNDON
013730   RTS
013740 CHKDRV_5
013750   JMP CHKDRV_0
013760 ;
013770 UPDDRVSPD
013780   LDA #$0E
013790   STA D0
013800   LDA #$04
013810   STA D1
013820   LDA DSKNUM
013830   TAY
013840   SEC
013850   LDA #$00
013860 UPDRVSPD_0
013870   ROL A
013880   DEY
013890   BNE UPDRVSPD_0
013900 ; IS IT HS?
013910   AND DRVHS
013920   BNE UPDRVSPD_1
013930    @CPYMEM  DRGN,STAT,0,D0,D1
013940   RTS
013950 UPDRVSPD_1
013960    @CPYMEM  DRSP,STAT,0,D0,D1
013970   RTS
013980 ;
013990 UPDDRVS
014000   LDX #$03    ;POS IN DRVS TXT
014010   LDA #$01
014020   STA D0      ;DRV INDX
014030   ORA #'0
014040   STA D2      ;PRNT CHR
014050   LDA DRIVES
014060   STA D1      ;TEMP
014070 UPTDRV_0
014080   LSR D1
014090   BCC UPTDRV_4
014100 UPTDRV_1 ;    IS ACTV?
014110   LDA D0
014120   SEC
014130   SBC DSKNUM
014140   BNE UPTDRV_3
014150 UPTDRV_2 ;    ACTV DRV
014160   LDA D2
014170   ORA #$80
014180   STA STAT,X
014190   JMP UPTDRV_5
014200 UPTDRV_3 ;    CNNCT DRV
014210   LDA D2
014220   STA STAT,X
014230   JMP UPTDRV_5
014240 ; SPACES 4 NO DRV
014250 UPTDRV_4 ;    EMPTY DRV
014260   LDA #$20
014270   STA STAT,X
014280 UPTDRV_5 ;    NXT DRV #
014290   INX
014300   INC D0
014310   INC D2
014320   LDA D0
014330   CMP #$09
014340   BNE UPTDRV_0
014350   RTS
014360 ;
014370 UPDMEM
014380   JSR DTXMEM
014390   JSR BNK2DEC
014400   LDA #$19
014410   STA D0
014420   LDX MEMD
014430   INX
014440   STX D1
014450    @CPYMEM  MEMD+1,STAT,0,D0,D1
014460   RTS
014470 ;
014480 ;CHKANDUPDATESTATBAR
014490 CHKANDUPDSTATBAR
014500   JSR DISPLAYCHECKING
014510   JSR CHKDRVS
014520   JSR UPDMEM
014530 ;
014540 UPDSTATBAR
014550   JSR UPDDRVS
014560   JSR UPDDRVSPD
014570    @HIDCUR
014580    @CHECURPOS
014590   LDA #$03
014600   STA ROWCRS
014610   LDA #$02
014620   STA COLCRS
014630    @PRNTLN  STAT
014640    @SHWCUR
014650    @RSTCURPOS
014660   RTS
014670 ;MENU COMM LOOKUP TABLE
014680 COMMAND
014690   .BYTE $46, <COMDIR, >COMDIR,$54, <COMCAR, >COMCAR,$43, <COMCPY, >COMCPY
014700   .BYTE $44, <COMDUP, >COMDUP,$45, <COMERA, >COMERA,$49, <COMINI, >COMINI
014710   .BYTE $56, <COMVIE, >COMVIE,$41, <COMANA, >COMANA,$50, <COMPRC, >COMPRC
014720   .BYTE $55, <COMUNP, >COMUNP,$52, <COMREN, >COMREN,$53, <COMSAV, >COMSAV
014730   .BYTE $4C, <COMLOA, >COMLOA,$47, <COMGOT, >COMGOT,$4E, <COMNEW, >COMNEW
014740   .BYTE $4D, <COMMEM, >COMMEM,$42, <COMCMP, >COMCMP,$57, <COMWRT, >COMWRT
014750   .BYTE $51, <COMQIT, >COMQIT,EOL, <GOMENU, >GOMENU,$FF
014760 ;
