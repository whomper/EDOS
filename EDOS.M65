3300     JSR GETCHR
3310     CMP #'+
3320     BEQ COMANA_2
3330     CMP #'-
3340     BEQ COMANA_3
3350     JMP GETCOM
3360 COMANA_2
3370     INC DAUX1
3380     BNE COMANA_5
3390     INC DAUX2
3400     JMP COMANA_5
3410 COMANA_3
3420     LDA DAUX1
3430     BNE COMANA_4
3440     LDA DAUX2
3450     BEQ COMANA_1
3460     DEC DAUX2
3470 COMANA_4
3480     DEC DAUX1
3490 COMANA_5
3500     JSR PRNTNL
3510     JSR PRNTNL
3520     JMP COMANA_0
