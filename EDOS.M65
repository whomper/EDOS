3710 ;OPEN FILES
3720      @DOCIO  DSKID1,ICM.OP,BUF,ICAX.RD
3730      @DOCIO  DSKID2,ICM.OP,FILE,ICAX.RD
3740 ;LOOP & CMPR BLOCKS OF $FF
3750 COMCMP_1
3760     LDA #$00
3770     STA D1
3780     LDA #$FF
3790     STA D0
3800      @DOCIO  DSKID1,ICM.GB,M4000,ICAX.RD,D0,D1
3810     LDX #DSKID1
3820     JSR CHKEOF
3830      @DOCIO  DSKID2,ICM.GB,M5000,ICAX.RD,D0,D1
3840     LDX #DSKID2
3850     JSR CHKEOF
3860 ;CMPR 2 BUFS
3870     LDX #$00
3880 COMCMP_2
3890     LDA M4000,X
3900     CMP M5000,X
3910     BNE COMCMP_3
3920     INX
3930     CPX BYTRD   ;ACTUAL READ
3940     BNE COMCMP_2
3950 ;ABORT?
3960     LDA ABORT
3970     BNE COMCMP_4
3980     JMP COMCMP_1 ;READ NXT
3990 ;DIFFERENT
4000 COMCMP_3
4010      @PRNTLN  BDIF
4020     JMP COMCMP_5
4030 ;SAME
4040 COMCMP_4
4050      @PRNTLN  BSAM
4060 COMCMP_5
4070      @CLOSEIO  DSKID1
4080      @CLOSEIO  DSKID2
4090     JMP GETCOM
4100 ;
4110 CHKEOF
4120     CPY #ICSTAT.EOF
4130     BNE CHKEOF_1
4140     LDA #$01
4150     STA ABORT
4160 CHKEOF_1
4170     LDA ICBLL,X
4180     CMP BYTRD   ;MIN BYTES 2 CPR
4190     BCS CHKEOF_2
4200     STA BYTRD
4210 CHKEOF_2
4220     RTS
4230 ;
4240 COMMEM
4250      @PRNTLN  COMM
4260 ;GET LOW MEM
4270     LDA MEMLO+1
4280     JSR BIN2HEX
4290     LDA D1
4300     STA MEMS+$04
4310     LDA D0
4320     STA MEMS+$05
4330     LDA MEMLO
4340     JSR BIN2HEX
4350     LDA D1
4360     STA MEMS+$06
4370     LDA D0
4380     STA MEMS+$07
4390 ;GET HIGH MEM
4400     LDA MEMTOP+1
4410     JSR BIN2HEX
4420     LDA D1
4430     STA MEMS+$0F
4440     LDA D0
4450     STA MEMS+$10
4460     LDA MEMTOP
4470     JSR BIN2HEX
4480     LDA D1
4490     STA MEMS+$11
4500     LDA D0
4510     STA MEMS+$12
4520     LDA #EOL
4530     STA MEMS+$13
4540 ;GET ADDRESS
4550      @PRNTLN  GOTA,DEL
4560      @INPRM  INP1
4570     JSR GETTEXT
4580     JSR INP2ADDR
4590 ;
4600      @PRNTLN  MEMS
4610     JSR PRNTNL
4620 ;COPY MEMORY
4630 COMMEM_1
