90       .INCLUDE #D:MACROS.M65
0100 ; .ENDIF
0110 ;
0120     *=  $1E00
0130 ;
0140 START_PROG
0150     JMP PRE_START
0160     .INCLUDE #D:SYSTEM.M65
0170     .INCLUDE #D:CIOSTAT.M65
0180     .INCLUDE #D:UTILS.M65
0190 ;
0200 ;START
0210 PRE_START
0220 ; HAVE WE SET DOSINI?
0230     LDA DOSINI+1
0240     CMP # >START
0250     BEQ STARTING
0260 ; CACHE DOSINI ONLY ON 1ST RUN
0270     LDA DOSINI
0280     STA DOSIN
0290     LDA DOSINI+1
0300     STA DOSIN+1
0310 STARTING
0320     LDA DOSIN
0330     STA START+1
0340     LDA DOSIN+1
0350     STA START+2
0360     LDA # <START
0370     STA DOSINI
0380     LDA # >START
0390     STA DOSINI+1
0400 ;
0410 START
0420     JSR START   ;TROJAN
0430     LDA #$40    ;UPRCS ONLY
0440     STA SHFLOK
0450     LDA #$09    ;D1 SCR POS
0460     STA PRVPOS
0470     LDA #$02    ;SET SCR MARGINS
0480     STA LMARGN
0490     LDA #$27
0500     STA RMARGN
0510     LDA PORTB
0520     STA BANKS   ;CACHE 1ST PLC
0530     LDA #1
0540     STA DSKNUM  ;INIT DEFAULT DRIVE
0550      @HIDCHR
0560      @SETRTNA  GETCOM
0570 ;
0580 GOMENU
0590      @HIDCHR
0600      @PRNTLN  TTL1,DEL
0610      @DRAW  CHL,$00,$24
0620      @PRNTLN  TTL2
0630      @DRAW  CHL,$00,$24
0640 ;
0650     LDA REFDRV
0660     CMP #$00
0670     BEQ GOMENU_1
0680     JSR CHKANDUPDSTATBAR
0690 GOMENU_1
0700     LDA #$00
0710     STA REFDRV
0720      @PRNTLN  STAT
0730     LDA #$03
0740     STA LMARGN
0750      @DRAW  CHL,$00,$24
0760      @PRNTLN  MNU1,DEL
0770      @PRNTLN  MNU2,DEL
0780     LDA #$02
0790     STA LMARGN
0800     JSR PRNTNL
0810 GETCOM
0820      @COLDEF
0830     JSR RESETFIO
0840     JSR CLOSEIO
0850      @DOCIO  KBDID,ICM.OP,KYBD,ICAX.RD
0860     LDA BANKS
0870     STA PORTB   ; RESET
0880      @SHWCUR
0890      @SIOSNDON
0900      @PRNTLN  ANYK,DEL
0910     JSR GETCHR
0920 ;DIGITS?
0930     CMP #'1
0940     BCC FINDCM
0950     CMP #'9
0960     BCS FINDCM
0970     JMP COMDIG
0980 FINDCM
0990     LDX #$00
1000     TAY
1010 FINDCM_1
1020     TYA
1030     CMP COMMAND,X
1040     BEQ FOUND
1050     LDA COMMAND,X
1060     CMP #$FF
1070     BEQ NOTFND
1080     INX
1090     INX
1100     INX
1110     JMP FINDCM_1
1120 FOUND
1130     LDA COMMAND+1,X
1140     STA INDPTR
1150     LDA COMMAND+2,X
1160     STA INDPTR+1
1170     JMP (INDPTR)
1180 NOTFND
1190     JMP GETCOM
1200 ;
1210 COMLOA
1220     LDA #$00
1230     STA COUNT   ;RESET COUNTER
1240      @PRNTLN  COML
1250     JSR GETFILESPEC
1260      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.RD
1270 ; READ FILE HEADER
1280     LDA #$02
1290     STA D0
1300      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
1310 ; BINARY?
1320     LDA BUF
1330     AND BUF+1
1340     CMP #$FF
1350     BEQ COMLOA_1
1360     JMP COMLOA_3
1370 ;READ SECTION
1380 COMLOA_1
1390     LDA #$04
1400     STA D0
1410      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
1420     CPY #ICSTAT.EOF
1430     BEQ COMLOA_1_5
1440 ; GET START & LEN
1450     LDA BUF
1460     STA FILPOS
1470     LDA BUF+1
1480     STA FILPOS+1
1490     LDA BUF+2
1500     SEC
1510     SBC FILPOS
1520     STA FILLEN
1530     INC FILLEN
1540     LDA BUF+3
1550     SBC FILPOS+1
1560     STA FILLEN+1
1570      @DOCIO  DSKID1,ICM.GB,FILPOS,ICAX.RD,FILLEN,FILLEN+1,1
1580     CPY #ICSTAT.EOF
1590     BEQ COMLOA_4
1600     BMI COMLOA_5
1610     JMP COMLOA_1
1620 COMLOA_1_5
1630      @PRNTLN  RUNP,DEL
1640     JSR GETCHR
1650     CMP #'Y
1660     BNE COMLOA_4
1670     JSR CLOSEIO
1680     JMP (RUNAD) ;RUN PROGRAM
1690 COMLOA_3
1700      @PRNTLN  NOTB
1710 COMLOA_4
