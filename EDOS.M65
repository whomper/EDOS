5380     JMP (DOSVEC)
5390 COMDIG
5400     STA INP1
5410     LDA #':
5420     STA INP1+1
5430     LDA #EOL
5440     STA INP1+2
5450     JSR PROCFILESPEC
5460     JSR PRNTNL
5470     JMP COMDIR_1
5480 ;
5490 COMDIR
5500      @PRNTLN  COMF
5510     JSR GETFILESPEC
5520 COMDIR_1
5530      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.DR
5540     JSR READIR
5550     JSR PRNTNL
5560 ; DSP TOT FIL CNT
5570     LDA COUNT
5580     STA VALUE
5590     LDA #$00
5600     STA VALUE+1
5610      @PTR2STK  INP1
5620      @WRD2STK  VALUE
5630     JSR BIN2DEC
5640      @CPYMEM  INP1+1,NUMF+$11
5650 ;
5660      @PRNTLN  NUMF
5670     JSR PRNTNL
5680     JMP GETCOM
5690 ;
5700 COMCAR
5710      @PRNTLN  COMT
5720 ;
