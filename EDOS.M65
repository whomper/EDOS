7190     LDA ACVMEM
7200     CMP COUNT
7210     BEQ FILCPY_8
7220     INC ACVMEM
7230     JMP FILCPY_5
7240 FILCPY_8
7250      @CLOSEIO  DSKID2
7260     LDA BANKS
7270     STA PORTB   ; RESTORE
7280     JSR PRNTNL
7290     RTS
7300 ;
