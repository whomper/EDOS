;
; EDOS.M65 - EDOS 3.5
; Options, origin and the includes
; Copyright (C) 2026 AERA | Erez Yaary
;
; To assemble it on the Atari, in
; MAC/65: LOAD #D:EDOS.M65, then
; ASM ,,#D:EDOS.COM writes EDOS.COM
; Only this short file is held in
; the editor's memory; .INCLUDE reads
; the rest from the disk as it goes.
;
         .OPT OBJ,NO LIST
;
; xl's OS names first (zero page
; before use), then the macros
;
         .INCLUDE #D:AXEQU.M65
         .INCLUDE #D:MACROS.M65
;
; The load check (xl's AXLOAD), run
; before the rest loads: MEMLO up to
; $1E00; MEMTOP from $8000, so the
; screen is above the banks' window
; ($4000-$7FFF) and Byte Compare has
; $4000-$50FF. At $3F00, not loaded
;
AXLOW    = $1E00
AXHIGH   = $8000
         *= $3F00
AXLOWM   .BYTE "EDOS loads at $1E00: MEMLO is above it",EOL
AXROOMM  .BYTE "EDOS needs memory up to $8000",EOL
         .INCLUDE #D:AXLOAD.M65
;
; EDOS loads and runs at $1E00
;
         *= AXLOW
;
; START_PROG - the first byte of EDOS
; (COMWRT saves it from here): a jump
; to PRE_START, the run address
; Exit: to PRE_START
;
START_PROG
         JMP PRE_START
         .INCLUDE #D:SYSTEM.M65
         .INCLUDE #D:UTILS.M65
         .INCLUDE #D:KEYS.M65
;
; xl's shared code: RESET back into
; EDOS, AERA.FNT, the texts of CIO's
; and DOS's errors
;
AXWARM   = START            ; RESET, after DOS's init
AXPTR    = INDPTR           ; lent to AXERR
AXERRS   = 2                ; DOS's disk errors too
         .INCLUDE #D:AXRESET.M65
         .INCLUDE #D:AXFONT.M65
         .INCLUDE #D:AXERR.M65
         .INCLUDE #D:EDOSMAIN.M65
         .INCLUDE #D:EDOSCMD.M65
         .INCLUDE #D:EDOSDISK.M65
         .INCLUDE #D:EDOSSCRN.M65
         .INCLUDE #D:EDOSVARS.M65
;
; EDOS and its variables (VAREND)
; must end below the work area
;
         .IF VAREND>WRKBEG
         JMP EDOS_OVERLAPS_WORK_AREA ; undefined: stops assembly
         .ENDIF
;
; The run address: PRE_START
;
         *= RUNAD
         .WORD PRE_START
