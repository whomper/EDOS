1770 GETFILESPEC
1780      @PRNTLN  FSPC,DEL
1790      @INPRM  INP1
1800     JSR GETTEXT
1810     JSR PROCFILESPEC
1820     RTS
1830 ;
1840 ;IN-INP1,OUT-FILE
1850 PROCFILESPEC
1860 ; EMPTY INP? USE DEF
1870     LDA INP1
1880     CMP #EOL    ;EMPTY?
1890     BEQ DEFDSKID ;USE DEF
1900 ; 3RD CHAR ':'? FND ARGS
1910     LDA INP1+2
1920     CMP #':
1930     BEQ CMPLTSTRCT ;YES
1940 ; 2ND CHR :?->NO D, INSRT
1950     LDA INP1+1
1960     CMP #':
1970     BEQ CMPLTSTRCT ;YES
1980 ;
1990 ; INP IS JST ARGS? D#+INP ARGS
2000      @CPYMEM  DISK,FILE ;DEF D#
2010      @CPYMEM  INP1,FILE+3 ;ADD
2020     JMP PREPRTN
2030 ;INP GOOD, USE IT
2040 CMPLTSTRCT
2050 ; 1ST CHR NO D? INSRT IT
2060     LDX #$00
2070     LDY #$00
2080     LDA INP1+1
2090     CMP #':
2100     BNE CONTPROC
2110     LDY #$01
2120     LDA #'D
2130     STA FILE
2140 CONTPROC
2150     LDA INP1,X
2160     STA FILE,Y
2170     INX
2180     INY
2190     CMP #EOL
2200     BNE CONTPROC
2210 ;
2220     LDA FILE+3
2230     CMP #EOL    ;HAVE ARGS?
2240     BNE PREPRTN ;YES, RETURN
2250      @CPYMEM  ARGS,FILE+3
2260     JMP PREPRTN
2270 DEFDSKID
2280      @CPYMEM  DISK,FILE
2290 PREPRTN
2300     RTS
2310 ;
2320 COMVIE
2330      @FILLMEM  BUF,$FF,$20
2340      @PRNTLN  COMV
2350     JSR GETFILESPEC
2360 ; GET START
2370      @PRNTLN  FLST,DEL
2380      @INPRM  INP1
2390     JSR GETTEXT
2400     JSR INP2ADDR
2410      @DOCIO  DSKID1,ICM.OP,FILE,ICAX.RD
2420 ; READ FILE TILL POS
2430     LDA FILPOS+1
2440     BEQ COMVIE_1 ;NO HI BYTE
2450     LDA #$00
2460     STA D0
2470     LDA #$01
2480     STA D1
2490     LDX FILPOS+1
2500 COMVIE_0
2510      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0,D1
2520     CPY #ICSTAT.EOF
2530     BEQ COMVIE_3
2540     DEX
2550     BNE COMVIE_0
2560 COMVIE_1
2570     LDA FILPOS
2580     STA D0
2590     BEQ COMVIE_2 ;NO LO BYTE
2600      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
2610     CPY #ICSTAT.EOF
2620     BEQ COMVIE_3
2630 ;READ AND DSP
2640 COMVIE_2
2650     JSR PRNTNL
2660     LDA #$80
2670     STA D0
2680      @DOCIO  DSKID1,ICM.GB,BUF,ICAX.RD,D0
2690     LDA #$00
2700     STA ABORT   ;CLR FLG
2710     LDX #DSKID1
2720     LDA ICBLL,X ;BYTES READ?
2730     STA BYTRD
2740     JSR DSPBIN
2750     JSR PRNTNL
2760     LDA ABORT
2770     BNE COMVIE_3
2780 ; VIEW MORE?
2790      @PRNTLN  VIMR,DEL
2800     JSR GETCHR
2810     CMP #'Y
2820     BEQ COMVIE_2
2830     JMP GETCOM
2840 COMVIE_3
2850      @PRNTLN  REOF
2860     JMP GETCOM
2870 ;
2880 COMANA
2890     JSR DTCDNS
2900     STA DENSITY
2910      @PRNTLN  COMA
2920      @PRNTLN  SCNM,DEL
2930      @INPRM  SCTR
2940     JSR GETTEXT
2950      @CPYMEM  SCTR,BUF+1
2960     DEX
2970     STX BUF
2980      @INPRM  BUF
2990     JSR DEC2HEX
3000     JSR PRNTNL
3010      @SETSCT  VALUE,VALUE+1
3020      @FILLMEM  BUF,$FF,$00
3030      @FILLMEM  SECT+$08,$04,$20
3040 COMANA_0
3050      @DOSIO  SIO.RD,SIOST.RD,BUF,$07,$00,$00
3060     JSR DOSIO
3070 ;
3080     LDA DAUX1
3090     STA VALUE
3100     LDA DAUX2
3110     STA VALUE+1
3120      @PTR2STK  SCTR
3130      @WRD2STK  VALUE
3140     JSR BIN2DEC
3150     LDA #$00
3160     STA D0
3170      @FILLMEM  SECT+$08,$04,$20
3180      @CPYMEM  SCTR+1,SECT+$08,1,D0,SCTR
3190      @PRNTLN  SECT
3200     LDA #$00
3210     STA FILPOS
3220     STA FILPOS+1
3230     LDA #$80
3240     STA BYTRD
3250     JSR DSPBIN
3260     JSR PRNTNL
3270 ;SHOW MORE/LESS?
3280 COMANA_1
