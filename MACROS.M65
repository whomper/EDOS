;
; MACROS.M65 - EDOS 3.6
; The MAC/65 macros EDOS uses
; Copyright (C) 2026 AERA | Erez Yaary
;
; @CPYMEM - copy a text. With only
; %1 (from) and %2 (to): JSR COPY,
; up to and with the EOL, Y: bytes
; copied. Else a loop of its own:
; %3 1: add $80 to each byte (make
; it inverse); %4: the variable that
; holds the start in %2; %5: the
; variable that holds the count, else
; up to and with the EOL. With %3 1
; give %5 too: the EOL test sees the
; byte after the $80 is added
; Exit: A, Y; the loop: X the bytes
; copied
;
         .MACRO @CPYMEM
         .IF %0=2
         JSR COPY
         .WORD %1,%2
         .ELSE
         .IF %0>3
         LDY %4
         .ENDIF
         LDX #$00
LOOP
         LDA %1,X
         .IF %0>2
         .IF %3=1
         CLC
         ADC #$80
         .ENDIF
         .ENDIF
         .IF %0>3
         STA %2,Y
         INY
         .ELSE
         STA %2,X
         .ENDIF
         INX
         .IF %0>4
         CPX %5
         .ELSE
         CMP #EOL
         .ENDIF
         BNE LOOP
         .ENDIF
         .ENDM
;
; @CHECURPOS - push the cursor's row
; and column; @RSTCURPOS takes them
; back
; Exit: A
;
         .MACRO @CHECURPOS
         LDA ROWCRS
         PHA
         LDA COLCRS
         PHA
         .ENDM
;
; @HIDCUR - hide the cursor
; Exit: A
;
         .MACRO @HIDCUR
         JSR HIDECURSOR
         .ENDM
;
; @SHWCUR - show the cursor
; Exit: A
;
         .MACRO @SHWCUR
         JSR SHOWCURSOR
         .ENDM
;
; @COLGRN - a green background
; Exit: A
;
         .MACRO @COLGRN
         LDA #$C8
         STA COLOR4
         .ENDM
;
; @COLRED - a red background
; Exit: A
;
         .MACRO @COLRED
         JSR SETCOLRED
         .ENDM
;
; @COLDEF - the black background
; Exit: A
;
         .MACRO @COLDEF
         LDA #$00
         STA COLOR4
         .ENDM
;
; @MKCAPS - keys type capitals
; Exit: A
;
         .MACRO @MKCAPS
         LDA #$40
         STA SHFLOK
         .ENDM
;
; @MKASCII - the digit in A to its
; ATASCII character
; Exit: A, C=0 for 0-9
;
         .MACRO @MKASCII
         CLC
         ADC #$30
         .ENDM
;
; @RMASCII - the ATASCII digit in A
; to its value
; Exit: A, C=1 for "0"-"9"
;
         .MACRO @RMASCII
         SEC
         SBC #$30
         .ENDM
;
; @SIOSNDOFF - no sound on SIO
; Exit: A=0
;
         .MACRO @SIOSNDOFF
         LDA #$00
         STA SOUNDR
         .ENDM
;
; @SIOSNDON - SIO sound back on
; Exit: A=1
;
         .MACRO @SIOSNDON
         LDA #$01
         STA SOUNDR
         .ENDM
;
; @HIDCHR - control characters do
; their job on the screen
; Exit: A=0
;
         .MACRO @HIDCHR
         LDA #$00
         STA DSPFLG
         .ENDM
;
; @SHWCHR - control characters are
; shown as characters
; Exit: A=1
;
         .MACRO @SHWCHR
         LDA #$01
         STA DSPFLG
         .ENDM
;
; @RSTCURPOS - the cursor back where
; @CHECURPOS pushed it
; Exit: A
;
         .MACRO @RSTCURPOS
         PLA
         STA COLCRS
         PLA
         STA ROWCRS
         .ENDM
;
; @POINT2TXT - INDPTR to the text %1
; Exit: A
;
         .MACRO @POINT2TXT
         LDA # <%1
         STA INDPTR
         LDA # >%1
         STA INDPTR+1
         .ENDM
;
; @FILLMEM - fill memory: JSR FILL
; with %1 (the address), %2 (the
; length, $00=256) and %3 (the byte)
; after it
; Exit: A, Y=0, CPYSRC; X kept
;
         .MACRO @FILLMEM
         JSR FILL
         .WORD %1
         .BYTE %2,%3
         .ENDM
;
; @INPRM - set up GETTEXT for the
; buffer %1, at most %2 bytes with
; the EOL (else MAXBUF)
; Exit: TXTLEN, A/Y the buffer, X
;
         .MACRO @INPRM
         .IF %0>1
         LDX #%2
         .ELSE
         LDX #MAXBUF
         .ENDIF
         STX TXTLEN
         LDA # <%1
         LDY # >%1
         .ENDM
;
; @DRAW - a line from DRAW: %1 the
; character, %2 the column it starts
; (spaces before), %3 its length
; Exit: A, X, D0; Y=%3
;
         .MACRO @DRAW
         LDA #%1
         LDX #%2
         LDY #%3
         JSR DRAW
         .ENDM
;
; @PRNTLN - print the text %1: up to
; and with its EOL (JSR PRNTLN), or
; with %2 DEL up to the DEL, not
; printed (JSR PRNTDL); .WORD %1
; follows the JSR
; Exit: A; X, Y kept
;
         .MACRO @PRNTLN
         .IF %0>1
         .IF %2-DEL
         JMP PRNTLN_2ND_PARAMETER_MUST_BE_DEL ; undefined: stops assembly
         .ENDIF
         JSR PRNTDL
         .ELSE
         JSR PRNTLN
         .ENDIF
         .WORD %1
         .ENDM
;
; @SETSCT - the sector number %1
; (low), %2 (high) into DAUX1/2. A
; value under 256 is taken as a
; constant (#), so never give a zero
; page variable
; Exit: A
;
         .MACRO @SETSCT
         .IF %1<256
         LDA #%1
         .ELSE
         LDA %1
         .ENDIF
         STA DAUX1
         .IF %2<256
         LDA #%2
         .ELSE
         LDA %2
         .ENDIF
         STA DAUX2
         .ENDM
;
; @DOSIO - an SIO command: JSR DOSIO
; with 8 bytes after it in DCB order
; ($302-$309): %1 the command, %2
; DSTATS, %3 the buffer, %4 the
; timeout, %7 the flags for DUNUSE
; (CNGDSK, SKPERR; else 0), %5/%6
; the size, low and high. All are
; constants
; Exit: A=DSTATS, Y the status; on
; errors see CALLSIO
;
         .MACRO @DOSIO
         JSR DOSIO
         .BYTE %1,%2
         .WORD %3
         .BYTE %4
         .IF %0>6
         .BYTE %7
         .ELSE
         .BYTE 0
         .ENDIF
         .BYTE %5,%6
         .ENDM
;
; @DOCIO - a CIO command: JSR DOCIO
; with 5 or 7 bytes after it: %1 the
; IOCB plus the flags, %2 the ICCOM
; command, %3 the buffer, %4 ICAX1;
; %5 the address of the length (a
; byte); %6 says it is a word and
; must be %5+1 (it is not stored);
; %7 1: %3 holds a pointer to the
; buffer
; Exit: Y the status, X kept; an
; error but EOF goes to DISKERR
;
         .MACRO @DOCIO
         JSR DOCIO
         .IF %0<5
         .BYTE %1
         .ENDIF
         .IF %0=5
         .BYTE %1+1
         .ENDIF
         .IF %0=6
         .BYTE %1+3
         .ENDIF
         .IF %0>6
         .IF %7=1
         .BYTE %1+7
         .ELSE
         .BYTE %1+3
         .ENDIF
         .ENDIF
         .BYTE %2
         .WORD %3
         .BYTE %4
         .IF %0>4
         .WORD %5
         .ENDIF
         .ENDM
;
; @CLOSEIO - close the IOCB %1
; Exit: Y the status
;
         .MACRO @CLOSEIO
         LDX #%1
         JSR CLOSECHANNEL
         .ENDM
