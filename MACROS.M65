;MACROS.M65 - V. 3.2 | COPY TXT FROM 1 BUF TO ANOTHER | %1 - SRC
;Copyright (C) 2026 AERA | Erez Yaary
;%2 - DEST | %3 - BOLD? | %4 - OFFSET MEM | %5 - COUNT MEM | X HOLD COUNT
;ONLY %1,%2: JSR COPY, UP TO AND WITH EOL, Y HOLDS COUNT
         .MACRO @CPYMEM
         .IF %0=2
         JSR COPY
         .WORD %1,%2
         .ELSE
         .IF %0>3
         LDY %4
         .ENDIF
         LDX #$00
LOOP
         LDA %1,X
         .IF %0>2
         .IF %3=1
         CLC
         ADC #$80
         .ENDIF
         .ENDIF
         .IF %0>3
         STA %2,Y
         INY
         .ELSE
         STA %2,X
         .ENDIF
         INX
         .IF %0>4
         CPX %5
         .ELSE
         CMP #EOL
         .ENDIF
         BNE LOOP
         .ENDIF
         .ENDM
;
;PUT CURSOR POS ON STACK
         .MACRO @CHECURPOS
         LDA ROWCRS
         PHA
         LDA COLCRS
         PHA
         .ENDM
;
;HIDES THE CURSOR
         .MACRO @HIDCUR
         JSR HIDECURSOR
         .ENDM
;
;SHOWS THE CURSOR
         .MACRO @SHWCUR
         JSR SHOWCURSOR
         .ENDM
;
;GREEN BACKGROUND
         .MACRO @COLGRN
         LDA #$C8
         STA COLOR4
         .ENDM
;
;RED BACKGROUND
         .MACRO @COLRED
         JSR SETCOLRED
         .ENDM
;
;BLACK BACKGROUND
         .MACRO @COLDEF
         LDA #$00
         STA COLOR4
         .ENDM
;
;FORCE UPPERCASE
         .MACRO @MKCAPS
         LDA #$40
         STA SHFLOK
         .ENDM
;
;CONVERT DIGIT TO ASCII
         .MACRO @MKASCII
         CLC
         ADC #$30
         .ENDM
;
;CONVERT ASCII TO DIGIT
         .MACRO @RMASCII
         SEC
         SBC #$30
         .ENDM
;
;SILENCE SIO
         .MACRO @SIOSNDOFF
         LDA #$00
         STA SOUNDR
         .ENDM
;
;ENABLE SIO SOUND
         .MACRO @SIOSNDON
         LDA #$01
         STA SOUNDR
         .ENDM
;
;HIDE SPECIAL CHARACTERS
         .MACRO @HIDCHR
         LDA #$00
         STA DSPFLG
         .ENDM
;
;SHOW SPECIAL CHARACTERS
         .MACRO @SHWCHR
         LDA #$01
         STA DSPFLG
         .ENDM
;
;RESTORE CURSOR POSITION
         .MACRO @RSTCURPOS
         PLA
         STA COLCRS
         PLA
         STA ROWCRS
         .ENDM
;
;ENABLE PAGE 0 POINTER | %1 - TARGET TXT BUF
         .MACRO @POINT2TXT
         LDA # <%1
         STA INDPTR
         LDA # >%1
         STA INDPTR+1
         .ENDM
;
;FILLS MEM WITH CHAR | %1 - MEM | %2 - LEN ($00=256) | %3 - CHAR
;JSR FILL WITH THEM AFTER IT | X KEPT
         .MACRO @FILLMEM
         JSR FILL
         .WORD %1
         .BYTE %2,%3
         .ENDM
;
;POINT TO A BUF FOR GETTEXT | %1 - BUF | %2 - MAX LEN W/ EOL
         .MACRO @INPRM
         .IF %0>1
         LDX #%2
         .ELSE
         LDX #MAXBUF
         .ENDIF
         STX TXTLEN
         LDA # <%1
         LDY # >%1
         .ENDM
;
;HELPER FOR THE DRAW METHOD | %1-CHAR | %2-POS | %3-LEN
         .MACRO @DRAW
         LDA #%1
         LDX #%2
         LDY #%3
         JSR DRAW
         .ENDM
;
;HELPER FOR PRNTLN | %1 - TXT BUF | %2 - DEL: PRINT UP TO DEL,
;ELSE UP TO AND WITH EOL | .WORD %1 FOLLOWS THE JSR
         .MACRO @PRNTLN
         .IF %0>1
         .IF %2-DEL
         JMP PRNTLN_2ND_PARAMETER_MUST_BE_DEL ;UNDEFINED: STOPS ASSEMBLY
         .ENDIF
         JSR PRNTDL
         .ELSE
         JSR PRNTLN
         .ENDIF
         .WORD %1
         .ENDM
;
;SET SECTOR # TO DAUX1/2 | %1 - LO BYTE | %2 - HI BYTE
;ARGS <256 ARE TAKEN AS LITERALS (#),
;SO NEVER PASS A ZERO PAGE VARIABLE
         .MACRO @SETSCT
         .IF %1<256
         LDA #%1
         .ELSE
         LDA %1
         .ENDIF
         STA DAUX1
         .IF %2<256
         LDA #%2
         .ELSE
         LDA %2
         .ENDIF
         STA DAUX2
         .ENDM
;
;HELPER FOR DOSIO | %1 - COMND | %2 - STAT | %3 - BUF | %4 - TIME
;%5 - SIZE LO | %6 - SIZE HI | %7 - FLAG | ALL ARE CONSTANTS
;EMITS JSR DOSIO + 8 INLINE BYTES IN DCB ORDER ($302-$309)
         .MACRO @DOSIO
         JSR DOSIO
         .BYTE %1,%2
         .WORD %3
         .BYTE %4
         .IF %0>6
         .BYTE %7
         .ELSE
         .BYTE 0
         .ENDIF
         .BYTE %5,%6
         .ENDM
;
;HELPER FOR DOCIO | %1 - IOCB | %2 - ICM.XX | %3 - BUF | %4 - ICAX1
;%5 - LEN LO ADDR | %6 - LEN HI ADDR, MUST BE %5+1 | %7 - 1=BUF IS PNTR
;EMITS JSR DOCIO + 5 OR 7 INLINE BYTES: IOCB+FLAGS,CMD,BUF,ICAX1[,LEN ADR]
         .MACRO @DOCIO
         JSR DOCIO
         .IF %0<5
         .BYTE %1
         .ENDIF
         .IF %0=5
         .BYTE %1+1
         .ENDIF
         .IF %0=6
         .BYTE %1+3
         .ENDIF
         .IF %0>6
         .IF %7=1
         .BYTE %1+7
         .ELSE
         .BYTE %1+3
         .ENDIF
         .ENDIF
         .BYTE %2
         .WORD %3
         .BYTE %4
         .IF %0>4
         .WORD %5
         .ENDIF
         .ENDM
;
;CLOSE A CIO CHANNEL | %1 - DEV ID
         .MACRO @CLOSEIO
         LDX #%1
         JSR CLOSECHANNEL
         .ENDM
