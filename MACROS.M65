10 ;MACROS.M65 - V. 2.9 | COPY TXT FROM 1 BUF TO ANOTHER | %1 - SRC
20 ;%2 - DEST | %3 - BOLD? | %4 - OFFSET MEM | %5 - COUNT MEM | X HOLD COUNT
30       .MACRO @CPYMEM
40         .IF %0>3
50         LDY %4
60         .ENDIF
70       LDX #$00
80 LOOP
90       LDA %1,X
0100       .IF %0>2
0110         .IF %3=1
0120         CLC
0130         ADC #$80
0140         .ENDIF
0150       .ENDIF
0160       .IF %0>3
0170       STA %2,Y
0180       INY
0190       .ELSE
0200       STA %2,X
0210       .ENDIF
0220     INX
0230       .IF %0>4
0240       CPX %5
0250       .ELSE
0260       CMP #EOL
0270       .ENDIF
0280     BNE LOOP
0290     .ENDM
0300 ;
0310 ;PUSHES A WORD ON THESTACK | %1 - WORD TO STACK
0320     .MACRO @WRD2STK
0330     LDA %1+1
0340     PHA
0350     LDA %1
0360     PHA
0370     .ENDM
0380 ;
0390 ;@PTR2STK | STORE WORD ON STACK | %1 - PTR TO STORE
0400     .MACRO @PTR2STK
0410     LDA # >%1
0420     PHA
0430     LDA # <%1
0440     PHA
0450     .ENDM
0460 ;
0470 ;PUT CURSOR POS ON STACK
0480     .MACRO @CHECURPOS
0490     LDA ROWCRS
0500     PHA
0510     LDA COLCRS
0520     PHA
0530     .ENDM
0540 ;
0550 ;HIDES THE CURSOR
0560     .MACRO @HIDCUR
0570     JSR HIDECURSOR
0580     .ENDM
0590 ;
0600 ;SHOWS THE CURSOR
0610     .MACRO @SHWCUR
0620     JSR SHOWCURSOR
0630     .ENDM
0640 ;
0650 ;GREEN BACKGROUND
0660     .MACRO @COLGRN
0670     LDA #$C8
0680     STA COLOR4
0690     .ENDM
0700 ;
0710 ;RED BACKGROUND
0720     .MACRO @COLRED
0730     JSR SETCOLRED
0740     .ENDM
0750 ;
0760 ;BLACK BACKGROUND
0770     .MACRO @COLDEF
0780     LDA #$00
0790     STA COLOR4
0800     .ENDM
0810 ;
0820 ;FORCE UPPERCASE
0830     .MACRO @MKCAPS
0840     LDA #$40
0850     STA SHFLOK
0860     .ENDM
0870 ;
0880 ;CONVERT DIGIT TO ASCII
0890     .MACRO @MKASCII
0900     CLC
0910     ADC #$30
0920     .ENDM
0930 ;
0940 ;CONVERT ASCII TO DIGIT
0950     .MACRO @RMASCII
0960     SEC
0970     SBC #$30
0980     .ENDM
0990 ;
1000 ;READ RETURN ADDRESS
1010     .MACRO @GETRETADR
1020     PLA
1030     STA RETADR
1040     PLA
1050     STA RETADR+1
1060     .ENDM
1070 ;
1080 ;CACHE RETURN ADDRESS
1090     .MACRO @SETRETADR
1100     LDA RETADR+1
1110     PHA
1120     LDA RETADR
1130     PHA
1140     .ENDM
1150 ;
1160 ;SILENCE SIO
1170     .MACRO @SIOSNDOFF
1180     LDA #$00
1190     STA SOUNDR
1200     .ENDM
1210 ;
1220 ;ENABLE SIO SOUND
1230     .MACRO @SIOSNDON
1240     LDA #$01
1250     STA SOUNDR
1260     .ENDM
1270 ;
1280 ;HIDE SPECIAL CHARACTERS
1290     .MACRO @HIDCHR
1300     LDA #$00
1310     STA DSPFLG
1320     .ENDM
1330 ;
1340 ;SHOW SPECIAL CHARACTERS
1350     .MACRO @SHWCHR
1360     LDA #$01
1370     STA DSPFLG
1380     .ENDM
1390 ;
1400 ;RESTORE CURSOR POSITION
1410     .MACRO @RSTCURPOS
1420     PLA
1430     STA COLCRS
1440     PLA
1450     STA ROWCRS
1460     .ENDM
1470 ;
1480 ;ENABLE PAGE 0 POINTER | %1 - TARGET TXT BUF
1490     .MACRO @POINT2TXT
1500     LDA # <%1
1510     STA INDPTR
1520     LDA # >%1
1530     STA INDPTR+1
1540     .ENDM
1550 ;
1560 ;FILLS BUF WITH CHAR | %1 - MEM | %2 - LEN TO ZERO | %3 - CHAR TO FILL
1570     .MACRO @FILLMEM
1580     TXA
1590     PHA
1600     LDA #%3
1610     LDX #$00
1620 LOOP
1630     STA %1,X
1640     INX
1650     CPX #%2
1660     BNE LOOP
1670     PLA
1680     TAX
1690     .ENDM
1700 ;
1710 ;POINT TO A BUF FOR GETTEXT | %1 - BUF | %2 - MAX LEN W/ EOL
1720     .MACRO @INPRM
1721       .IF %0>1
1722       LDX #%2
1723       .ELSE
1724       LDX #MAXBUF
1725       .ENDIF
1726     STX TXTLEN
1730     LDA # <%1
1740     LDY # >%1
1750     .ENDM
1760 ;
1770 ;HELPER FOR THE DRAW METHOD | %1-CHAR | %2-POS | %3-LEN
1780     .MACRO @DRAW
1790     LDA #%1
1800     LDX #%2
1810     LDY #%3
1820     JSR DRAW
1830     .ENDM
1840 ;
1850 ;HELPER FOR PRNTLN | %1 - TXT BUF | %2 - DELIM/LEN (DEF EOL)
1860 ;PARAMS FOLLOW THE JSR INLINE (3 BYTES)
1870     .MACRO @PRNTLN
1880     JSR PRNTLN
1890     .WORD %1
1900     .IF %0>1
1910     .BYTE %2
1920     .ELSE
1930     .BYTE EOL
1940     .ENDIF
1950     .ENDM
1990 ;
2000 ;SET SECTOR # TO DAUX1/2 | %1 - LO BYTE | %2 - HI BYTE
2003 ;ARGS <256 ARE TAKEN AS LITERALS (#),
2006 ;SO NEVER PASS A ZERO PAGE VARIABLE
2010     .MACRO @SETSCT
2020       .IF %1<256
2030       LDA #%1
2040       .ELSE
2050       LDA %1
2060       .ENDIF
2070     STA DAUX1
2080       .IF %2<256
2090       LDA #%2
2100       .ELSE
2110       LDA %2
2120       .ENDIF
2130     STA DAUX2
2140     .ENDM
2150 ;
2160 ;HELPER FOR DOSIO | %1 - COMND | %2 - STAT | %3 - BUF | %4 - TIME
2170 ;%5 - SIZE LO | %6 - SIZE HI | %7 - FLAG | ALL ARE CONSTANTS
2180 ;EMITS JSR DOSIO + 8 INLINE BYTES IN DCB ORDER ($302-$309)
2190     .MACRO @DOSIO
2200     JSR DOSIO
2210     .BYTE %1,%2
2220     .WORD %3
2230     .BYTE %4
2240     .IF %0>6
2250     .BYTE %7
2260     .ELSE
2270     .BYTE 0
2280     .ENDIF
2290     .BYTE %5,%6
2300     .ENDM
2520 ;
2530 ;HELPER FOR DOCIO | %1 - IOCB | %2 - ICM.XX | %3 - BUF | %4 - ICAX1
2540 ;%5 - LEN LO ADDR | %6 - LEN HI ADDR, MUST BE %5+1 | %7 - 1=BUF IS PNTR
2550 ;EMITS JSR DOCIO + 5 OR 7 INLINE BYTES: IOCB+FLAGS,CMD,BUF,ICAX1[,LEN ADR]
2560     .MACRO @DOCIO
2570     JSR DOCIO
2580     .IF %0<5
2590     .BYTE %1
2600     .ENDIF
2610     .IF %0=5
2620     .BYTE %1+1
2630     .ENDIF
2640     .IF %0=6
2650     .BYTE %1+3
2660     .ENDIF
2670     .IF %0>6
2680     .IF %7=1
2690     .BYTE %1+7
2700     .ELSE
2710     .BYTE %1+3
2720     .ENDIF
2730     .ENDIF
2740     .BYTE %2
2750     .WORD %3
2760     .BYTE %4
2770     .IF %0>4
2780     .WORD %5
2790     .ENDIF
2800     .ENDM
2960 ;
2970 ;CLOSE A CIO CHANNEL | %1 - DEV ID
2980     .MACRO @CLOSEIO
2990     LDX #%1
3000     JSR CLOSECHANNEL
3010     .ENDM
