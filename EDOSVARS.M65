REFDRV   .BYTE 1            ;REFRESH DRVS?
SNGL     .BYTE $28,1,0,$12,0,0,0,$80,$FF
ENHA     .BYTE $28,1,0,$1A,0,0,0,$80,$FF
DBLE     .BYTE $28,1,0,$12,0,4,0,$FF,$FF
VTOC     .BYTE 2,$F2,3,$F2,3,0,0,0,0,0,$0F,EOL
PERCOFS  .BYTE 0,ENHA-SNGL,DBLE-SNGL ;SETDRVSTAT (NOT BEFORE VTOC:
; DBLE IS SENT WITH THE 2 BYTES AFTER IT)
DISK     .BYTE "D1:*.*",EOL ;DEF DISK
EDOS     .BYTE "EDOS.COM",EOL
ARGS     .BYTE "*.*",EOL    ;DEF ARGS
KYBD     .BYTE "K:"         ;KEYBOARD
EOLB     .BYTE EOL          ;ENDS KYBD; PRNTNL PRINTS IT
DELL     .BYTE DLN,CUP,CUP,DEL
DLLN     .BYTE DLN,DEL
TTL1     .BYTE CLS,DEL
TTL2     .BYTE "",EOL
STAT     .BYTE " D:                 XMEM:      ",EOL
MNU1     .BYTE ""        ;"1-8": NO TITLE BAR
MNUL     .BYTE " Dir D1-D8      ","rite EDOS",EOL
         .BYTE "iles on Disk      ","rotect Files",EOL
         .BYTE "o Cartridge       ","nprotect Files",EOL
         .BYTE "opy Files         ","ename Files",EOL
         .BYTE "uplicate Disk     ","ave Binary",EOL,DEL
MNU2     .BYTE "rase Files        ","oad Binary",EOL
         .BYTE "nitialize Disk    ","o To Address",EOL
         .BYTE "iew File          ","ew Drive",EOL
         .BYTE "nalyze Sector     ","yte Compare",EOL
         .BYTE "emory Status      ","uit to DOS",EOL,DEL
FSPC     .BYTE "File Spec: ",DEL
NUMF     .BYTE "Number of files: ",EOL
RENO     .BYTE "Old File: ",DEL
RENN     .BYTE "New File: ",DEL
BCMF     .BYTE "File 1: ",DEL
BCMS     .BYTE "File 2: ",DEL
DRVN     .BYTE "Drive #: ",DEL
FMTD     .BYTE "1-Single, 2-Enhance, 3-Double: ",DEL
FRMT     .BYTE "Formatting D , ",DEL
GOTA     .BYTE "Address: ",DEL
FLST     .BYTE "Start: ",DEL
FLED     .BYTE " End: ",DEL
FLRN     .BYTE " Run: ",DEL
SCNM     .BYTE "Sector: ",DEL
ARYS     .BYTE "Are You Sure? ",DEL
INSS     .BYTE "Read source [Y]? ",DEL
INST     .BYTE "Target drive # [1-8,Y-same]: ",DEL
WFTR     .BYTE "Insert Target [Y] ",DEL
ANYK     .BYTE DLN,"Select Item ( for menu): ",DEL
NOTB     .BYTE "Not a binary file!",EOL
LDOV     .BYTE "Program loads over $0600-$06FF",EOL
REOF     .BYTE "Reached end of file",EOL
VIMR     .BYTE "View more [Y/N]? ",DEL
VINP     .BYTE "View next/previous [+/-/N]? ",DEL
BDIF     .BYTE "Files are different",EOL
BSAM     .BYTE "Files are the same",EOL
RUNP     .BYTE "Run Program [Y/N]? ",DEL
UPDT     .BYTE " Updating... ",DEL
NOMM     .BYTE "Not enough memory!",EOL
BADR     .BYTE "Invalid address!",EOL
DSNG     .BYTE "Single ",DEL
DENH     .BYTE "Enhance",DEL
DDBL     .BYTE "Double ",DEL
DUPBNK   .BYTE 6,9,12       ;BANKS TO DUPLICATE
         .IF DENH-DSNG-8
         JMP DENSITY_NAMES_MUST_BE_8_APART ;UNDEFINED
         .ENDIF
         .IF DDBL-DENH-8
         JMP DENSITY_NAMES_MUST_BE_8_APART
         .ENDIF
SECT     .BYTE "Sector:     ",EOL ;4 DIGITS AT SECT+8
DUPE     .BYTE "    ",DEL
DUPS     .BYTE ":       :        :     :     ",DEL
MODR     .BYTE "Read ",DEL
MODW     .BYTE "Write ",DEL
MODF     .BYTE "Format",DEL
DRSP     .BYTE "HIGH",DEL
DRGN     .BYTE "NORM",DEL
MEMS     .BYTE ":      :    ",EOL ;HEX AT +4, +$0F
; TITLE BARS ARE THE MENU LABELS, SEE TITLE IN EDOS.M65
;
; EDOS.COM ENDS HERE. THE VARIABLES BELOW ARE RESERVED
; AFTER IT AND NOT IN THE FILE. MORE IN ZERO PAGE.
END_PROG
FILLEN   *= *+2             ;FILE LEN
DRIVES   *= *+1             ;CONNECTED DRVS
BITWISE  *= *+1             ;FOCUS DRIVE
DRVHS    *= *+1             ;SPEEDY DRIVE?
SAVLEN   *= *+2             ;SAVE STRT/END LEN
NUM2CNV  *= *+1             ;COPY SOURCE DRV
STKPTR   *= *+1             ;SP AT START (<$4000)
ABORT    *= *+1             ;ABRT ACTV COM
MEMD     *= *+7             ;MEM
DOSIN    *= *+2             ;DOSINI CACHE
VAREND
