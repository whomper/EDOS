1000 ;
1010 ; EDOS.COM ENDS HERE. THE VARIABLES BELOW ARE RESERVED
1020 ; AFTER IT AND NOT IN THE FILE. MORE IN ZERO PAGE.
1030 END_PROG
1040 FILLEN *= *+2   ;FILE LEN
1050 DRIVES *= *+1   ;CONNECTED DRVS
1060 BITWISE *= *+1  ;FOCUS DRIVE
1070 DRVHS *= *+1    ;SPEEDY DRIVE?
1080 SAVLEN *= *+2   ;SAVE STRT/END LEN
1090 NUM2CNV *= *+1  ;COPY SOURCE DRV
1100 STKPTR *= *+1   ;SP AT START (<$4000)
1110 ABORT *= *+1    ;ABRT ACTV COM
1120 MEMD *= *+7     ;MEM
1130 DOSIN *= *+2    ;DOSINI CACHE
1140 VAREND
